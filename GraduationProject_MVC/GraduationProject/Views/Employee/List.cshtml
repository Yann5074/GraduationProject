@using GraduationProject.DTOs
@model PagedList<GraduationProject.DTOs.CEmployeeListItemDTO>
@using GraduationProject.Dictionary
@using System.Text.Json

@{
    var json = Context.Session.GetString(CEmployeeDictionary.SK_LOGINED_USER);
    var me = json is null ? null : JsonSerializer.Deserialize<SessionUser>(json);
    var isAdmin = me?.RoleId == 4 && me?.StatusId == 1; 
}

<div class="container-xxl py-4">
    <!-- Header / Toolbar -->
    <div class="d-flex align-items-center mb-3">
        <h1 class="h3 mb-0">員工資料一覽表</h1>
        <!-- 右側按鈕群組 -->
        <div class="ms-auto d-flex gap-2">
            @if (isAdmin)
            {
                <a asp-action="Create" class="btn btn-success">
                    <i class="bi bi-person-plus"></i> 新增員工
                </a>
            }
            <a asp-action="DeletedList" class="btn btn-secondary">
                <i class="bi bi-person-dash"></i> 註銷員工
            </a>
        </div>
    </div>

    <!-- Search -->
    @using (Html.BeginForm("List", "Employee", FormMethod.Post))
    {
        <div class="input-group mb-3">
            <input type="text" name="Keyword" class="form-control" value="@(ViewBag.Keyword as string)" placeholder="輸入關鍵字" />
            <input type="hidden" name="Page" value="1" />
            <input type="hidden" name="Size" value="@ViewBag.Size" />
            <button class="btn btn-outline-secondary" type="submit">查詢</button>
        </div>
    }

    <!-- Table Card -->
    <div class="card shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle mb-0">
                    <!-- 固定欄寬 -->
                    <colgroup>
                        <col style="width: 56px;">   <!-- 序列 -->
                        <col style="width: 100px;">  <!-- 大頭照 -->
                        <col style="width: 120px;">  <!-- 姓名 -->
                        <col style="width: 120px;">  <!-- 聯絡電話 -->
                        <col style="width: 180px;">  <!-- Email -->
                        <col style="width: 100px;">  <!-- 權限 -->
                        <col style="width: 100px;">  <!-- 狀態 -->
                        <col style="width: 180px;">  <!-- 操作 -->
                    </colgroup>

                    <thead class="table-dark text-center text-nowrap">
                        <tr>
                            <th>序列</th>
                            <th>大頭照</th>
                            <th>姓名</th>
                            <th>聯絡電話</th>
                            <th>Email</th>
                            <th>權限</th>
                            <th>狀態</th>
                            <th>操作</th>
                        </tr>
                    </thead>

                    <tbody>
                        @{
                            int count = (Model.Page - 1) * Model.PageSize;
                            foreach (var item in Model.Items)
                            {
                                count++;
                                <tr>
                                    <!-- 序列 -->
                                    <td class="text-center text-muted">@count</td>

                                    <!-- 大頭照 -->
                                    <td class="text-center">
                                        <img src="~/HeadShotImages/@item.HeadShot"
                                             alt="頭貼"
                                             class="rounded-circle"
                                             style="width:80px; height:80px; object-fit:cover;" />
                                    </td>

                                    <!-- 姓名 / 聯絡電話 / Email -->
                                    <td class="text-center fw-semibold">@item.Name</td>
                                    <td class="text-center">@item.Phone</td>
                                    <td class="text-center text-truncate" style="max-width: 180px;">@item.Email</td>

                                    <!-- 權限 -->
                                    <td class="text-center">@item.RoleClass</td>

                                    <!-- 狀態 -->
                                    <td class="text-center">@item.Status</td>

                                    <!-- 操作按鈕 -->
                                    <td class="text-center text-nowrap">
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info me-1">
                                            <i class="bi bi-eye"></i> 詳細
                                        </a>
                                        @if (isAdmin)
                                        {
                                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary me-1">
                                                <i class="bi bi-pencil"></i> 修改
                                            </a>
                                            <form asp-controller="Employee" asp-action="Delete" asp-route-id="@item.Id"
                                                  method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-outline-danger"
                                                        onclick="return confirm('確定要註銷此帳號嗎？')">
                                                    <i class="bi bi-trash"></i> 註銷
                                                </button>
                                            </form>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
                <!-- 分頁按鈕 -->
                <nav class="d-flex justify-content-between align-items-center">
                    <div>共 @Model.TotalCount 筆，第 @Model.Page / @Model.TotalPages 頁</div>
                    <ul class="pagination mb-0">
                        <li class="page-item @(Model.HasPrev ? "" : "disabled")">
                            <a class="page-link"
                               asp-action="List"
                               asp-route-Keyword="@(ViewBag.Keyword)"
                               asp-route-Page="@(Model.Page - 1)"
                               asp-route-Size="@(Model.PageSize)">上一頁</a>
                        </li>

                        <li class="page-item @(Model.HasNext ? "" : "disabled")">
                            <a class="page-link"
                               asp-action="List"
                               asp-route-Keyword="@(ViewBag.Keyword)"
                               asp-route-Page="@(Model.Page + 1)"
                               asp-route-Size="@(Model.PageSize)">下一頁</a>
                        </li>
                    </ul>
                </nav>
            </div>
        </div>
    </div>
</div>
