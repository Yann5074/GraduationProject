@using GraduationProject.DTOs
@model IEnumerable<CEmployeeListItemDTO>

<form method="get" class="mb-3">
    <input name="Keyword" value="@Context.Request.Query["Keyword"]" class="form-control d-inline-block w-auto" />
    <button class="btn btn-primary">Search</button>
</form>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Id</th>
            <th>Name</th>
            <th>Phone</th>
            <th>Email</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var e in Model)
        {
            <tr>
                <td>@e.Id</td>
                <td>@e.Name</td>
                <td>@e.Phone</td>
                <td>@e.Email</td>
            </tr>
        }
    </tbody>
</table>