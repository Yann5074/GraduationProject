@using GraduationProject.DTOs
@model IEnumerable<CEmployeeListItemDTO>

<div class="container-xxl py-4">
    <!-- Header / Toolbar -->
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
        <h1 class="h3 mb-0">員工資料一覽表</h1>
        <a asp-action="Create" class="btn btn-success">
            <i class="bi bi-person-plus"></i> 新增員工
        </a>
    </div>

    <!-- Search -->
    @using (Html.BeginForm(null, null, FormMethod.Post, new { @class = "mb-3" }))
    {
        <div class="input-group">
            @Html.TextBox("Keyword", ViewBag.Keyword as string, new { @class = "form-control", placeholder = "輸入關鍵字" })
            <button type="submit" class="btn btn-outline-secondary">查詢</button>
        </div>
    }

    <!-- Table Card -->
    <div class="card shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle mb-0">
                    <!-- 固定欄寬 -->
                    <colgroup>
                        <col style="width: 56px;">   <!-- 序列 -->
                        <col style="width: 100px;">  <!-- 大頭照 -->
                        <col style="width: 120px;">  <!-- 姓名 -->
                        <col style="width: 120px;">  <!-- 聯絡電話 -->
                        <col style="width: 180px;">  <!-- Email -->
                        <col style="width: 100px;">  <!-- 權限 -->
                        <col style="width: 100px;">  <!-- 狀態 -->
                        <col style="width: 180px;">  <!-- 操作 -->
                    </colgroup>

                    <thead class="table-dark text-center text-nowrap">
                        <tr>
                            <th>序列</th>
                            <th>大頭照</th>
                            <th>姓名</th>
                            <th>聯絡電話</th>
                            <th>Email</th>
                            <th>權限</th>
                            <th>狀態</th>
                            <th>操作</th>
                        </tr>
                    </thead>

                    <tbody>
                        @{
                            int count = 0;
                            foreach (var item in Model)
                            {
                                count++;
                                <tr>
                                    <!-- 序列 -->
                                    <td class="text-center text-muted">@count</td>

                                    <!-- 大頭照 -->
                                    <td class="text-center">
                                        <img src="~/HeadShotImages/@item.HeadShot"
                                             alt="頭貼"
                                             class="rounded-circle"
                                             style="width:80px; height:80px; object-fit:cover;" />
                                    </td>

                                    <!-- 姓名 / 聯絡電話 / Email -->
                                    <td class="text-center fw-semibold">@item.Name</td>
                                    <td class="text-center">@item.Phone</td>
                                    <td class="text-center text-truncate" style="max-width: 180px;">@item.Email</td>

                                    <!-- 權限 -->
                                    <td class="text-center">@item.RoleClass</td>

                                    <!-- 狀態 -->
                                    <td class="text-center">@item.Status</td>

                                    <!-- 操作按鈕 -->
                                    <td class="text-center text-nowrap">
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info me-1">
                                            <i class="bi bi-eye"></i> 詳細
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary me-1">
                                            <i class="bi bi-pencil"></i> 修改
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger"
                                           onclick="return confirm('確定要註銷此帳號嗎？')">
                                            <i class="bi bi-trash"></i> 註銷
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>