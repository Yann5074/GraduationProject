@model GraduationProject.ViewModels.CEmployeeCreateViewModel

@{
    ViewData["Title"] = "Create";
}

<h1 class="mb-4">新增員工</h1>
<h4 class="mb-3">請填寫員工資訊</h4>
<hr />

<div class="row">
    <div class="col-md-6">
        <form asp-action="Create">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <!-- 姓名 -->
            <div class="mb-3">
                <label asp-for="FName" class="form-label">姓名</label>
                <input asp-for="FName" class="form-control" placeholder="請輸入員工姓名" />
                <span asp-validation-for="FName" class="text-danger"></span>
            </div>

            <!-- 電話 -->
            <div class="mb-3">
                <label asp-for="FPhone" class="form-label">聯絡電話</label>
                <input asp-for="FPhone" class="form-control" placeholder="請輸入員工電話" />
                <span asp-validation-for="FPhone" class="text-danger"></span>
            </div>

            <!-- Email -->
            <div class="mb-3">
                <label asp-for="FEmail" class="form-label">Email</label>
                <input asp-for="FEmail" class="form-control" placeholder="請輸入員工Email" />
                <span asp-validation-for="FEmail" class="text-danger"></span>
            </div>

            <!-- 性別 -->
            <div class="mb-3">
                <label class="form-label">性別</label>
                <div class="form-check form-check-inline">
                    <label>
                        <input type="radio" asp-for="FGender" value="1" />
                        男性
                    </label>
                    <label>
                        <input type="radio" asp-for="FGender" value="2" />
                        女性
                    </label>
                    <label>
                        <input type="radio" asp-for="FGender" value="3" />
                        中性
                    </label>
                    <label>
                        <input type="radio" asp-for="FGender" value="4" />
                        不願告知
                    </label>
                </div>
                <span asp-validation-for="FGender" class="text-danger"></span>
            </div>

            <!-- 血型 -->
            <div class="mb-3">
                <label asp-for="FBloodType" class="form-label">血型</label>
                <select asp-for="FBloodType" class="form-select">
                    <option value="">請選擇</option>
                    <option value="A">A</option>
                    <option value="B">B</option>
                    <option value="O">O</option>
                    <option value="AB">AB</option>
                </select>
                <span asp-validation-for="FBloodType" class="text-danger"></span>
            </div>

            <!-- 入職日期 -->
            <div class="mb-3">
                <label asp-for="FHireDate" class="form-label">入職日期</label>
                <input asp-for="FHireDate" class="form-control" type="date" />
                <span asp-validation-for="FHireDate" class="text-danger"></span>
            </div>

            <!-- 權限 -->
            <div class="mb-3">
                <label class="form-label">權限</label>
                <div class="form-check form-check-inline">
                    <label>
                        <input type="radio" asp-for="FRoleId" value="1" />
                        實習生
                    </label>
                    <label>
                        <input type="radio" asp-for="FRoleId" value="2" />
                        職員
                    </label>
                    <label>
                        <input type="radio" asp-for="FRoleId" value="3" />
                        組長
                    </label>
                    <label>
                        <input type="radio" asp-for="FRoleId" value="4" />
                        管理者
                    </label>
                </div>
                <span asp-validation-for="FRoleId" class="text-danger"></span>
            </div>

            <!-- 狀態 -->
            <div class="mb-3">
                <label class="form-label">狀態</label>
                <div class="form-check form-check-inline">
                    <label>
                        <input type="radio" asp-for="FStatusId" value="1" />
                        在職
                    </label>
                    <label>
                        <input type="radio" asp-for="FStatusId" value="2" />
                        離職
                    </label>
                    <label>
                        <input type="radio" asp-for="FStatusId" value="3" />
                        退休
                    </label>
                    <label>
                        <input type="radio" asp-for="FStatusId" value="4" />
                        帳號註銷
                    </label>
                </div>
                <span asp-validation-for="FStatusId" class="text-danger"></span>
            </div>

            <!-- 帳號 -->
            <div class="mb-3">
                <label asp-for="FAccount" class="form-label">員工帳號</label>
                <input asp-for="FAccount" class="form-control" placeholder="請輸入帳號" />
                <span asp-validation-for="FAccount" class="text-danger"></span>
            </div>

            <!-- 密碼 -->
            <div class="mb-3">
                <label asp-for="FPasswords" class="form-label">員工密碼</label>
                <input asp-for="FPasswords" type="password" class="form-control" placeholder="請設定密碼" />
                <span asp-validation-for="FPasswords" class="text-danger"></span>
            </div>

            <!-- 提交按鈕 -->
            <div class="mb-3">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-person-plus"></i> 新增員工
                </button>
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="List" class="btn btn-secondary">取消</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
