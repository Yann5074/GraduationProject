@model GraduationProject.ViewModels.CProductEditViewModel
@using System.IO
@{
    ViewData["Title"] = "新增商品";

    // 確保 Data/Variants/Assets 不為 null
    Model.Data ??= new GraduationProject.DTOs.CProductUpdateDTO();
    Model.Data.Variants ??= new List<GraduationProject.DTOs.CProductVariantDTO> { new GraduationProject.DTOs.CProductVariantDTO() };
    Model.Data.Assets ??= new List<GraduationProject.DTOs.CProductAssetDTO>();

    var d = Model.Data;

    // 把資產加上原始索引方便輸出正確的 name
    var assetsWithIndex = (d.Assets ?? new List<GraduationProject.DTOs.CProductAssetDTO>())
                          .Select((a, idx) => new { A = a, Index = idx }).ToList();

    // 依暫存變體索引分組（Create 階段）
    Func<int, IEnumerable<dynamic>> assetsOfVariantTemp = (tempIdx) =>
        assetsWithIndex.Where(x => (x.A.VariantTempIndex ?? -1) == tempIdx);

    // 商品通用資產（未綁任何變體）- 排除3D資產
    var productAssets = assetsWithIndex.Where(x =>
        (x.A.VariantTempIndex ?? -1) < 0 &&
        x.A.AssetType != "glb" &&
        x.A.AssetType != "gltf" &&
        !((x.A.AssetType ?? "").StartsWith("pbr-"))
    );

    // 3D資產（glb/gltf或pbr-*類型）
    var modelAssets = assetsWithIndex.Where(x =>
        x.A.AssetType == "glb" ||
        x.A.AssetType == "gltf" ||
        ((x.A.AssetType ?? "").StartsWith("pbr-"))
    );
}

<div class="container py-4">
    <div class="d-flex align-items-center justify-content-between mb-3">
        <h2 class="mb-0">新增商品</h2>
        <a asp-action="List" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> 返回列表
        </a>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }
    @if (TempData["Ok"] != null)
    {
        <div class="alert alert-success">@TempData["Ok"]</div>
    }

    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()

        <div class="row g-3">
            <!-- 左側主內容 -->
            <div class="col-lg-8">

                <!-- 基本資料 -->
                <div class="card shadow-sm">
                    <div class="card-header">基本資料</div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label class="form-label">商品名稱</label>
                            <input class="form-control" asp-for="Data.Name" required />
                            <span class="text-danger" asp-validation-for="Data.Name"></span>
                        </div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label">分類</label>
                                <select class="form-select" asp-for="Data.CategoryId" asp-items="Model.CategoryOptions"></select>
                                <span class="text-danger" asp-validation-for="Data.CategoryId"></span>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">狀態</label>
                                <select class="form-select" asp-for="Data.PStatus" asp-items="Model.PStatusOptions"></select>
                                <span class="text-danger" asp-validation-for="Data.PStatus"></span>
                            </div>
                        </div>

                        <div class="mb-3 mt-3">
                            <label class="form-label">描述</label>
                            <textarea class="form-control" asp-for="Data.Description" rows="3"></textarea>
                        </div>

                        <div class="row g-3">
                            <div class="col-md-3">
                                <label class="form-label">保固(月)</label>
                                <input class="form-control" asp-for="Data.WarrantyMonth" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">需組裝</label>
                                <select class="form-select" asp-for="Data.AssemblyRequired">
                                    <option value="">不指定</option>
                                    <option value="true">是</option>
                                    <option value="false">否</option>
                                </select>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">折扣</label>
                                <input class="form-control" asp-for="Data.Discount" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">組裝零件</label>
                                <input class="form-control" asp-for="Data.AssemblyPart" />
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 變體 + 對應資產 -->
                <div class="card shadow-sm mt-3">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <span>變體（顏色 / 尺寸 / 庫存 / 售價）— 含各變體資產</span>
                        <button type="button" class="btn btn-sm btn-outline-primary" id="btnAddVariant">＋新增變體</button>
                    </div>
                    <div class="card-body">
                        <div id="variant-list">
                            @{
                                var variants = d.Variants ?? new List<GraduationProject.DTOs.CProductVariantDTO>();
                            }
                            @for (int i = 0; i < variants.Count; i++)
                            {
                                var v = variants[i];
                                <div class="border rounded p-2 mb-3 variant-item" data-variant-temp-index="@i">
                                    <input type="hidden" name="Data.Variants[@i].VariantId" value="@v.VariantId" />

                                    <div class="row g-2">
                                        <div class="col-md-2">
                                            <label class="form-label">SKU</label>
                                            <input class="form-control" name="Data.Variants[@i].SKU" value="@v.SKU" required />
                                        </div>

                                        <div class="col-md-2">
                                            <label class="form-label">顏色</label>
                                            <select class="form-select" name="Data.Variants[@i].ColorId">
                                                <option value="">無</option>
                                                @foreach (var c in Model.ColorOptions)
                                                {
                                                    if (v.ColorId?.ToString() == c.Value)
                                                    {
                                                        <option value="@c.Value" selected>@c.Text</option>
                                                    }
                                                    else
                                                    {
                                                        <option value="@c.Value">@c.Text</option>
                                                    }
                                                }
                                            </select>
                                        </div>

                                        <div class="col-md-2">
                                            <label class="form-label">售價</label>
                                            <input class="form-control" name="Data.Variants[@i].Price" value="@(v.Price?.ToString() ?? "")" />
                                        </div>

                                        <div class="col-md-2">
                                            <label class="form-label">成本</label>
                                            <input class="form-control" name="Data.Variants[@i].Cost" value="@(v.Cost?.ToString() ?? "")" />
                                        </div>

                                        <div class="col-md-2">
                                            <label class="form-label">庫存</label>
                                            <input class="form-control" name="Data.Variants[@i].Stock" value="@(v.Stock?.ToString() ?? "")" />
                                        </div>

                                        <div class="col-md-2">
                                            <label class="form-label">狀態</label>
                                            <select class="form-select" name="Data.Variants[@i].PStatus">
                                                <option value="">請選擇</option>
                                                @foreach (var s in Model.PStatusOptions)
                                                {
                                                    if (v.PStatus?.ToString() == s.Value)
                                                    {
                                                        <option value="@s.Value" selected>@s.Text</option>
                                                    }
                                                    else
                                                    {
                                                        <option value="@s.Value">@s.Text</option>
                                                    }
                                                }
                                            </select>
                                        </div>
                                    </div>

                                    <div class="row g-2 mt-2">
                                        <div class="col-md-3">
                                            <label class="form-label">尺寸標籤</label>
                                            <input class="form-control" name="Data.Variants[@i].SizeLabel" value="@v.SizeLabel" />
                                        </div>
                                        <div class="col-md-2">
                                            <label class="form-label">長(cm)</label>
                                            <input class="form-control" name="Data.Variants[@i].Length" value="@(v.Length?.ToString() ?? "")" />
                                        </div>
                                        <div class="col-md-2">
                                            <label class="form-label">寬(cm)</label>
                                            <input class="form-control" name="Data.Variants[@i].Width" value="@(v.Width?.ToString() ?? "")" />
                                        </div>
                                        <div class="col-md-2">
                                            <label class="form-label">高(cm)</label>
                                            <input class="form-control" name="Data.Variants[@i].Height" value="@(v.Height?.ToString() ?? "")" />
                                        </div>
                                        <div class="col-md-2">
                                            <label class="form-label">重量(kg)</label>
                                            <input class="form-control" name="Data.Variants[@i].Weight" value="@(v.Weight?.ToString() ?? "")" />
                                        </div>
                                    </div>

                                    <!-- 變體資產 -->
                                    <div class="mt-2">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <small class="text-muted">此變體的圖片</small>
                                            <button type="button" class="btn btn-sm btn-outline-secondary btn-add-asset-for-variant" data-variant-temp-index="@i">＋圖片</button>
                                        </div>
                                        <div class="variant-asset-list mt-1">
                                            @foreach (var ax in assetsOfVariantTemp(i))
                                            {
                                                var a = ax.A;
                                                var aidx = ax.Index;
                                                <div class="asset-item border rounded p-2 mb-2" data-asset-index="@aidx">
                                                    <input type="hidden" name="Data.Assets[@aidx].AssetId" value="@a.AssetId" />
                                                    <input type="hidden" name="Data.Assets[@aidx].VariantTempIndex" value="@i" />
                                                    <input type="hidden" class="asset-url" name="Data.Assets[@aidx].Url" value="@a.Url" />
                                                    <input type="hidden" class="asset-mime" name="Data.Assets[@aidx].MimeType" value="@a.MimeType" />
                                                    <input type="hidden" class="asset-type" name="Data.Assets[@aidx].AssetType" value="@a.AssetType" />

                                                    <div class="row g-2 align-items-end">
                                                        <div class="col-md-3">
                                                            <label class="form-label small">上傳圖片</label>
                                                            <input type="file" class="form-control form-control-sm asset-file" accept="image/*" />
                                                        </div>
                                                        <div class="col-md-3">
                                                            <label class="form-label small">主圖</label>
                                                            <select class="form-select form-select-sm" name="Data.Assets[@aidx].IsPrimary">
                                                                <option value="">否</option>
                                                                @{
                                                                    var isVariantAssetPrimary = (a.IsPrimary == true);
                                                                }
                                                                <option value="true" selected="@isVariantAssetPrimary">是</option>
                                                            </select>
                                                        </div>
                                                        <div class="col-md-2">
                                                            <label class="form-label small">排序</label>
                                                            <input class="form-control form-control-sm" name="Data.Assets[@aidx].SortOrder" value="@a.SortOrder" />
                                                        </div>
                                                        <div class="col-md-2">
                                                            <button type="button" class="btn btn-sm btn-outline-danger btn-delete-asset w-100">刪除</button>
                                                        </div>
                                                    </div>
                                                    <div class="asset-preview mt-2 @(string.IsNullOrEmpty(a.Url) ? "d-none" : "")">
                                                        <img src="@a.Url" class="img-thumbnail" style="max-width:120px; max-height:120px;" />
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    </div>

                                    <div class="mt-2 text-end">
                                        <button type="button" class="btn btn-sm btn-outline-danger btn-delete-variant">刪除此變體</button>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <!-- 商品通用資產（圖片） -->
                <div class="card shadow-sm mt-3">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <span>商品通用圖片</span>
                        <button type="button" class="btn btn-sm btn-outline-primary" id="btnAddProductAsset">＋新增圖片</button>
                    </div>
                    <div class="card-body">
                        <div id="product-asset-list">
                            @foreach (var ax in productAssets)
                            {
                                var a = ax.A;
                                var aidx = ax.Index;
                                <div class="asset-item border rounded p-2 mb-2" data-asset-index="@aidx">
                                    <input type="hidden" name="Data.Assets[@aidx].AssetId" value="@a.AssetId" />
                                    <input type="hidden" class="asset-url" name="Data.Assets[@aidx].Url" value="@a.Url" />
                                    <input type="hidden" class="asset-mime" name="Data.Assets[@aidx].MimeType" value="@a.MimeType" />
                                    <input type="hidden" class="asset-type" name="Data.Assets[@aidx].AssetType" value="@a.AssetType" />

                                    <div class="row g-2 align-items-end">
                                        <div class="col-md-4">
                                            <label class="form-label small">上傳圖片</label>
                                            <input type="file" class="form-control form-control-sm asset-file" accept="image/*" />
                                        </div>
                                        <div class="col-md-3">
                                            <label class="form-label small">主圖</label>
                                            <select class="form-select form-select-sm" name="Data.Assets[@aidx].IsPrimary">
                                                <option value="">否</option>
                                                @{
                                                    var isPrimarySelected = (a.IsPrimary == true);
                                                }
                                                <option value="true" selected="@isPrimarySelected">是</option>
                                            </select>
                                        </div>
                                        <div class="col-md-2">
                                            <label class="form-label small">排序</label>
                                            <input class="form-control form-control-sm" name="Data.Assets[@aidx].SortOrder" value="@a.SortOrder" />
                                        </div>
                                        <div class="col-md-2">
                                            <button type="button" class="btn btn-sm btn-outline-danger btn-delete-asset w-100">刪除</button>
                                        </div>
                                    </div>
                                    <div class="asset-preview mt-2 @(string.IsNullOrEmpty(a.Url) ? "d-none" : "")">
                                        <img src="@a.Url" class="img-thumbnail" style="max-width:120px; max-height:120px;" />
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <!-- ===== 新增：3D模型資產區域 ===== -->
                <div class="card shadow-sm mt-3 border-primary">
                    <div class="card-header bg-primary bg-opacity-10 d-flex justify-content-between align-items-center">
                        <span><i class="bi bi-box-seam me-2"></i>3D模型資產</span>
                        <button type="button" class="btn btn-sm btn-primary" id="btnAdd3DAsset">＋新增3D模型</button>
                    </div>
                    <div class="card-body">
                        <div class="alert alert-info small mb-3">
                            <i class="bi bi-info-circle me-1"></i>
                            支援 GLB/GLTF 格式的3D模型檔案，以及 PBR 材質貼圖（basecolor、normal、metallic、roughness等）
                        </div>
                        <div id="model-asset-list">
                            @foreach (var ax in modelAssets)
                            {
                                var a = ax.A;
                                var aidx = ax.Index;
                                <div class="asset-item model-asset-item border rounded p-3 mb-3" data-asset-index="@aidx">
                                    <input type="hidden" name="Data.Assets[@aidx].AssetId" value="@a.AssetId" />
                                    <input type="hidden" class="asset-url" name="Data.Assets[@aidx].Url" value="@a.Url" />
                                    <input type="hidden" class="asset-mime" name="Data.Assets[@aidx].MimeType" value="@a.MimeType" />
                                    <input type="hidden" class="asset-type" name="Data.Assets[@aidx].AssetType" value="@a.AssetType" />

                                    <div class="row g-3">
                                        <div class="col-md-12">
                                            <div class="d-flex justify-content-between align-items-center mb-2">
                                                <strong class="text-primary">3D模型 #@(aidx + 1)</strong>
                                                <button type="button" class="btn btn-sm btn-outline-danger btn-delete-asset">刪除此模型</button>
                                            </div>
                                        </div>

                                        <div class="col-md-4">
                                            <label class="form-label">資產類型</label>
                                            <select class="form-select model-asset-type-select" name="Data.Assets[@aidx].AssetType">
                                                <option value="glb" selected="@(a.AssetType == "glb")">GLB模型</option>
                                                <option value="gltf" selected="@(a.AssetType == "gltf")">GLTF模型</option>
                                                <option value="pbr-basecolor" selected="@(a.AssetType == "pbr-basecolor")">PBR - BaseColor (基礎顏色)</option>
                                                <option value="pbr-normal" selected="@(a.AssetType == "pbr-normal")">PBR - Normal (法線貼圖)</option>
                                                <option value="pbr-metallic" selected="@(a.AssetType == "pbr-metallic")">PBR - Metallic (金屬度)</option>
                                                <option value="pbr-roughness" selected="@(a.AssetType == "pbr-roughness")">PBR - Roughness (粗糙度)</option>
                                                <option value="pbr-ao" selected="@(a.AssetType == "pbr-ao")">PBR - AO (環境光遮蔽)</option>
                                                <option value="pbr-emissive" selected="@(a.AssetType == "pbr-emissive")">PBR - Emissive (自發光)</option>
                                            </select>
                                        </div>

                                        <div class="col-md-4">
                                            <label class="form-label">上傳檔案</label>
                                            <input type="file" class="form-control model-file-input"
                                                   accept=".glb,.gltf,image/*"
                                                   data-asset-index="@aidx" />
                                            <small class="text-muted">支援 .glb, .gltf 或圖片檔案</small>
                                        </div>

                                        <div class="col-md-4">
                                            <label class="form-label">檔案URL</label>
                                            <input type="text" class="form-control form-control-sm model-url-display"
                                                   value="@a.Url" readonly />
                                        </div>

                                        <div class="col-md-4">
                                            <label class="form-label">縮圖URL (可選)</label>
                                            <input type="text" class="form-control form-control-sm"
                                                   name="Data.Assets[@aidx].PosterUrl"
                                                   value="@a.PosterUrl"
                                                   placeholder="3D模型的預覽圖" />
                                        </div>

                                        <div class="col-md-2">
                                            <label class="form-label">排序</label>
                                            <input type="number" class="form-control form-control-sm"
                                                   name="Data.Assets[@aidx].SortOrder"
                                                   value="@a.SortOrder" />
                                        </div>

                                        <div class="col-md-6">
                                            <label class="form-label">Metadata (JSON, 可選)</label>
                                            <input type="text" class="form-control form-control-sm"
                                                   name="Data.Assets[@aidx].MetadateJson"
                                                   value="@a.MetadateJson"
                                                   placeholder='{"scale": 1.0, "rotation": [0,0,0]}' />
                                        </div>
                                    </div>

                                    @if (!string.IsNullOrEmpty(a.Url))
                                    {
                                        var fileName = a.Url.Contains("/") ? a.Url.Substring(a.Url.LastIndexOf("/") + 1) : a.Url;
                                        <div class="mt-2 p-2 bg-light rounded">
                                            <small class="text-success">
                                                <i class="bi bi-check-circle me-1"></i>
                                                已上傳: @fileName
                                            </small>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </div>

            </div>

            <!-- 右側 Sidebar -->
            <div class="col-lg-4">
                <div class="card shadow-sm sticky-top" style="top:1rem;">
                    <div class="card-header">動作</div>
                    <div class="card-body">
                        <button type="submit" class="btn btn-primary w-100 mb-2">
                            <i class="bi bi-save me-1"></i> 儲存商品
                        </button>
                        <a asp-action="List" class="btn btn-outline-secondary w-100">取消</a>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

<!-- ========= 模板：變體 ========= -->
<script type="text/template" id="tpl-variant">
    <div class="border rounded p-2 mb-3 variant-item" data-variant-temp-index="__vidx__">
      <input type="hidden" name="Data.Variants[__vidx__].VariantId" value="" />
      <div class="row g-2">
        <div class="col-md-2">
          <label class="form-label">SKU</label>
          <input class="form-control" name="Data.Variants[__vidx__].SKU" required />
        </div>
        <div class="col-md-2">
          <label class="form-label">顏色</label>
          <select class="form-select" name="Data.Variants[__vidx__].ColorId">
            <option value="">無</option>
            @foreach (var c in Model.ColorOptions)
            {
                  <option value="@c.Value">@c.Text</option>
            }
          </select>
        </div>
        <div class="col-md-2">
          <label class="form-label">售價</label>
          <input class="form-control" name="Data.Variants[__vidx__].Price" />
        </div>
        <div class="col-md-2">
          <label class="form-label">成本</label>
          <input class="form-control" name="Data.Variants[__vidx__].Cost" />
        </div>
        <div class="col-md-2">
          <label class="form-label">庫存</label>
          <input class="form-control" name="Data.Variants[__vidx__].Stock" />
        </div>
        <div class="col-md-2">
          <label class="form-label">狀態</label>
          <select class="form-select" name="Data.Variants[__vidx__].PStatus">
            <option value="">請選擇</option>
            @foreach (var s in Model.PStatusOptions)
            {
                  <option value="@s.Value">@s.Text</option>
            }
          </select>
        </div>
      </div>
      <div class="row g-2 mt-2">
        <div class="col-md-3">
          <label class="form-label">尺寸標籤</label>
          <input class="form-control" name="Data.Variants[__vidx__].SizeLabel" />
        </div>
        <div class="col-md-2">
          <label class="form-label">長(cm)</label>
          <input class="form-control" name="Data.Variants[__vidx__].Length" />
        </div>
        <div class="col-md-2">
          <label class="form-label">寬(cm)</label>
          <input class="form-control" name="Data.Variants[__vidx__].Width" />
        </div>
        <div class="col-md-2">
          <label class="form-label">高(cm)</label>
          <input class="form-control" name="Data.Variants[__vidx__].Height" />
        </div>
        <div class="col-md-2">
          <label class="form-label">重量(kg)</label>
          <input class="form-control" name="Data.Variants[__vidx__].Weight" />
        </div>
      </div>

      <div class="mt-2">
        <div class="d-flex justify-content-between align-items-center">
          <small class="text-muted">此變體的圖片</small>
          <button type="button" class="btn btn-sm btn-outline-secondary btn-add-asset-for-variant" data-variant-temp-index="__vidx__">＋圖片</button>
        </div>
        <div class="variant-asset-list mt-1"></div>
      </div>

      <div class="mt-2 text-end">
        <button type="button" class="btn btn-sm btn-outline-danger btn-delete-variant">刪除此變體</button>
      </div>
    </div>
</script>

<!-- ========= 模板：變體資產 ========= -->
<script type="text/template" id="tpl-asset-for-variant">
    <div class="asset-item border rounded p-2 mb-2" data-asset-index="__aidx__">
      <input type="hidden" name="Data.Assets[__aidx__].AssetId" value="" />
      <input type="hidden" name="Data.Assets[__aidx__].VariantTempIndex" value="__vidx__" />
      <input type="hidden" class="asset-url" name="Data.Assets[__aidx__].Url" value="" />
      <input type="hidden" class="asset-mime" name="Data.Assets[__aidx__].MimeType" value="" />
