@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const variantList = document.getElementById('variant-list');
        const btnAddVariant = document.getElementById('btnAddVariant');
        const tplVariant = document.getElementById('tpl-variant').innerHTML.trim();

        const productAssetList = document.getElementById('product-asset-list');
        const modelAssetList   = document.getElementById('model-asset-list');
        const btnAddProductAsset = document.getElementById('btnAddProductAsset');
        const btnAdd3DAsset      = document.getElementById('btnAdd3DAsset');

        const tplAssetVariant = document.getElementById('tpl-asset-for-variant').innerHTML.trim();
        const tplAssetProduct = document.getElementById('tpl-asset-for-product').innerHTML.trim();
        const tpl3DAsset      = document.getElementById('tpl-3d-asset').innerHTML.trim();
        const tplPbrVariant   = document.getElementById('tpl-pbr-for-variant').innerHTML.trim();

        // ===== 上傳用：統一函式（用 X-AssetType） =====
        async function uploadFile(file, assetType = "") {
            const url = '@Url.Action("UploadAsset", "Products")';
            const fd = new FormData();
            fd.append('file', file); // ★ 後端使用 [FromForm] IFormFile file

            const res = await fetch(url, {
                method: 'POST',
                // 若和後端不同來源需帶 cookie 時再開啟
                // credentials: 'include',
                headers: {
                    'X-AssetType': assetType || ''
                    // 如後端改回 [ValidateAntiForgeryToken]：加上
                    // 'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? ''
                },
                body: fd
            });
            if (!res.ok) {
                const msg = await res.text().catch(() => '');
                throw new Error(msg || `Upload failed (${res.status})`);
            }
            return await res.json(); // { url, mime, name, fileType }
        }

        // ===== 綁定所有檔案上傳 input =====
        function bindFilePickers(scope) {
            (scope ?? document).querySelectorAll('.asset-file, .model-file-input').forEach(ip => {
                ip.addEventListener('change', async (e) => {
                    const input = e.currentTarget;
                    const file  = input.files?.[0];
                    if (!file) return;

                    const card   = input.closest('.asset-item');
                    const urlEl  = card?.querySelector('input[name$=".Url"]');
                    const mimeEl = card?.querySelector('input[name$=".MimeType"]');
                    const typeEl = card?.querySelector('input[name$=".AssetType"], select[name$=".AssetType"]');
                    const typeVal = (typeEl?.value || '').trim().toLowerCase();

                    try {
                        input.disabled = true;

                        // 上傳
                        const j = await uploadFile(file, typeVal);

                        // 寫入 URL/MIME
                        if (urlEl)  urlEl.value  = j.url ?? '';
                        if (mimeEl) {
                            if (typeVal === 'glb' || typeVal === 'gltf' || typeVal.startsWith('pbr-')) {
                                mimeEl.value = '';
                            } else {
                                mimeEl.value = j.mime || file.type || '';
                            }
                        }
                        // 若沒指定 AssetType（普通圖片）
                        if (typeEl && !typeVal) typeEl.value = 'image';

                        // 圖片預覽
                        const previewWrap = card?.querySelector('.asset-preview');
                        if (previewWrap && (j.mime || file.type || '').startsWith('image/')) {
                            let img = previewWrap.querySelector('img');
                            if (!img) {
                                img = document.createElement('img');
                                img.className = 'img-thumbnail';
                                img.style.maxWidth = '120px';
                                img.style.maxHeight = '120px';
                                previewWrap.appendChild(img);
                            }
                            img.src = j.url;
                            previewWrap.classList.remove('d-none');
                        }

                        // 3D 模型：URL 顯示
                        const urlDisplay = card?.querySelector('.model-url-display');
                        if (urlDisplay) urlDisplay.value = j.url || '';

                    } catch (err) {
                        alert(err?.message || 'Upload failed');
                    } finally {
                        input.disabled = false;
                        input.value = '';
                    }
                });
            });
        }

        function nextAssetIndex() {
            const items = document.querySelectorAll('.asset-item[data-asset-index]');
            let max = -1;
            items.forEach(el => {
                const n = parseInt(el.getAttribute('data-asset-index') || '-1');
                if (!isNaN(n) && n > max) max = n;
            });
            return max + 1;
        }

        // ===== 新增變體 =====
        function currentVariantCount(){ return variantList.querySelectorAll('.variant-item').length; }
        btnAddVariant?.addEventListener('click', function () {
            const vidx = currentVariantCount();
            const html = tplVariant.replaceAll('__vidx__', vidx);
            const wrap = document.createElement('div'); wrap.innerHTML = html;
            const node = wrap.firstElementChild;
            variantList.appendChild(node);
        });

        // 刪除變體（硬刪除）
        variantList?.addEventListener('click', function (e) {
            const btn = e.target.closest('.btn-delete-variant');
            if (!btn) return;
            const card = btn.closest('.variant-item');
            if (confirm('確定要刪除此變體嗎？')) card.remove();
        });

        // ===== 新增某變體的 image 資產 =====
        variantList?.addEventListener('click', function (e) {
            const btn = e.target.closest('.btn-add-asset-for-variant');
            if (!btn) return;
            const vidx = btn.getAttribute('data-variant-temp-index');
            const container = btn.closest('.variant-item').querySelector('.variant-asset-list');
            const aidx = nextAssetIndex();
            const html = tplAssetVariant.replaceAll('__aidx__', aidx).replaceAll('__vidx__', vidx);
            const wrap = document.createElement('div'); wrap.innerHTML = html;
            const node = wrap.firstElementChild;
            container.appendChild(node);
            bindFilePickers(node);
        });

        // ===== 新增某變體的 PBR 資產 =====
        variantList?.addEventListener('click', function(e) {
            const btn = e.target.closest('.btn-add-pbr-for-variant');
            if (!btn) return;

            const variantTempIdx = btn.getAttribute('data-variant-temp-index');
            const variantItem = btn.closest('.variant-item');
            const container = variantItem.querySelector('.variant-pbr-list');

            const aidx = nextAssetIndex();
            const html = tplPbrVariant.replaceAll('__aidx__', aidx).replaceAll('__vidx__', variantTempIdx);
            const wrap = document.createElement('div'); wrap.innerHTML = html;
            const node = wrap.firstElementChild;
            container.appendChild(node);
            bindFilePickers(node);
        });

        // ===== 新增通用資產 =====
        btnAddProductAsset?.addEventListener('click', function(){
            const aidx = nextAssetIndex();
            const html = tplAssetProduct.replaceAll('__aidx__', aidx);
            const wrap = document.createElement('div'); wrap.innerHTML = html;
            const node = wrap.firstElementChild;
            productAssetList.appendChild(node);
            bindFilePickers(node);
        });

        // ===== 新增 3D 模型 =====
        btnAdd3DAsset?.addEventListener('click', function(){
            const aidx = nextAssetIndex();
            const html = tpl3DAsset.replaceAll('__aidx__', aidx);
            const wrap = document.createElement('div'); wrap.innerHTML = html;
            const node = wrap.firstElementChild;
            modelAssetList.appendChild(node);
            bindFilePickers(node);
        });

        // ===== 刪除資產（硬刪除）=====
        document.addEventListener('click', function (e) {
            const btn = e.target.closest('.btn-delete-asset');
            if (!btn) return;
            const card = btn.closest('.asset-item');
            if (confirm('確定要刪除此資產嗎？')) card.remove();
        });

        // ===== 初次綁定 =====
        document.addEventListener('DOMContentLoaded', () => {
            bindFilePickers(); // 綁定初始畫面所有 file input

            // 依 MIME 顯示/隱藏預覽（初次渲染）
            document.querySelectorAll('.asset-item').forEach(card => {
                const mime = card.querySelector('.asset-mime')?.value || '';
                const url  = card.querySelector('.asset-url')?.value || '';
                const preview = card.querySelector('.asset-preview');
                const img = preview?.querySelector('img');
                if (preview && img && (mime.startsWith('image/') || url.match(/\.(png|jpg|jpeg|gif|webp)$/i))) {
                    img.src = url;
                    preview.classList.remove('d-none');
                } else if (preview) {
                    preview.classList.add('d-none');
                }
            });
        });

        // ===== 送出前重編號（Variants/Assets 的索引一致化）=====
        document.getElementById('createForm')?.addEventListener('submit', function(e) {
            // 重新編號變體
            const allVariants = Array.from(document.querySelectorAll('.variant-item'));
            allVariants.forEach((variant, newVIdx) => {
                variant.setAttribute('data-variant-temp-index', newVIdx);
                variant.querySelectorAll('input, select, textarea').forEach(input => {
                    const name = input.getAttribute('name');
                    if (name && name.match(/Data\.Variants\[\d+\]/)) {
                        input.setAttribute('name', name.replace(/Data\.Variants\[\d+\]/, `Data.Variants[${newVIdx}]`));
                    }
                });
            });

            // 重新編號資產
            const allAssets = Array.from(document.querySelectorAll('.asset-item'));
            allAssets.forEach((asset, newAIdx) => {
                asset.setAttribute('data-asset-index', newAIdx);
                asset.querySelectorAll('input, select, textarea').forEach(input => {
                    const name = input.getAttribute('name');
                    if (name && name.match(/Data\.Assets\[\d+\]/)) {
                        input.setAttribute('name', name.replace(/Data\.Assets\[\d+\]/, `Data.Assets[${newAIdx}]`));
                    }
                });
            });
        });
    </script>
}
