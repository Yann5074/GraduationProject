@model GraduationProject.ViewModels.CProductEditViewModel
@{
    ViewData["Title"] = "新增商品";

    // 確保 Data/Variants/Assets 不為 null
    Model.Data ??= new GraduationProject.DTOs.CProductUpdateDTO();
    Model.Data.Variants ??= new List<GraduationProject.DTOs.CProductVariantDTO> { new GraduationProject.DTOs.CProductVariantDTO() };
    Model.Data.Assets ??= new List<GraduationProject.DTOs.CProductAssetDTO>();

    var d = Model.Data;

    // 把資產加上原始索引方便輸出正確的 name
    var assetsWithIndex = (d.Assets ?? new List<GraduationProject.DTOs.CProductAssetDTO>())
                          .Select((a, idx) => new { A = a, Index = idx }).ToList();

    // 依暫存變體索引分組（Create 階段）
    Func<int, IEnumerable<dynamic>> assetsOfVariantTemp = (tempIdx) =>
        assetsWithIndex.Where(x => (x.A.VariantTempIndex ?? -1) == tempIdx);

    // 商品通用資產（未綁任何變體）
    var productAssets = assetsWithIndex.Where(x => (x.A.VariantTempIndex ?? -1) < 0);
}

<div class="container py-4">
    <div class="d-flex align-items-center justify-content-between mb-3">
        <h2 class="mb-0">新增商品</h2>
        <a asp-action="List" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> 返回列表
        </a>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }
    @if (TempData["Ok"] != null)
    {
        <div class="alert alert-success">@TempData["Ok"]</div>
    }

    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()

        <div class="row g-3">
            <!-- 左側主內容 -->
            <div class="col-lg-8">

                <!-- 基本資料 -->
                <div class="card shadow-sm">
                    <div class="card-header">基本資料</div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label class="form-label">商品名稱</label>
                            <input class="form-control" asp-for="Data.Name" required />
                            <span class="text-danger" asp-validation-for="Data.Name"></span>
                        </div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label">分類</label>
                                <select class="form-select" asp-for="Data.CategoryId" asp-items="Model.CategoryOptions"></select>
                                <span class="text-danger" asp-validation-for="Data.CategoryId"></span>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">狀態</label>
                                <select class="form-select" asp-for="Data.PStatus" asp-items="Model.PStatusOptions"></select>
                                <span class="text-danger" asp-validation-for="Data.PStatus"></span>
                            </div>
                        </div>

                        <div class="mb-3 mt-3">
                            <label class="form-label">描述</label>
                            <textarea class="form-control" asp-for="Data.Description" rows="3"></textarea>
                        </div>

                        <div class="row g-3">
                            <div class="col-md-3">
                                <label class="form-label">保固(月)</label>
                                <input class="form-control" asp-for="Data.WarrantyMonth" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">需組裝</label>
                                <select class="form-select" asp-for="Data.AssemblyRequired">
                                    <option value="">不指定</option>
                                    <option value="true">是</option>
                                    <option value="false">否</option>
                                </select>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">折扣</label>
                                <input class="form-control" asp-for="Data.Discount" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">組裝零件</label>
                                <input class="form-control" asp-for="Data.AssemblyPart" />
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 變體 + 對應資產 -->
                <div class="card shadow-sm mt-3">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <span>變體（顏色 / 尺寸 / 庫存 / 售價）— 含各變體資產</span>
                        <button type="button" class="btn btn-sm btn-outline-primary" id="btnAddVariant">＋新增變體</button>
                    </div>
                    <div class="card-body">
                        <div id="variant-list">
                            @{
                                var variants = d.Variants ?? new List<GraduationProject.DTOs.CProductVariantDTO>();
                            }
                            @for (int i = 0; i < variants.Count; i++)
                            {
                                var v = variants[i];
                                <div class="border rounded p-2 mb-3 variant-item" data-variant-temp-index="@i">
                                    <input type="hidden" name="Data.Variants[@i].VariantId" value="@v.VariantId" />
                                    <input type="hidden" name="Data.Variants[@i].Deleted" value="" />

                                    <div class="row g-2">
                                        <div class="col-md-2">
                                            <label class="form-label">SKU</label>
                                            <input class="form-control" name="Data.Variants[@i].SKU" value="@v.SKU" required />
                                        </div>

                                        <div class="col-md-2">
                                            <label class="form-label">顏色</label>
                                            <select class="form-select" name="Data.Variants[@i].ColorId">
                                                <option value="">無</option>
                                                @foreach (var c in Model.ColorOptions)
                                                {
                                                    if (v.ColorId?.ToString() == c.Value)
                                                    {
                                                        <option value="@c.Value" selected>@c.Text</option>
                                                    }
                                                    else
                                                    {
                                                        <option value="@c.Value">@c.Text</option>
                                                    }
                                                }
                                            </select>
                                        </div>

                                        <div class="col-md-2">
                                            <label class="form-label">售價</label>
                                            <input class="form-control" name="Data.Variants[@i].Price" value="@(v.Price?.ToString() ?? "")" />
                                        </div>

                                        <div class="col-md-2">
                                            <label class="form-label">成本</label>
                                            <input class="form-control" name="Data.Variants[@i].Cost" value="@(v.Cost?.ToString() ?? "")" />
                                        </div>

                                        <div class="col-md-2">
                                            <label class="form-label">庫存</label>
                                            <input class="form-control" name="Data.Variants[@i].Stock" value="@(v.Stock?.ToString() ?? "")" />
                                        </div>

                                        <div class="col-md-2">
                                            <label class="form-label">狀態</label>
                                            <select class="form-select" name="Data.Variants[@i].PStatus">
                                                @foreach (var s in Model.PStatusOptions)
                                                {
                                                    if (v.PStatus?.ToString() == s.Value)
                                                    {
                                                        <option value="@s.Value" selected>@s.Text</option>
                                                    }
                                                    else
                                                    {
                                                        <option value="@s.Value">@s.Text</option>
                                                    }
                                                }
                                            </select>
                                        </div>

                                        
                                        <div class="col-md-2">
                                            <label class="form-label">長</label>
                                            <input class="form-control" name="Data.Variants[@i].Length" value="@(v.Length?.ToString() ?? "")" />
                                        </div>
                                        <div class="col-md-2">
                                            <label class="form-label">寬</label>
                                            <input class="form-control" name="Data.Variants[@i].Width" value="@(v.Width?.ToString() ?? "")" />
                                        </div>
                                        <div class="col-md-2">
                                            <label class="form-label">高</label>
                                            <input class="form-control" name="Data.Variants[@i].Height" value="@(v.Height?.ToString() ?? "")" />
                                        </div>
                                        <div class="col-md-2">
                                            <label class="form-label">重量</label>
                                            <input class="form-control" name="Data.Variants[@i].Weight" value="@(v.Weight?.ToString() ?? "")" />
                                        </div>

                                        <div class="col-md-2 d-flex align-items-end">
                                            <button type="button" class="btn btn-outline-danger w-100 btn-delete-variant">刪除變體</button>
                                        </div>
                                    </div>

                                    <!-- 此變體的資產（用 VariantTempIndex 分組） -->
                                    <div class="bg-light rounded p-2 mt-2">
                                        <div class="d-flex align-items-center justify-content-between mb-2">
                                            <strong>此變體的資產</strong>
                                            <button type="button" class="btn btn-sm btn-outline-primary btn-add-asset-for-variant" data-variant-temp-index="@i">＋新增此變體資產</button>
                                        </div>

                                        <div class="row g-2 variant-asset-list">
                                            @foreach (var item in assetsOfVariantTemp(i))
                                            {
                                                var a = item.A; var ai = item.Index;
                                                var isImg = !string.IsNullOrWhiteSpace(a.MimeType) && a.MimeType.StartsWith("image/");
                                                <div class="col-12 asset-item border rounded p-2 mb-2" data-asset-index="@ai">
                                                    <input type="hidden" name="Data.Assets[@ai].AssetId" value="@a.AssetId" />
                                                    <input type="hidden" name="Data.Assets[@ai].Deleted" value="" />
                                                    <input type="hidden" name="Data.Assets[@ai].VariantTempIndex" value="@(a.VariantTempIndex?.ToString() ?? i.ToString())" />

                                                    <div class="row g-2 align-items-end">
                                                        <div class="col-md-3">
                                                            <label class="form-label">URL</label>
                                                            <input class="form-control asset-url" name="Data.Assets[@ai].Url" value="@a.Url" />
                                                        </div>
                                                        <div class="col-md-2">
                                                            <label class="form-label">類型</label>
                                                            <input class="form-control asset-type" name="Data.Assets[@ai].AssetType" value="@a.AssetType" placeholder="image/video/model" />
                                                        </div>
                                                        <div class="col-md-2">
                                                            <label class="form-label">MIME</label>
                                                            <input class="form-control asset-mime" name="Data.Assets[@ai].MimeType" value="@a.MimeType" placeholder="image/png 等" />
                                                        </div>
                                                        <div class="col-md-1">
                                                            <label class="form-label">排序</label>
                                                            <input class="form-control" name="Data.Assets[@ai].SortOrder" value="@(a.SortOrder?.ToString() ?? "")" />
                                                        </div>
                                                        <div class="col-md-2">
                                                            <label class="form-label">Poster</label>
                                                            <input class="form-control" name="Data.Assets[@ai].PosterUrl" value="@a.PosterUrl" />
                                                        </div>
                                                        <div class="col-md-1">
                                                            <input type="hidden" name="Data.Assets[@ai].IsPrimary" value="false" />
                                                            <div class="form-check">
                                                                <input class="form-check-input" type="checkbox" name="Data.Assets[@ai].IsPrimary" value="true" @(a.IsPrimary == true ? "checked" : null) />
                                                                <label class="form-check-label">主圖</label>
                                                            </div>
                                                        </div>
                                                        <div class="col-md-1 d-grid">
                                                            <button type="button" class="btn btn-outline-danger btn-delete-asset">刪除</button>
                                                        </div>

                                                        <div class="col-md-3">
                                                            <label class="form-label">上傳圖片</label>
                                                            <input type="file" class="form-control asset-file" accept="image/*" />
                                                            <small class="text-muted">僅支援圖片；上傳成功自動填入 URL/MIME</small>
                                                        </div>
                                                        <div class="col-md-3">
                                                            <div class="asset-preview border rounded p-1 @(isImg ? "" : "d-none")" style="width:160px;">
                                                                <img src="@a.Url" class="img-fluid rounded" alt="預覽" />
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <!-- 商品通用資產（不隸屬任何變體） -->
                <div class="card shadow-sm mt-3">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <span>商品通用資產（非變體專屬）</span>
                        <button type="button" class="btn btn-sm btn-outline-primary" id="btnAddProductAsset">＋新增通用資產</button>
                    </div>
                    <div class="card-body">
                        <div id="product-asset-list" class="row g-2">
                            @foreach (var item in productAssets)
                            {
                                var a = item.A; var ai = item.Index;
                                var isImg = !string.IsNullOrWhiteSpace(a.MimeType) && a.MimeType.StartsWith("image/");
                                <div class="col-12 asset-item border rounded p-2 mb-2" data-asset-index="@ai">
                                    <input type="hidden" name="Data.Assets[@ai].AssetId" value="@a.AssetId" />
                                    <input type="hidden" name="Data.Assets[@ai].Deleted" value="" />
                                    <input type="hidden" name="Data.Assets[@ai].VariantTempIndex" value="-1" />

                                    <div class="row g-2 align-items-end">
                                        <div class="col-md-3">
                                            <label class="form-label">URL</label>
                                            <input class="form-control asset-url" name="Data.Assets[@ai].Url" value="@a.Url" />
                                        </div>
                                        <div class="col-md-2">
                                            <label class="form-label">類型</label>
                                            <input class="form-control asset-type" name="Data.Assets[@ai].AssetType" value="@a.AssetType" placeholder="image/video/model" />
                                        </div>
                                        <div class="col-md-2">
                                            <label class="form-label">MIME</label>
                                            <input class="form-control asset-mime" name="Data.Assets[@ai].MimeType" value="@a.MimeType" placeholder="image/png 等" />
                                        </div>
                                        <div class="col-md-1">
                                            <label class="form-label">排序</label>
                                            <input class="form-control" name="Data.Assets[@ai].SortOrder" value="@(a.SortOrder?.ToString() ?? "")" />
                                        </div>
                                        <div class="col-md-2">
                                            <label class="form-label">Poster</label>
                                            <input class="form-control" name="Data.Assets[@ai].PosterUrl" value="@a.PosterUrl" />
                                        </div>
                                        <div class="col-md-1">
                                            <input type="hidden" name="Data.Assets[@ai].IsPrimary" value="false" />
                                            <div class="form-check">
                                                <input class="form-check-input" type="checkbox" name="Data.Assets[@ai].IsPrimary" value="true" @(a.IsPrimary == true ? "checked" : null) />
                                                <label class="form-check-label">主圖</label>
                                            </div>
                                        </div>
                                        <div class="col-md-1 d-grid">
                                            <button type="button" class="btn btn-outline-danger btn-delete-asset">刪除</button>
                                        </div>

                                        <div class="col-md-3">
                                            <label class="form-label">上傳圖片</label>
                                            <input type="file" class="form-control asset-file" accept="image/*" />
                                            <small class="text-muted">僅支援圖片；上傳成功自動填入 URL/MIME</small>
                                        </div>
                                        <div class="col-md-3">
                                            <div class="asset-preview border rounded p-1 @(isImg ? "" : "d-none")" style="width:160px;">
                                                <img src="@a.Url" class="img-fluid rounded" alt="預覽" />
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>

            </div>

            <!-- 右側動作 -->
            <div class="col-lg-4">
                <div class="card shadow-sm">
                    <div class="card-header">動作</div>
                    <div class="card-body d-grid gap-2">
                        <button class="btn btn-primary" type="submit">
                            <i class="bi bi-save me-1"></i> 建立
                        </button>
                        <a class="btn btn-outline-secondary" asp-action="List">取消</a>
                    </div>
                </div>

                <div class="mt-3">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                </div>
            </div>
        </div>
    </form>
</div>

<!-- 模板：變體／資產 -->
<template id="tpl-variant">
    <div class="border rounded p-2 mb-3 variant-item" data-variant-temp-index="__vidx__">
        <input type="hidden" name="Data.Variants[__vidx__].VariantId" value="" />
        <input type="hidden" name="Data.Variants[__vidx__].Deleted" value="" />

        <div class="row g-2">
            <div class="col-md-2">
                <label class="form-label">SKU</label>
                <input class="form-control" name="Data.Variants[__vidx__].SKU" required />
            </div>

            <div class="col-md-2">
                <label class="form-label">顏色</label>
                <select class="form-select" name="Data.Variants[__vidx__].ColorId">
                    <option value="">無</option>
                    @foreach (var c in Model.ColorOptions)
                    {
                        <option value="@c.Value">@c.Text</option>
                    }
                </select>
            </div>

            <div class="col-md-2">
                <label class="form-label">售價</label>
                <input class="form-control" name="Data.Variants[__vidx__].Price" />
            </div>

            <div class="col-md-2">
                <label class="form-label">成本</label>
                <input class="form-control" name="Data.Variants[__vidx__].Cost" />
            </div>

            <div class="col-md-2">
                <label class="form-label">庫存</label>
                <input class="form-control" name="Data.Variants[__vidx__].Stock" />
            </div>

            <div class="col-md-2">
                <label class="form-label">狀態</label>
                <select class="form-select" name="Data.Variants[__vidx__].PStatus">
                    @foreach (var s in Model.PStatusOptions)
                    {
                        <option value="@s.Value">@s.Text</option>
                    }
                </select>
            </div>

            <div class="col-md-2">
                <label class="form-label">尺寸</label>
                <input class="form-control" name="Data.Variants[__vidx__].SizeLabel" />
            </div>
            <div class="col-md-2">
                <label class="form-label">長</label>
                <input class="form-control" name="Data.Variants[__vidx__].Length" />
            </div>
            <div class="col-md-2">
                <label class="form-label">寬</label>
                <input class="form-control" name="Data.Variants[__vidx__].Width" />
            </div>
            <div class="col-md-2">
                <label class="form-label">高</label>
                <input class="form-control" name="Data.Variants[__vidx__].Height" />
            </div>
            <div class="col-md-2">
                <label class="form-label">重量</label>
                <input class="form-control" name="Data.Variants[__vidx__].Weight" />
            </div>

            <div class="col-md-2 d-flex align-items-end">
                <button type="button" class="btn btn-outline-danger w-100 btn-delete-variant">刪除變體</button>
            </div>
        </div>

        <div class="bg-light rounded p-2 mt-2">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <strong>此變體的資產</strong>
                <button type="button" class="btn btn-sm btn-outline-primary btn-add-asset-for-variant" data-variant-temp-index="__vidx__">＋新增此變體資產</button>
            </div>
            <div class="row g-2 variant-asset-list"></div>
        </div>
    </div>
</template>

<template id="tpl-asset-for-variant">
    <div class="col-12 asset-item border rounded p-2 mb-2" data-asset-index="__aidx__">
        <input type="hidden" name="Data.Assets[__aidx__].AssetId" value="" />
        <input type="hidden" name="Data.Assets[__aidx__].Deleted" value="" />
        <input type="hidden" name="Data.Assets[__aidx__].VariantTempIndex" value="__vidx__" />

        <div class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label">URL</label>
                <input class="form-control asset-url" name="Data.Assets[__aidx__].Url" />
            </div>
            <div class="col-md-2">
                <label class="form-label">類型</label>
                <input class="form-control asset-type" name="Data.Assets[__aidx__].AssetType" placeholder="image/video/model" />
            </div>
            <div class="col-md-2">
                <label class="form-label">MIME</label>
                <input class="form-control asset-mime" name="Data.Assets[__aidx__].MimeType" placeholder="image/png 等" />
            </div>
            <div class="col-md-1">
                <label class="form-label">排序</label>
                <input class="form-control" name="Data.Assets[__aidx__].SortOrder" />
            </div>
            <div class="col-md-2">
                <label class="form-label">Poster</label>
                <input class="form-control" name="Data.Assets[__aidx__].PosterUrl" />
            </div>
            <div class="col-md-1">
                <input type="hidden" name="Data.Assets[__aidx__].IsPrimary" value="false" />
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" name="Data.Assets[__aidx__].IsPrimary" value="true" />
                    <label class="form-check-label">主圖</label>
                </div>
            </div>
            <div class="col-md-1 d-grid">
                <button type="button" class="btn btn-outline-danger btn-delete-asset">刪除</button>
            </div>

            <div class="col-md-3">
                <label class="form-label">上傳圖片</label>
                <input type="file" class="form-control asset-file" accept="image/*" />
                <small class="text-muted">僅支援圖片；上傳成功自動填入 URL/MIME</small>
            </div>
            <div class="col-md-3">
                <div class="asset-preview border rounded p-1 d-none" style="width:160px;">
                    <img src="" class="img-fluid rounded" alt="預覽" />
                </div>
            </div>
        </div>
    </div>
</template>

<template id="tpl-asset-for-product">
    <div class="col-12 asset-item border rounded p-2 mb-2" data-asset-index="__aidx__">
        <input type="hidden" name="Data.Assets[__aidx__].AssetId" value="" />
        <input type="hidden" name="Data.Assets[__aidx__].Deleted" value="" />
        <input type="hidden" name="Data.Assets[__aidx__].VariantTempIndex" value="-1" />

        <div class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label">URL</label>
                <input class="form-control asset-url" name="Data.Assets[__aidx__].Url" />
            </div>
            <div class="col-md-2">
                <label class="form-label">類型</label>
                <input class="form-control asset-type" name="Data.Assets[__aidx__].AssetType" placeholder="image/video/model" />
            </div>
            <div class="col-md-2">
                <label class="form-label">MIME</label>
                <input class="form-control asset-mime" name="Data.Assets[__aidx__].MimeType" placeholder="image/png 等" />
            </div>
            <div class="col-md-1">
                <label class="form-label">排序</label>
                <input class="form-control" name="Data.Assets[__aidx__].SortOrder" />
            </div>
            <div class="col-md-2">
                <label class="form-label">Poster</label>
                <input class="form-control" name="Data.Assets[__aidx__].PosterUrl" />
            </div>
            <div class="col-md-1">
                <input type="hidden" name="Data.Assets[__aidx__].IsPrimary" value="false" />
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" name="Data.Assets[__aidx__].IsPrimary" value="true" />
                    <label class="form-check-label">主圖</label>
                </div>
            </div>
            <div class="col-md-1 d-grid">
                <button type="button" class="btn btn-outline-danger btn-delete-asset">刪除</button>
            </div>

            <div class="col-md-3">
                <label class="form-label">上傳圖片</label>
                <input type="file" class="form-control asset-file" accept="image/*" />
                <small class="text-muted">僅支援圖片；上傳成功自動填入 URL/MIME</small>
            </div>
            <div class="col-md-3">
                <div class="asset-preview border rounded p-1 d-none" style="width:160px;">
                    <img src="" class="img-fluid rounded" alt="預覽" />
                </div>
            </div>
        </div>
    </div>
</template>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // ========= 變體 =========
        const variantList = document.getElementById('variant-list');
        const tplVariant  = document.getElementById('tpl-variant').innerHTML.trim();
        const btnAddVariant = document.getElementById('btnAddVariant');

        function currentVariantCount(){ return variantList.querySelectorAll('.variant-item').length; }

        btnAddVariant?.addEventListener('click', function () {
          const vidx = currentVariantCount();
          const html = tplVariant.replaceAll('__vidx__', vidx);
          const wrap = document.createElement('div'); wrap.innerHTML = html;
          variantList.appendChild(wrap.firstElementChild);
        });

        variantList?.addEventListener('click', function (e) {
          const btn = e.target.closest('.btn-delete-variant');
          if (!btn) return;
          const card = btn.closest('.variant-item');
          const idx = card.getAttribute('data-variant-temp-index');
          // 標記變體刪除
          const flag = card.querySelector('input[name="Data.Variants['+idx+'].Deleted"]');
          if (flag) flag.value = 'true';
          // 同時把此變體底下的資產標記刪除
          card.querySelectorAll('.asset-item').forEach(ai=>{
            const df = ai.querySelector('input[name$=".Deleted"]');
            if (df) df.value = 'true';
            ai.style.opacity = .5;
          });
          card.style.opacity = .5;
        });

        // ========= 資產：新增（變體/商品通用）、刪除、上傳預覽 =========
        const tplAssetVariant = document.getElementById('tpl-asset-for-variant').innerHTML.trim();
        const tplAssetProduct = document.getElementById('tpl-asset-for-product').innerHTML.trim();
        const productAssetList = document.getElementById('product-asset-list');
        const btnAddProductAsset = document.getElementById('btnAddProductAsset');

        function nextAssetIndex() {
          const items = document.querySelectorAll('.asset-item[data-asset-index]');
          let max = -1;
          items.forEach(el => { const n = parseInt(el.getAttribute('data-asset-index')); if (!isNaN(n) && n > max) max = n; });
          return max + 1;
        }


        // 新增某變體的資產
        variantList?.addEventListener('click', function (e) {
          const btn = e.target.closest('.btn-add-asset-for-variant');
          if (!btn) return;
          const vidx = btn.getAttribute('data-variant-temp-index');
          const container = btn.closest('.variant-item').querySelector('.variant-asset-list');
          const aidx = nextAssetIndex();
          let html = tplAssetVariant.replaceAll('__aidx__', aidx).replaceAll('__vidx__', vidx);
          const wrap = document.createElement('div'); wrap.innerHTML = html;
          container.appendChild(wrap.firstElementChild);
        });

        // 新增通用資產
        btnAddProductAsset?.addEventListener('click', function(){
          const aidx = nextAssetIndex();
          const html = tplAssetProduct.replaceAll('__aidx__', aidx);
          const wrap = document.createElement('div'); wrap.innerHTML = html;
          productAssetList.appendChild(wrap.firstElementChild);
        });

        // 刪除資產（軟刪）
        document.addEventListener('click', function (e) {
          const btn = e.target.closest('.btn-delete-asset');
          if (!btn) return;
          const card = btn.closest('.asset-item');
          const flag = card.querySelector('input[name$=".Deleted"]');
          if (flag) flag.value = 'true';
          card.style.opacity = .5;
        });

        function isImageMime(m) { return typeof m === 'string' && m.startsWith('image/'); }

        async function uploadImage(file) {
          const url = '@Url.Action("UploadAsset", "Products")'; 
          const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
          const fd = new FormData(); fd.append('file', file);
          const res = await fetch(url, { method: 'POST', headers: { 'RequestVerificationToken': token }, body: fd });
          if (!res.ok) { throw new Error(await res.text() || 'Upload failed'); }
          return await res.json(); // { url, mime }
        }

        // 上傳後回寫與預覽
        document.addEventListener('change', async function (e) {
          const input = e.target;
          if (!input.classList.contains('asset-file')) return;
          const file = input.files?.[0]; if (!file) return;
          if (!file.type || !file.type.startsWith('image/')) { alert('僅支援圖片 (image/*)'); input.value=''; return; }

          const card = input.closest('.asset-item');
          const urlBox = card.querySelector('.asset-url');
          const mimeBox = card.querySelector('.asset-mime');
          const typeBox = card.querySelector('.asset-type');
          const preview = card.querySelector('.asset-preview');
          const img = preview?.querySelector('img');

          try {
            input.disabled = true;
            const { url, mime } = await uploadImage(file);
            if (urlBox) urlBox.value = url;
            if (mimeBox) mimeBox.value = mime || file.type;
            if (typeBox) typeBox.value = 'image';
            if (preview && img && isImageMime(mime || file.type)) { img.src = url; preview.classList.remove('d-none'); }
          } catch (err) {
            alert('上傳失敗：' + (err?.message ?? 'Unknown'));
          } finally {
            input.disabled = false;
          }
        });

        // 初次渲染：依 MIME 顯示/隱藏預覽
        document.querySelectorAll('.asset-item').forEach(card => {
          const mime = card.querySelector('.asset-mime')?.value || '';
          const url = card.querySelector('.asset-url')?.value || '';
          const preview = card.querySelector('.asset-preview');
          const img = preview?.querySelector('img');
          if (preview && img && isImageMime(mime) && url) { img.src = url; preview.classList.remove('d-none'); }
          else if (preview) { preview.classList.add('d-none'); }
        });


        
       
        const UPLOAD_URL = '@Url.Action("UploadAsset", "Products")';

                async function uploadImage(file) {
          const url = '@Url.Action("UploadAsset", "Products")';
          const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
          const fd = new FormData(); fd.append('file', file);
          const res = await fetch(url, { method: 'POST', headers: { 'RequestVerificationToken': token ?? '' }, body: fd });
          if (!res.ok) throw new Error(`HTTP ${res.status}`);
          return await res.json();
        }




                // 表單提交前重新編號所有資產索引
        document.querySelector('form')?.addEventListener('submit', function(e) {
            const allAssets = Array.from(document.querySelectorAll('.asset-item'))
                .filter(asset => {
                    const deletedFlag = asset.querySelector('input[name$=".Deleted"]');
                    return !deletedFlag || deletedFlag.value !== 'true';
                });

            allAssets.forEach((asset, newIndex) => {
                asset.setAttribute('data-asset-index', newIndex);
                asset.querySelectorAll('input, select, textarea').forEach(input => {
                    const name = input.getAttribute('name');
                    if (name && name.match(/Data\.Assets\[\d+\]/)) {
                        const newName = name.replace(/Data\.Assets\[\d+\]/, `Data.Assets[${newIndex}]`);
                        input.setAttribute('name', newName);
                    }
                });
            });
        });
    </script>
}
