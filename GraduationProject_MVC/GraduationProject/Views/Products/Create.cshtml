<script type="text/template" id="tpl-3d-asset">
    <div class="asset-item model-asset-item border rounded p-3 mb-3" data-asset-index="__aidx__">
      <input type="hidden" name="Data.Assets[__aidx__].AssetId" value="" />
      <input type="hidden" class="asset-url" name="Data.Assets[__aidx__].Url" value="" />
      <input type="hidden" class="asset-mime" name="Data.Assets[__aidx__].MimeType" value="" />
      <input type="hidden" class="asset-type" name="Data.Assets[__aidx__].AssetType" value="glb" />

      <div class="row g-3">
        <div class="col-md-12">
          <div class="d-flex justify-content-between align-items-center mb-2">
            <strong class="text-primary">3D模型 #__aidx__</strong>
            <button type="button" class="btn btn-sm btn-outline-danger btn-delete-asset">刪除此模型</button>
          </div>
        </div>

        <div class="col-md-4">
          <label class="form-label">資產類型</label>
          <select class="form-select model-asset-type-select" name="Data.Assets[__aidx__].AssetType">
            <option value="glb">GLB模型</option>
            <option value="gltf">GLTF模型</option>
            <option value="pbr-basecolor">PBR - BaseColor (基礎顏色)</option>
            <option value="pbr-normal">PBR - Normal (法線貼圖)</option>
            <option value="pbr-metallic">PBR - Metallic (金屬度)</option>
            <option value="pbr-roughness">PBR - Roughness (粗糙度)</option>
            <option value="pbr-ao">PBR - AO (環境光遮蔽)</option>
            <option value="pbr-emissive">PBR - Emissive (自發光)</option>
          </select>
        </div>

        <div class="col-md-4">
          <label class="form-label">上傳檔案</label>
          <input type="file" class="form-control model-file-input"
                 accept=".glb,.gltf,image/*"
                 data-asset-index="__aidx__" />
          <small class="text-muted">支援 .glb, .gltf 或圖片檔案</small>
        </div>

        <div class="col-md-4">
          <label class="form-label">檔案URL</label>
          <input type="text" class="form-control form-control-sm model-url-display" readonly />
        </div>

        <div class="col-md-4">
          <label class="form-label">縮圖URL (可選)</label>
          <input type="text" class="form-control form-control-sm"
                 name="Data.Assets[__aidx__].PosterUrl"
                 placeholder="3D模型的預覽圖" />
        </div>

        <div class="col-md-2">
          <label class="form-label">排序</label>
          <input type="number" class="form-control form-control-sm"
                 name="Data.Assets[__aidx__].SortOrder" />
        </div>

        <div class="col-md-6">
          <label class="form-label">Metadata (JSON, 可選)</label>
          <input type="text" class="form-control form-control-sm"
                 name="Data.Assets[__aidx__].MetadateJson"
                 placeholder='{"scale": 1.0, "rotation": [0,0,0]}' />
        </div>
      </div>
    </div>
</script>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const variantList = document.getElementById('variant-list');
        const btnAddVariant = document.getElementById('btnAddVariant');
        const tplVariant = document.getElementById('tpl-variant').innerHTML.trim();

        function currentVariantCount(){ return variantList.querySelectorAll('.variant-item').length; }

        btnAddVariant?.addEventListener('click', function () {
          const vidx = currentVariantCount();
          const html = tplVariant.replaceAll('__vidx__', vidx);
          const wrap = document.createElement('div'); wrap.innerHTML = html;
          variantList.appendChild(wrap.firstElementChild);
        });

        variantList?.addEventListener('click', function (e) {
          const btn = e.target.closest('.btn-delete-variant');
          if (!btn) return;
          const card = btn.closest('.variant-item');

          // 硬刪除：直接從DOM移除
          if (confirm('確定要刪除此變體嗎？')) {
            card.remove();
          }
        });

        // ========= 資產：新增（變體/商品通用）、刪除、上傳預覽 =========
        const tplAssetVariant = document.getElementById('tpl-asset-for-variant').innerHTML.trim();
        const tplAssetProduct = document.getElementById('tpl-asset-for-product').innerHTML.trim();
        const tpl3DAsset = document.getElementById('tpl-3d-asset').innerHTML.trim();
        const productAssetList = document.getElementById('product-asset-list');
        const modelAssetList = document.getElementById('model-asset-list');
        const btnAddProductAsset = document.getElementById('btnAddProductAsset');
        const btnAdd3DAsset = document.getElementById('btnAdd3DAsset');

        function nextAssetIndex() {
          const items = document.querySelectorAll('.asset-item[data-asset-index]');
          let max = -1;
          items.forEach(el => { const n = parseInt(el.getAttribute('data-asset-index')); if (!isNaN(n) && n > max) max = n; });
          return max + 1;
        }

        // 新增某變體的資產
        variantList?.addEventListener('click', function (e) {
          const btn = e.target.closest('.btn-add-asset-for-variant');
          if (!btn) return;
          const vidx = btn.getAttribute('data-variant-temp-index');
          const container = btn.closest('.variant-item').querySelector('.variant-asset-list');
          const aidx = nextAssetIndex();
          let html = tplAssetVariant.replaceAll('__aidx__', aidx).replaceAll('__vidx__', vidx);
          const wrap = document.createElement('div'); wrap.innerHTML = html;
          container.appendChild(wrap.firstElementChild);
        });

        // 新增通用資產
        btnAddProductAsset?.addEventListener('click', function(){
          const aidx = nextAssetIndex();
          const html = tplAssetProduct.replaceAll('__aidx__', aidx);
          const wrap = document.createElement('div'); wrap.innerHTML = html;
          productAssetList.appendChild(wrap.firstElementChild);
        });

        // ===== 新增：3D模型資產 =====
        btnAdd3DAsset?.addEventListener('click', function(){
          const aidx = nextAssetIndex();
          const html = tpl3DAsset.replaceAll('__aidx__', aidx);
          const wrap = document.createElement('div'); wrap.innerHTML = html;
          modelAssetList.appendChild(wrap.firstElementChild);
        });

        // 刪除資產（硬刪除）
        document.addEventListener('click', function (e) {
          const btn = e.target.closest('.btn-delete-asset');
          if (!btn) return;
          const card = btn.closest('.asset-item');

          // 硬刪除：直接從DOM移除
          if (confirm('確定要刪除此資產嗎？')) {
            card.remove();
          }
        });

        function isImageMime(m) { return typeof m === 'string' && m.startsWith('image/'); }

        async function uploadImage(file) {
          const url = '@Url.Action("UploadAsset", "Products")';
          const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
          const fd = new FormData(); fd.append('file', file);
          const res = await fetch(url, { method: 'POST', headers: { 'RequestVerificationToken': token }, body: fd });
          if (!res.ok) { throw new Error(await res.text() || 'Upload failed'); }
          return await res.json(); // { url, mime }
        }

        // 上傳後回寫與預覽 (普通圖片資產)
        document.addEventListener('change', async function (e) {
          const input = e.target;
          if (!input.classList.contains('asset-file')) return;
          const file = input.files?.[0]; if (!file) return;
          if (!file.type || !file.type.startsWith('image/')) { alert('僅支援圖片 (image/*)'); input.value=''; return; }

          const card = input.closest('.asset-item');
          const urlBox = card.querySelector('.asset-url');
          const mimeBox = card.querySelector('.asset-mime');
          const typeBox = card.querySelector('.asset-type');
          const preview = card.querySelector('.asset-preview');
          const img = preview?.querySelector('img');

          try {
            input.disabled = true;
            const { url, mime } = await uploadImage(file);
            if (urlBox) urlBox.value = url;
            if (mimeBox) mimeBox.value = mime || file.type;
            if (typeBox) typeBox.value = 'image';
            if (preview && img && isImageMime(mime || file.type)) { img.src = url; preview.classList.remove('d-none'); }
          } catch (err) {
            alert('上傳失敗：' + (err?.message ?? 'Unknown'));
          } finally {
            input.disabled = false;
          }
        });

        // ===== 新增：3D模型檔案上傳處理 =====
        document.addEventListener('change', async function (e) {
          const input = e.target;
          if (!input.classList.contains('model-file-input')) return;

          const file = input.files?.[0];
          if (!file) return;

          const card = input.closest('.model-asset-item');
          const urlBox = card.querySelector('.asset-url');
          const mimeBox = card.querySelector('.asset-mime');
          const typeBox = card.querySelector('.asset-type');
          const urlDisplay = card.querySelector('.model-url-display');
          const assetTypeSelect = card.querySelector('.model-asset-type-select');

          try {
            input.disabled = true;

            // 根據檔案類型判斷
            const fileName = file.name.toLowerCase();
            let uploadResult;

            if (fileName.endsWith('.glb') || fileName.endsWith('.gltf')) {
              // 上傳3D模型檔案 (這裡假設使用相同的上傳接口，您可能需要創建專門的3D檔案上傳接口)
              uploadResult = await uploadImage(file);
              if (fileName.endsWith('.glb')) {
                typeBox.value = 'glb';
                assetTypeSelect.value = 'glb';
              } else {
                typeBox.value = 'gltf';
                assetTypeSelect.value = 'gltf';
              }
            } else if (file.type.startsWith('image/')) {
              // 上傳PBR貼圖
              uploadResult = await uploadImage(file);
              // 保持用戶選擇的 asset type
            } else {
              alert('不支援的檔案類型。請上傳 .glb、.gltf 或圖片檔案');
              input.value = '';
              return;
            }

            if (urlBox) urlBox.value = uploadResult.url;
            if (mimeBox) mimeBox.value = uploadResult.mime || file.type;
            if (urlDisplay) urlDisplay.value = uploadResult.url;

            // 顯示成功訊息
            alert('檔案上傳成功！');

          } catch (err) {
            alert('上傳失敗：' + (err?.message ?? 'Unknown'));
          } finally {
            input.disabled = false;
          }
        });

        // 初次渲染：依 MIME 顯示/隱藏預覽
        document.querySelectorAll('.asset-item').forEach(card => {
          const mime = card.querySelector('.asset-mime')?.value || '';
          const url = card.querySelector('.asset-url')?.value || '';
          const preview = card.querySelector('.asset-preview');
          const img = preview?.querySelector('img');
          if (preview && img && isImageMime(mime) && url) { img.src = url; preview.classList.remove('d-none'); }
          else if (preview) { preview.classList.add('d-none'); }
        });

        // 表單提交前重新編號所有資產索引
        document.querySelector('form')?.addEventListener('submit', function(e) {
            // 重新編號所有變體
            const allVariants = Array.from(document.querySelectorAll('.variant-item'));
            allVariants.forEach((variant, newIndex) => {
                variant.setAttribute('data-variant-temp-index', newIndex);
                variant.querySelectorAll('input, select, textarea').forEach(input => {
                    const name = input.getAttribute('name');
                    if (name && name.match(/Data\.Variants\[\d+\]/)) {
                        const newName = name.replace(/Data\.Variants\[\d+\]/, `Data.Variants[${newIndex}]`);
                        input.setAttribute('name', newName);
                    }
                });
            });

            // 重新編號所有資產
            const allAssets = Array.from(document.querySelectorAll('.asset-item'));
            allAssets.forEach((asset, newIndex) => {
                asset.setAttribute('data-asset-index', newIndex);
                asset.querySelectorAll('input, select, textarea').forEach(input => {
                    const name = input.getAttribute('name');
                    if (name && name.match(/Data\.Assets\[\d+\]/)) {
                        const newName = name.replace(/Data\.Assets\[\d+\]/, `Data.Assets[${newIndex}]`);
                        input.setAttribute('name', newName);
                    }
                });
            });
        });
    </script>
}
