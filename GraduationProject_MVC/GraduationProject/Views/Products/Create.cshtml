@model GraduationProject.DTOs.CProductCreateDTO


@using Microsoft.AspNetCore.Mvc.Rendering

@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewData["Title"] = "Create Product";
}

<h1 class="mb-4">Create Product</h1>

<form asp-controller="Products" asp-action="Create" method="post" enctype="multipart/form-data" class="needs-validation" novalidate>
    @Html.AntiForgeryToken()

    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="row g-3">
        <div class="col-md-6">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <div class="col-md-6">
            <label asp-for="CategoryId" class="form-label"></label>
            <select asp-for="CategoryId" asp-items="ViewBag.Categories" class="form-select">
                <option value="">-- Select Category --</option>
            </select>
            <span asp-validation-for="CategoryId" class="text-danger"></span>
        </div>

        <div class="col-12">
            <label asp-for="Description" class="form-label"></label>
            <textarea asp-for="Description" class="form-control" rows="4"></textarea>
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>

        <div class="col-md-4">
            <label asp-for="WarrantyMonth" class="form-label"></label>
            <input asp-for="WarrantyMonth" class="form-control" />
            <span asp-validation-for="WarrantyMonth" class="text-danger"></span>
        </div>

        <div class="col-md-4">
            <label asp-for="Discount" class="form-label"></label>
            <input asp-for="Discount" class="form-control" />
            <span asp-validation-for="Discount" class="text-danger"></span>
        </div>

        <div class="col-md-4">
            <label asp-for="PStatusId" class="form-label"></label>
            <select asp-for="PStatusId" asp-items="ViewBag.PStatus" class="form-select">
                <option value="">-- Select Status --</option>
            </select>
            <span asp-validation-for="PStatusId" class="text-danger"></span>
        </div>

        <div class="col-md-4">
            <div class="form-check mt-4">
                <input asp-for="AssemblyRequired" class="form-check-input" />
                <label asp-for="AssemblyRequired" class="form-check-label"></label>
            </div>
            <span asp-validation-for="AssemblyRequired" class="text-danger"></span>
        </div>

        <div class="col-md-8" id="AssemblyPartGroup">
            <label asp-for="AssemblyPart" class="form-label"></label>
            <input asp-for="AssemblyPart" class="form-control" />
            <span asp-validation-for="AssemblyPart" class="text-danger"></span>
        </div>

        <div class="col-12">
            <label asp-for="Images" class="form-label"></label>
            <input asp-for="Images" type="file" class="form-control" multiple accept=".jpg,.jpeg,.png,.webp,.gif" />
            <div class="form-text">First image will be marked as primary. You can reorder after creation if needed.</div>
            <span asp-validation-for="Images" class="text-danger"></span>
        </div>
    </div>

    <hr class="my-4" />

    <h5 class="mb-3">Variants</h5>
    <div id="variants-container"></div>
    <button type="button" class="btn btn-outline-primary" id="btn-add-variant">+ Add Variant</button>

    <div class="mt-4">
        <button type="submit" class="btn btn-success me-2">Create</button>
        <a asp-action="List" asp-controller="Products" class="btn btn-secondary">Back to List</a>
    </div>
</form>

<template id="variant-template">
    <fieldset class="variant border rounded p-3 mb-3">
        <legend class="float-none w-auto px-2">Variant <span class="variant-index"></span></legend>
        <div class="row g-3">
            <div class="col-md-3">
                <label class="form-label" for="Variants___index__-Price">Price</label>
                <input class="form-control" id="Variants___index__-Price" name="Variants[__index__].Price" type="number" step="0.01" />
            </div>
            <div class="col-md-3">
                <label class="form-label" for="Variants___index__-Cost">Cost</label>
                <input class="form-control" id="Variants___index__-Cost" name="Variants[__index__].Cost" type="number" step="0.01" />
            </div>
            <div class="col-md-3">
                <label class="form-label" for="Variants___index__-Stock">Stock</label>
                <input class="form-control" id="Variants___index__-Stock" name="Variants[__index__].Stock" type="number" />
            </div>
            <div class="col-md-3">
                <label class="form-label" for="Variants___index__-PStatusId">Status</label>
                <select class="form-select" id="Variants___index__-PStatusId" name="Variants[__index__].PStatusId">
                    <option value="">-- Select Status --</option>
                    @if (ViewBag.PStatus != null)
                    {
                        foreach (var opt in (IEnumerable<SelectListItem>)ViewBag.PStatus)
                        {
                            <option value="@opt.Value">@opt.Text</option>
                        }
                    }
                </select>
            </div>

            <div class="col-md-4">
                <label class="form-label" for="Variants___index__-ColorId">Color</label>
                <select class="form-select" id="Variants___index__-ColorId" name="Variants[__index__].ColorId">
                    <option value="">-- Select Color --</option>
                    @if (ViewBag.Colors != null)
                    {
                        foreach (var opt in (IEnumerable<SelectListItem>)ViewBag.Colors)
                        {
                            <option value="@opt.Value">@opt.Text</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label" for="Variants___index__-Length">Length</label>
                <input class="form-control" id="Variants___index__-Length" name="Variants[__index__].Length" type="number" step="0.01" />
            </div>
            <div class="col-md-2">
                <label class="form-label" for="Variants___index__-Width">Width</label>
                <input class="form-control" id="Variants___index__-Width" name="Variants[__index__].Width" type="number" step="0.01" />
            </div>
            <div class="col-md-2">
                <label class="form-label" for="Variants___index__-Height">Height</label>
                <input class="form-control" id="Variants___index__-Height" name="Variants[__index__].Height" type="number" step="0.01" />
            </div>
            <div class="col-md-2">
                <label class="form-label" for="Variants___index__-Weight">Weight</label>
                <input class="form-control" id="Variants___index__-Weight" name="Variants[__index__].Weight" type="number" step="0.01" />
            </div>

            <div class="col-md-4">
                <label class="form-label" for="Variants___index__-SizeLabel">Size Label</label>
                <input class="form-control" id="Variants___index__-SizeLabel" name="Variants[__index__].SizeLabel" type="text" />
            </div>

            <div class="col-12">
                <label class="form-label" for="Variants___index__-VariantImages">Variant Images</label>
                <input class="form-control" id="Variants___index__-VariantImages" name="Variants[__index__].VariantImages" type="file" multiple accept=".jpg,.jpeg,.png,.webp,.gif" />
                <div class="form-text">First image of the variant will be marked as primary.</div>
            </div>
        </div>
        <button type="button" class="btn btn-outline-danger mt-3 btn-remove-variant">Remove Variant</button>
    </fieldset>
</template>

@section Scripts{
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function(){
            // AssemblyPart toggle
            const ar = document.getElementById('AssemblyRequired');
            const apGroup = document.getElementById('AssemblyPartGroup');
            function toggleAp(){ apGroup.style.display = ar && ar.checked ? '' : 'none'; }
            if (ar) { ar.addEventListener('change', toggleAp); toggleAp(); }

            // Variants dynamic add/remove
            let variantIndex = 0;
            const btnAdd = document.getElementById('btn-add-variant');
            const container = document.getElementById('variants-container');
            const tpl = document.getElementById('variant-template');

            function renumber(){
                container.querySelectorAll('.variant').forEach((v,i)=>{
                    const badge = v.querySelector('.variant-index');
                    if (badge) badge.textContent = i+1;
                });
            }

            function addVariant(){
                const html = tpl.innerHTML.replace(/__index__/g, variantIndex);
                const host = document.createElement('div');
                host.innerHTML = html.trim();
                const node = host.firstElementChild;
                container.appendChild(node);
                variantIndex++;
                renumber();
            }

            container.addEventListener('click', function(e){
                if (e.target && e.target.classList.contains('btn-remove-variant')){
                    const box = e.target.closest('.variant');
                    if (box) box.remove();
                    renumber();
                }
            });

            if (btnAdd) btnAdd.addEventListener('click', addVariant);
        })();
    </script>
}
