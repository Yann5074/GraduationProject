@model IEnumerable<GraduationProject.DTOs.CProductDTO>

@{
    ViewData["Title"] = "商品列表";
}

<div class="container py-4">
    <div class="d-flex align-items-center justify-content-between mb-3">
        <h2 class="mb-0">商品列表</h2>
        <div>
            <a asp-action="Create" class="btn btn-primary">
                <i class="bi bi-plus-lg me-1"></i> 新增商品
            </a>
        </div>
    </div>

    <!-- 篩選列（如你已有外部 Partial，可用 Html.Partial 取代這塊） -->
    <div class="card shadow-sm mb-3">
        <div class="card-body">
            <form method="get" asp-action="List">
                <div class="row g-2">
                    <div class="col-md-4">
                        <input name="txtKeyword" value="@Context.Request.Query["txtKeyword"]" class="form-control" placeholder="搜尋名稱 / 分類 / 狀態 / 顏色" />
                    </div>
                    <div class="col-md-2">
                        <button type="submit" class="btn btn-outline-primary w-100">
                            <i class="bi bi-search me-1"></i> 搜尋
                        </button>
                    </div>
                    <div class="col-md-6 text-end">
                        @if (TempData["Ok"] != null)
                        {
                            <span class="badge bg-success px-3 py-2">@TempData["Ok"]</span>
                        }
                        @if (TempData["Error"] != null)
                        {
                            <span class="badge bg-danger px-3 py-2">@TempData["Error"]</span>
                        }
                    </div>
                </div>
            </form>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width: 110px;">主圖</th>
                        <th>商品</th>
                        <th style="width: 140px;">分類</th>
                        <th style="width: 120px;">狀態</th>
                        <th style="width: 120px;" class="text-end">最低價</th>
                        <th style="width: 200px;">顏色</th>
                        <th style="width: 220px;" class="text-end">動作</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        var idx = 0;
                        foreach (var item in Model)
                        {
                            var collapseId = $"collapse_{item.ProductId}_{idx++}";
                            <tr>
                                <td>
                                    <img src="@(item.PrimaryImageUrl ?? "/ProductImages/default.png")" class="img-fluid rounded" style="max-width:100px;" />
                                </td>
                                <td>
                                    <div class="d-flex flex-column">
                                        <strong>
                                            @item.Name
                                            (@(item.Variants?.Count ?? 0))
                                        </strong>
                                        @if (!string.IsNullOrWhiteSpace(item.Description))
                                        {
                                            <small class="text-muted text-truncate d-inline-block" style="max-width: 520px;">
                                                @item.Description
                                            </small>
                                        }
                                        <div class="mt-1">
                                            <button class="btn btn-sm btn-outline-secondary"
                                                    type="button"
                                                    data-bs-toggle="collapse"
                                                    data-bs-target="#@collapseId"
                                                    aria-expanded="false"
                                                    aria-controls="@collapseId">
                                                詳細
                                            </button>
                                        </div>
                                    </div>
                                </td>
                                <td>@item.CategoryName</td>
                                <td>
                                    @switch (item.FPStatusName)
                                    {
                                        case "上架":
                                        case "上架中":
                                            @:<span class="badge bg-success">上架</span>
                                            break;
                                        case "下架":
                                            @:<span class="badge bg-secondary">下架</span>
                                            break;
                                        case "缺貨":
                                            @:<span class="badge bg-warning text-dark">缺貨</span>
                                            break;
                                        case "刪除":
                                            @:<span class="badge bg-danger">刪除</span>
                                            break;
                                        default:
                                            // 修正點 #2：default 顯示 FPStatusName（你原本若顯示 PStatus 會錯）
                                            @:<span class="badge bg-info">@item.FPStatusName</span>
                                            break;
                                    }
                                </td>
                                <td class="text-end">
                                    @if (item.Price.HasValue)
                                    {
                                        @item.Price.Value.ToString("N0")
                                    }
                                </td>
                                <td>
                                    @item.ColorName
                                </td>
                                <td class="text-end">
                                    <div class="btn-group">
                                        <a class="btn btn-sm btn-outline-secondary" asp-action="Detail" asp-route-id="@item.ProductId">
                                            <i class="bi bi-eye me-1"></i> 檢視
                                        </a>
                                        <a class="btn btn-sm btn-primary" asp-action="Edit" asp-route-id="@item.ProductId">
                                            <i class="bi bi-pencil-square me-1"></i> 編輯
                                        </a>
                                        <form asp-action="Delete" asp-route-id="@item.ProductId" method="post" onsubmit="return confirm('確定要刪除嗎？');">
                                            <button class="btn btn-sm btn-outline-danger" type="submit">
                                                <i class="bi bi-trash me-1"></i> 刪除
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                            <tr class="collapse" id="@collapseId">
                                <td colspan="7" class="bg-light">
                                    <div class="p-3">
                                        <div class="row g-3">
                                            <div class="col-12">
                                                <h6 class="mb-2">
                                                    產品圖片
                                                    <small class="text-muted ms-2">(排序由小到大)</small>
                                                </h6>
                                                <div class="d-flex flex-wrap gap-2">
                                                    @if (item.ImageUrls != null && item.ImageUrls.Any())
                                                    {
                                                        foreach (var url in item.ImageUrls)
                                                        {
                                                            <img src="@url" class="rounded border" style="height:80px; width:auto;" />
                                                        }
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted">無圖片</span>
                                                    }
                                                </div>
                                            </div>

                                            <div class="col-12">
                                                <h6 class="mt-3 mb-2">
                                                    產品變體 (@(item.Variants?.Any() == true ? item.Variants.Count : 0))
                                                </h6>

                                                @if (item.Variants?.Any() == true)
                                                {
                                                    <div class="table-responsive">
                                                        <table class="table table-sm table-bordered align-middle">
                                                            <thead class="table-secondary">
                                                                <tr>
                                                                    <th style="width:130px;">SKU</th>
                                                                    <th style="width:140px;">顏色</th>
                                                                    <th style="width:100px;" class="text-end">售價</th>
                                                                    <th style="width:100px;" class="text-end">成本</th>
                                                                    <th style="width:90px;" class="text-end">庫存</th>
                                                                    <th style="width:110px;">尺寸</th>
                                                                    <th style="width:130px;">長×寬×高</th>
                                                                    <th style="width:90px;" class="text-end">重量</th>
                                                                    <th style="width:120px;">狀態</th>
                                                                </tr>
                                                            </thead>
                                                            <tbody>
                                                                @foreach (var variant in item.Variants)
                                                                {
                                                                    <tr>
                                                                        <td class="text-monospace">@variant.SKU</td>
                                                                        <td>
                                                                            @if (!string.IsNullOrWhiteSpace(variant.ColorName))
                                                                            {
                                                                                @variant.ColorName
                                                                            }
                                                                            else
                                                                            {
                                                                                <span class="text-muted">無</span>
                                                                            }
                                                                        </td>
                                                                        <td class="text-end">@((variant.Price ?? 0).ToString("N0"))</td>
                                                                        <td class="text-end">@((variant.Cost ?? 0).ToString("N0"))</td>
                                                                        <td class="text-end">@((variant.Stock ?? 0).ToString("N0"))</td>
                                                                        <td>@variant.SizeLabel</td>
                                                                        <td>
                                                                            @if (variant.Length.HasValue || variant.Width.HasValue || variant.Height.HasValue)
                                                                            {
                                                                                @($"{variant.Length ?? 0}×{variant.Width ?? 0}×{variant.Height ?? 0}")
                                                                            }
                                                                        </td>
                                                                        <td class="text-end">
                                                                            @if (variant.Weight.HasValue)
                                                                            {
                                                                                @variant.Weight.Value.ToString("N2")
                                                                            }
                                                                        </td>
                                                                        <td>
                                                                            @switch (variant.PStatusName)
                                                                            {
                                                                                case "上架":
                                                                                case "上架中":
                                                                                    @:<span class="badge bg-success">上架</span>
                                                                                    break;
                                                                                case "下架":
                                                                                    @:<span class="badge bg-secondary">下架</span>
                                                                                    break;
                                                                                case "缺貨":
                                                                                    @:<span class="badge bg-warning text-dark">缺貨</span>
                                                                                    break;
                                                                                case "刪除":
                                                                                    @:<span class="badge bg-danger">刪除</span>
                                                                                    break;
                                                                                default:
                                                                                    {
                                                                                        var fallback = !string.IsNullOrWhiteSpace(variant.PStatusName)
                                                                                        ? variant.PStatusName
                                                                                        : (variant.PStatus?.ToString() ?? "未知");
                                                                                        <span class="badge bg-info">@fallback</span>
                                                                                    }
                                                                                    break;
                                                                            }
                                                                        </td>
                                                                    </tr>
                                                                }
                                                            </tbody>
                                                        </table>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <div class="text-muted">沒有變體資料</div>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted py-5">
                                沒有符合條件的商品
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // 若你有使用 Bootstrap 5 的 collapse，需確定已載入 bootstrap.bundle.js
    </script>
}
