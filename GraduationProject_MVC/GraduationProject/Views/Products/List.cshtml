@model IEnumerable<GraduationProject.DTOs.CProductDTO>

@{
    ViewData["Title"] = "List";
}

<h2>商品清單</h2>

<!-- 搜尋表單 -->
<form method="get" asp-controller="Products" asp-action="List" class="mb-3">
    <input type="text" name="txtKeyword" value="@ViewBag.Keyword" placeholder="輸入關鍵字搜尋..." class="form-control" style="width:250px; display:inline-block;" />
    <button type="submit" class="btn btn-primary">搜尋</button>
    <a asp-action="List" class="btn btn-secondary">清除</a>
</form>

<!-- 顯示結果表格 -->
<table class="table table-striped">
    <thead>
        <tr>
            <th>編號</th>
            <th>名稱</th>
            <th>描述</th>
            <th>折扣</th>
            <th>狀態</th>
        </tr>
    </thead>
    <tbody>
        @if (!Model.Any())
        {
            <tr><td colspan="5" class="text-center">沒有符合的資料</td></tr>
        }
        else
        {
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.ProductId</td>
                    <td>@item.Name</td>
                    <td>@item.Description</td>
                    <td>@item.Discount</td>
                    <td>
                        @{
                            string statusText = item.PStatus switch
                            {
                                1 => "上架",
                                2 => "審核中",
                                _ => "下架"
                            };
                        }
                        @statusText
                    </td>
                </tr>
            }
        }
    </tbody>
</table>