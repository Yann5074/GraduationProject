@model IEnumerable<GraduationProject.DTOs.CProductDTO>


@{
    ViewData["Title"] = "產品列表";
}

<div class="container-fluid mt-4">
    <!-- 標題列 -->
    <div class="row mb-3">
        <div class="col-md-8">
            <h2><i class="fas fa-box"></i> 產品管理</h2>
        </div>
        <div class="col-md-4 text-end">
            <a asp-action="Create" class="btn btn-success">
                <i class="fas fa-plus"></i> 新增產品
            </a>
        </div>
    </div>

    <!-- 提示訊息 -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-circle"></i> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- 搜尋區域 -->
    <div class="card mb-3">
        <div class="card-body">
            <form asp-action="List" method="get">
                <div class="row">
                    <div class="col-md-4">
                        <label for="txtKeyword" class="form-label">搜尋關鍵字</label>
                        <input type="text" 
                               class="form-control" 
                               id="txtKeyword" 
                               name="txtKeyword" 
                               value="@ViewBag.Keyword" 
                               placeholder="輸入產品名稱、分類或顏色...">
                    </div>
                    <div class="col-md-8 d-flex align-items-end">
                        <button type="submit" class="btn btn-primary me-2">
                            <i class="fas fa-search"></i> 搜尋
                        </button>
                        <a asp-action="List" class="btn btn-secondary me-2">
                            <i class="fas fa-redo"></i> 清除
                        </a>
                        @if (!string.IsNullOrWhiteSpace(ViewBag.Keyword))
                        {
                            <span class="ms-3 align-self-center text-muted">
                                搜尋「@ViewBag.Keyword」找到 @Model.Count() 筆資料
                            </span>
                        }
                        <!-- 展開/收合按鈕 -->
                        <button type="button" class="btn btn-outline-primary ms-auto me-2" onclick="expandAll()">
                            <i class="fas fa-angle-double-down"></i> 全部展開
                        </button>
                        <button type="button" class="btn btn-outline-secondary" onclick="collapseAll()">
                            <i class="fas fa-angle-double-up"></i> 全部收合
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- 產品列表 Accordion -->
    @if (Model != null && Model.Any())
    {
        <div class="accordion" id="productAccordion">
            @foreach (var item in Model)
            {
                var collapseId = $"collapse{item.ProductId}";
                
                <div class="accordion-item mb-2">
                    <h2 class="accordion-header">
                        <button class="accordion-button collapsed" 
                                type="button" 
                                data-bs-toggle="collapse" 
                                data-bs-target="#@collapseId">
                            <div class="container-fluid">
                                <div class="row align-items-center w-100">
                                    <!-- 產品縮圖 -->
                                    <div class="col-1">
                                        @if (!string.IsNullOrWhiteSpace(item.PrimaryImageUrl))
                                        {
                                            <img src="@item.PrimaryImageUrl" 
                                                 alt="@item.Name" 
                                                 class="img-thumbnail"
                                                 style="width: 50px; height: 50px; object-fit: cover;">
                                        }
                                        else
                                        {
                                            <div class="bg-secondary text-white d-flex align-items-center justify-content-center" 
                                                 style="width: 50px; height: 50px; border-radius: 0.25rem;">
                                                <i class="fas fa-image"></i>
                                            </div>
                                        }
                                    </div>
                                    <!-- 產品編號 -->
                                    <div class="col-1">
                                        <strong>#@item.ProductId</strong>
                                    </div>
                                    <!-- 產品名稱 -->
                                    <div class="col-3">
                                        <i class="fas fa-box me-2"></i>
                                        <strong>@item.Name</strong>
                                    </div>
                                    <!-- 分類 -->
                                    <div class="col-2">
                                        <span class="badge bg-info">@item.CategoryName</span>
                                    </div>
                                    <!-- 價格 -->
                                    <div class="col-2">
                                        @if (item.Price.HasValue)
                                        {
                                            <span class="text-success fw-bold">NT$ @item.Price.Value.ToString("N0")</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">無價格</span>
                                        }
                                    </div>
                                    <!-- 狀態 -->
                                    <div class="col-2">
                                        @switch (item.PStatus)
                                        {
                                            case "上架中":
                                                <span class="badge bg-success">上架中</span>
                                                break;
                                            case "下架":
                                                <span class="badge bg-secondary">下架</span>
                                                break;
                                            case "缺貨":
                                                <span class="badge bg-warning text-dark">缺貨</span>
                                                break;
                                            case "刪除":
                                                <span class="badge bg-danger">刪除</span>
                                                break;
                                            default:
                                                <span class="badge bg-info">@item.PStatus</span>
                                                break;
                                        }
                                    </div>
                                    <!-- 變體數量 -->
                                    <div class="col-1 text-end">
                                        <span class="badge bg-primary">
                                            <i class="fas fa-cubes"></i> @item.Variants.Count
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </button>
                    </h2>
                    <div id="@collapseId" class="accordion-collapse collapse">
                        <div class="accordion-body">
                            <!-- 產品圖片區域 -->
                            <div class="row mb-4">
                                <div class="col-md-12">
                                    <h5 class="border-bottom pb-2">
                                        <i class="fas fa-images text-primary"></i> 產品圖片
                                    </h5>
                                </div>
                                @if (item.ImageUrls != null && item.ImageUrls.Any())
                                {
                                    <div class="col-md-12">
                                        <div class="row g-2">
                                            @foreach (var imgUrl in item.ImageUrls)
                                            {
                                                <div class="col-md-2 col-sm-3 col-4">
                                                    <div class="card">
                                                        <img src="@imgUrl" 
                                                             class="card-img-top product-image" 
                                                             alt="產品圖片"
                                                             style="height: 150px; object-fit: cover; cursor: pointer;"
                                                             onclick="showImageModal('@imgUrl', '@item.Name')">
                                                        @if (imgUrl == item.PrimaryImageUrl)
                                                        {
                                                            <div class="card-img-overlay d-flex align-items-start justify-content-end p-2">
                                                                <span class="badge bg-success">
                                                                    <i class="fas fa-star"></i> 主圖
                                                                </span>
                                                            </div>
                                                        }
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <div class="col-md-12">
                                        <div class="alert alert-warning" role="alert">
                                            <i class="fas fa-exclamation-triangle"></i> 此產品尚未上傳圖片
                                        </div>
                                    </div>
                                }
                            </div>

                            <!-- 產品基本資訊 -->
                            <div class="row mb-3">
                                <div class="col-md-12">
                                    <h5 class="border-bottom pb-2">
                                        <i class="fas fa-info-circle text-primary"></i> 產品基本資訊
                                    </h5>
                                </div>
                                <div class="col-md-6">
                                    <table class="table table-sm">
                                        <tr>
                                            <th width="120">產品編號：</th>
                                            <td>@item.ProductId</td>
                                        </tr>
                                        <tr>
                                            <th>產品名稱：</th>
                                            <td><strong>@item.Name</strong></td>
                                        </tr>
                                        <tr>
                                            <th>分類：</th>
                                            <td><span class="badge bg-info">@item.CategoryName</span></td>
                                        </tr>
                                    </table>
                                </div>
                                <div class="col-md-6">
                                    <table class="table table-sm">
                                        <tr>
                                            <th width="120">狀態：</th>
                                            <td>
                                                @switch (item.PStatus)
                                                {
                                                    case "上架中":
                                                        <span class="badge bg-success">上架中</span>
                                                        break;
                                                    case "下架":
                                                        <span class="badge bg-secondary">下架</span>
                                                        break;
                                                    case "缺貨":
                                                        <span class="badge bg-warning text-dark">缺貨</span>
                                                        break;
                                                    case "刪除":
                                                        <span class="badge bg-danger">刪除</span>
                                                        break;
                                                    default:
                                                        <span class="badge bg-info">@item.PStatus</span>
                                                        break;
                                                }
                                            </td>
                                        </tr>
                                        <tr>
                                            <th>可選顏色：</th>
                                            <td>@(string.IsNullOrWhiteSpace(item.ColorName) ? "無" : item.ColorName)</td>
                                        </tr>
                                        <tr>
                                            <th>變體數量：</th>
                                            <td><span class="badge bg-primary">@item.Variants.Count</span></td>
                                        </tr>
                                    </table>
                                </div>
                                <div class="col-md-12">
                                    <strong>產品描述：</strong>
                                    <p class="text-muted mt-2">@(string.IsNullOrWhiteSpace(item.Description) ? "無描述" : item.Description)</p>
                                </div>
                            </div>

                            <!-- 產品變體列表 -->
                            <div class="row">
                                <div class="col-md-12">
                                    <h5 class="border-bottom pb-2">
                                        <i class="fas fa-cubes text-primary"></i> 產品變體 (@item.Variants.Count)
                                    </h5>
                                </div>
                            </div>

                            @if (item.Variants != null && item.Variants.Any())
                            {
                                <div class="table-responsive">
                                    <table class="table table-sm table-bordered table-hover">
                                        <thead class="table-light">
                                            <tr>
                                                <th>變體ID</th>
                                                <th>SKU</th>
                                                <th>顏色</th>
                                                <th class="text-end">價格</th>
                                                <th class="text-end">成本</th>
                                                <th class="text-center">庫存</th>
                                                <th>尺寸</th>
                                                <th>規格 (長x寬x高)</th>
                                                <th>重量</th>
                                                <th class="text-center">狀態</th>
                                                <th class="text-center">操作</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var variant in item.Variants)
                                            {
                                                <tr>
                                                    <td>@variant.VariantId</td>
                                                    <td>
                                                        <code>@variant.SKU</code>
                                                    </td>
                                                    <td>
                                                        @if (!string.IsNullOrWhiteSpace(variant.ColorCode))
                                                        {
                                                            <span class="d-flex align-items-center">
                                                                <span class="color-box me-2" 
                                                                      style="background-color: #@variant.ColorCode;">
                                                                </span>
                                                                @variant.ColorName
                                                            </span>
                                                        }
                                                        else
                                                        {
                                                            <span>@variant.ColorName</span>
                                                        }
                                                    </td>
                                                    <td class="text-end">
                                                        @if (variant.Price.HasValue)
                                                        {
                                                            <span class="text-success fw-bold">NT$ @variant.Price.Value.ToString("N0")</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="text-muted">-</span>
                                                        }
                                                    </td>
                                                    <td class="text-end">
                                                        @if (variant.Cost.HasValue)
                                                        {
                                                            <span>NT$ @variant.Cost.Value.ToString("N0")</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="text-muted">-</span>
                                                        }
                                                    </td>
                                                    <td class="text-center">
                                                        @if (variant.Stock.HasValue)
                                                        {
                                                            if (variant.Stock.Value > 10)
                                                            {
                                                                <span class="badge bg-success">@variant.Stock</span>
                                                            }
                                                            else if (variant.Stock.Value > 0)
                                                            {
                                                                <span class="badge bg-warning text-dark">@variant.Stock</span>
                                                            }
                                                            else
                                                            {
                                                                <span class="badge bg-danger">0</span>
                                                            }
                                                        }
                                                        else
                                                        {
                                                            <span class="text-muted">-</span>
                                                        }
                                                    </td>
                                                    <td>
                                                        @(string.IsNullOrWhiteSpace(variant.SizeLabel) ? "-" : variant.SizeLabel)
                                                    </td>
                                                    <td>
                                                        @if (variant.Length.HasValue && variant.Width.HasValue && variant.Height.HasValue)
                                                        {
                                                            <span>@variant.Length x @variant.Width x @variant.Height cm</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="text-muted">-</span>
                                                        }
                                                    </td>
                                                    <td>
                                                        @if (variant.Weight.HasValue)
                                                        {
                                                            <span>@variant.Weight kg</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="text-muted">-</span>
                                                        }
                                                    </td>
                                                    <td class="text-center">
                                                        @switch (variant.PStatus)
                                                        {
                                                            case "上架中":
                                                                <span class="badge bg-success">上架中</span>
                                                                break;
                                                            case "下架":
                                                                <span class="badge bg-secondary">下架</span>
                                                                break;
                                                            case "缺貨":
                                                                <span class="badge bg-warning text-dark">缺貨</span>
                                                                break;
                                                            default:
                                                                <span class="badge bg-info">@variant.PStatus</span>
                                                                break;
                                                        }
                                                    </td>
                                                    <td class="text-center">
                                                        <a asp-action="EditVariant" 
                                                           asp-route-id="@variant.VariantId" 
                                                           class="btn btn-sm btn-primary" 
                                                           title="編輯變體">
                                                            <i class="fas fa-edit"></i>
                                                        </a>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                            else
                            {
                                <div class="alert alert-warning" role="alert">
                                    <i class="fas fa-exclamation-triangle"></i> 此產品尚未建立任何變體
                                </div>
                            }

                            <!-- 操作按鈕 -->
                            <div class="row mt-3">
                                <div class="col-md-12 text-end">
                                    <div class="btn-group" role="group">
                                        <a asp-action="Detail" asp-route-id="@item.ProductId" 
                                           class="btn btn-info">
                                            <i class="fas fa-eye"></i> 詳細資料
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@item.ProductId" 
                                           class="btn btn-primary">
                                            <i class="fas fa-edit"></i> 編輯產品
                                        </a>
                                        <a asp-action="UploadImage" asp-route-id="@item.ProductId" 
                                           class="btn btn-secondary">
                                            <i class="fas fa-images"></i> 管理圖片
                                        </a>
                                        <a asp-action="CreateVariant" asp-route-productId="@item.ProductId" 
                                           class="btn btn-success">
                                            <i class="fas fa-plus"></i> 新增變體
                                        </a>
                                        <button type="button" 
                                                class="btn btn-danger" 
                                                onclick="confirmDelete(@item.ProductId, '@item.Name')">
                                            <i class="fas fa-trash"></i> 刪除產品
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- 顯示總筆數 -->
        <div class="mt-3">
            <p class="text-muted">共 <strong>@Model.Count()</strong> 個產品</p>
        </div>
    }
    else
    {
        <div class="alert alert-info text-center" role="alert">
            <i class="fas fa-info-circle fa-2x mb-2"></i>
            <h5>目前沒有產品資料</h5>
            @if (!string.IsNullOrWhiteSpace(ViewBag.Keyword))
            {
                <p>找不到符合「@ViewBag.Keyword」的產品</p>
                <a asp-action="List" class="btn btn-primary">清除搜尋條件</a>
            }
            else
            {
                <p>請先新增產品</p>
                <a asp-action="Create" class="btn btn-success">
                    <i class="fas fa-plus"></i> 新增第一個產品
                </a>
            }
        </div>
    }
</div>

<!-- 圖片放大 Modal -->
<div class="modal fade" id="imageModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="imageModalLabel">產品圖片</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center">
                <img id="modalImage" src="" alt="產品圖片" class="img-fluid" style="max-height: 70vh;">
            </div>
        </div>
    </div>
</div>

<!-- 刪除確認表單 -->
<form id="deleteForm" asp-action="Delete" method="post" style="display: none;">
    <input type="hidden" id="deleteId" name="id" />
</form>

@section Scripts {
    <script>
        // 檢測 Bootstrap
        console.log('=== Products List 頁面 ===');
        console.log('Bootstrap 狀態:', typeof bootstrap !== 'undefined' ? '✅ 已載入' : '❌ 未載入');
        if (typeof bootstrap !== 'undefined') {
            console.log('Bootstrap 版本:', bootstrap.Tooltip.VERSION);
        }

        // 顯示圖片 Modal
        function showImageModal(imageUrl, productName) {
            document.getElementById('modalImage').src = imageUrl;
            document.getElementById('imageModalLabel').textContent = productName;
            var imageModal = new bootstrap.Modal(document.getElementById('imageModal'));
            imageModal.show();
        }

        // 刪除產品確認
        function confirmDelete(id, name) {
            if (confirm('確定要刪除產品「' + name + '」嗎？\n刪除產品會同時刪除所有變體，此操作無法復原！')) {
                document.getElementById('deleteId').value = id;
                document.getElementById('deleteForm').submit();
            }
        }

        // 自動關閉提示訊息
        setTimeout(function () {
            var alerts = document.querySelectorAll('.alert');
            alerts.forEach(function(alert) {
                if (typeof bootstrap !== 'undefined') {
                    var bsAlert = bootstrap.Alert.getOrCreateInstance(alert);
                    bsAlert.close();
                } else {
                    alert.style.display = 'none';
                }
            });
        }, 3000);

        // 展開所有 accordion
        function expandAll() {
            if (typeof bootstrap === 'undefined') {
                console.error('Bootstrap 未載入');
                alert('Bootstrap 未正確載入，請重新整理頁面');
                return;
            }
            
            var collapses = document.querySelectorAll('.accordion-collapse');
            collapses.forEach(function(collapse) {
                var bsCollapse = new bootstrap.Collapse(collapse, {
                    toggle: false
                });
                bsCollapse.show();
            });
        }

        // 收合所有 accordion
        function collapseAll() {
            if (typeof bootstrap === 'undefined') {
                console.error('Bootstrap 未載入');
                alert('Bootstrap 未正確載入，請重新整理頁面');
                return;
            }
            
            var collapses = document.querySelectorAll('.accordion-collapse');
            collapses.forEach(function(collapse) {
                var bsCollapse = bootstrap.Collapse.getInstance(collapse);
                if (bsCollapse) {
                    bsCollapse.hide();
                } else {
                    new bootstrap.Collapse(collapse, {
                        toggle: false
                    }).hide();
                }
            });
        }

        // 頁面載入完成後的初始化
                document.addEventListener('DOMContentLoaded', function() {
            console.log('頁面載入完成，Accordion 已準備就緒');

            // 為所有產品圖片加入 hover 效果
            var productImages = document.querySelectorAll('.product-image');
            productImages.forEach(function(img) {
                img.addEventListener('mouseenter', function() {
                    this.style.transform = 'scale(1.05)';
                    this.style.transition = 'transform 0.3s ease';
                });
                img.addEventListener('mouseleave', function() {
                    this.style.transform = 'scale(1)';
                });
            });
        });
    </script>
}