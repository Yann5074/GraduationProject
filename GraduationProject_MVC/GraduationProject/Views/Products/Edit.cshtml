<!-- 模板：變體資產 -->
<template id="tpl-variant-asset">
    <div class="asset-item border rounded p-2 mb-2" data-asset-index="__AIDX__">
        <input type="hidden" name="Data.Assets[__AIDX__].AssetId" value="" />
        <input type="hidden" name="Data.Assets[__AIDX__].ProductVariantId" value="__VIDX__" />
        <input type="hidden" name="Data.Assets[__AIDX__].Deleted" value="" />

        <div class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label small">上傳圖片</label>
                <input type="file" class="form-control form-control-sm file-picker" accept="image/*" data-target="__AIDX__" />
            </div>
            <div class="col-md-4">
                <label class="form-label small">Url</label>
                <input class="form-control form-control-sm asset-url" name="Data.Assets[__AIDX__].Url" />
            </div>
            <div class="col-md-2">
                <label class="form-label small">MIME</label>
                <input class="form-control form-control-sm asset-mime" name="Data.Assets[__AIDX__].MimeType" />
            </div>
            <div class="col-md-1">
                <label class="form-label small">排序</label>
                <input type="number" class="form-control form-control-sm" name="Data.Assets[__AIDX__].SortOrder" />
            </div>
            <div class="col-md-1">
                <input type="hidden" name="Data.Assets[__AIDX__].IsPrimary" value="false" />
                <div class="form-check mt-4">
                    <input class="form-check-input" type="checkbox" name="Data.Assets[__AIDX__].IsPrimary" value="true" />
                    <label class="form-check-label small">主圖</label>
                </div>
            </div>
            <div class="col-md-1">
                <button type="button" class="btn btn-sm btn-outline-danger btn-del-asset">刪</button>
            </div>
        </div>
    </div>
</template>

@section Scripts {
    <script>
        (() => {
          const UPLOAD_URL = '@Url.Action("UploadAsset", "Products")';

          let assetIdx = @assetIndex;
          let variantIdx = @variantIndex;

          const form = document.getElementById('editForm');
          const commonList = document.getElementById('common-asset-list');
          const modelList = document.getElementById('model-asset-list');
          const variantList = document.getElementById('variant-list');

          const getToken = () => document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';

          // 上傳圖片
          async function uploadFile(file) {
            if (!file) throw new Error('no file');

            const fd = new FormData();
            fd.append('file', file);

            const res = await fetch(UPLOAD_URL, {
              method: 'POST',
              headers: { 'RequestVerificationToken': getToken() },
              body: fd
            });
            if (!res.ok) {
              const txt = await res.text();
              throw new Error(`Upload failed: ${res.status} ${txt}`);
            }
            return await res.json();
          }

          // 綁定圖片檔案選擇器
          function bindFilePickers(scope) {
            (scope ?? document).querySelectorAll('.file-picker').forEach(ip => {
              ip.addEventListener('change', async (e) => {
                const inp = e.currentTarget;
                const target = inp.getAttribute('data-target');
                const file = inp.files?.[0];
                if (!file) return;

                try {
                  const j = await uploadFile(file);
                  const urlEl = document.querySelector(`input[name="Data.Assets[${target}].Url"]`);
                  const mimeEl = document.querySelector(`input[name="Data.Assets[${target}].MimeType"]`);
                  if (urlEl) urlEl.value = j.url ?? '';
                  if (mimeEl) mimeEl.value = j.mime ?? '';

                  const card = inp.closest('.asset-item');
                  const slot = card?.querySelector('.preview-slot') || card?.querySelector('.col-12:last-child');
                  if (slot && (j.mime ?? '').startsWith('image/')) {
                    slot.innerHTML = '';
                    const img = document.createElement('img');
                    img.src = j.url;
                    img.className = 'img-fluid rounded border mt-2';
                    img.style.maxHeight = '200px';
                    slot.appendChild(img);
                  }
                } catch (err) {
                  alert(err.message || err);
                } finally {
                  inp.value = '';
                }
              });
            });
          }

          // 綁定3D模型檔案選擇器
          function bindModelFilePickers(scope) {
            (scope ?? document).querySelectorAll('.model-file-picker').forEach(ip => {
              ip.addEventListener('change', async (e) => {
                const inp = e.currentTarget;
                const target = inp.getAttribute('data-target');
                const file = inp.files?.[0];
                if (!file) return;

                const card = inp.closest('.model-asset-item');
                const urlBox = card.querySelector('.asset-url');
                const mimeBox = card.querySelector('.asset-mime');
                const typeBox = card.querySelector('.model-asset-type-select');
                const urlDisplay = card.querySelector('.model-url-display');

                try {
                  inp.disabled = true;
                  const fileName = file.name.toLowerCase();
                  const uploadResult = await uploadFile(file);

                  if (fileName.endsWith('.glb')) {
                    typeBox.value = 'glb';
                  } else if (fileName.endsWith('.gltf')) {
                    typeBox.value = 'gltf';
                  }

                  if (urlBox) urlBox.value = uploadResult.url;
                  if (mimeBox) mimeBox.value = uploadResult.mime || file.type;
                  if (urlDisplay) urlDisplay.value = uploadResult.url;

                  alert('檔案上傳成功！');
                } catch (err) {
                  alert('上傳失敗：' + (err?.message ?? 'Unknown'));
                } finally {
                  inp.disabled = false;
                }
              });
            });
          }

          // 刪除按鈕：標記 Deleted
          function bindDeleteButtons(scope) {
            (scope ?? document).querySelectorAll('.btn-del-asset').forEach(btn => {
              btn.addEventListener('click', () => {
                const card = btn.closest('.asset-item');
                if (!card) return;
                const idx = card.getAttribute('data-asset-index');
                const del = card.querySelector(`input[name="Data.Assets[${idx}].Deleted"]`);
                if (del) del.value = "true";
                card.style.display = 'none';
              });
            });

            (scope ?? document).querySelectorAll('.btn-del-variant').forEach(btn => {
              btn.addEventListener('click', () => {
                const card = btn.closest('.variant-item');
                if (!card) return;
                const i = card.getAttribute('data-variant-index');
                const del = card.querySelector(`input[name="Data.Variants[${i}].Deleted"]`);
                if (del) del.value = "true";
                card.style.display = 'none';
              });
            });
          }

          // 新增通用資產
          document.getElementById('btnAddCommonAsset')?.addEventListener('click', () => {
            const tpl = document.getElementById('tpl-common-asset').innerHTML.replaceAll('__AIDX__', assetIdx);
            const wrap = document.createElement('div');
            wrap.innerHTML = tpl.trim();
            const node = wrap.firstElementChild;
            commonList.appendChild(node);
            bindFilePickers(node);
            bindDeleteButtons(node);
            assetIdx++;
          });

          // 新增3D模型資產
          document.getElementById('btnAdd3DAsset')?.addEventListener('click', () => {
            const tpl = document.getElementById('tpl-3d-asset').innerHTML.replaceAll('__AIDX__', assetIdx);
            const wrap = document.createElement('div');
            wrap.innerHTML = tpl.trim();
            const node = wrap.firstElementChild;
            modelList.appendChild(node);
            bindModelFilePickers(node);
            bindDeleteButtons(node);
            assetIdx++;
          });

          // 新增變體
          document.getElementById('btnAddVariant')?.addEventListener('click', () => {
            const tpl = document.getElementById('tpl-variant').innerHTML.replaceAll('__VIDX__', variantIdx);
            const wrap = document.createElement('div');
            wrap.innerHTML = tpl.trim();
            const node = wrap.firstElementChild;
            variantList.appendChild(node);
            bindDeleteButtons(node);
            bindAddVariantAssetButtons(node, variantIdx);
            bindFilePickers(node);
            variantIdx++;
          });

          // 綁定變體資產新增按鈕
          function bindAddVariantAssetButtons(scope, fixedVIdx=null) {
            (scope ?? document).querySelectorAll('.btn-add-asset-for-variant').forEach(btn => {
              btn.addEventListener('click', () => {
                const vIdx = fixedVIdx ?? btn.getAttribute('data-variant-index');
                const container = btn.closest('.variant-item')?.querySelector('.variant-asset-list');
                if (!container) return;
                const tpl = document.getElementById('tpl-variant-asset').innerHTML
                              .replaceAll('__AIDX__', assetIdx)
                              .replaceAll('__VIDX__', vIdx);
                const wrap = document.createElement('div');
                wrap.innerHTML = tpl.trim();
                const node = wrap.firstElementChild;
                container.appendChild(node);
                bindFilePickers(node);
                bindDeleteButtons(node);
                assetIdx++;
              });
            });
          }

          // 初始化既有元素
          bindFilePickers();
          bindModelFilePickers();
          bindDeleteButtons();
          bindAddVariantAssetButtons();

          // 表單提交前重新編號
          form?.addEventListener('submit', function(e) {
            console.log('表單提交前重新編號資產...');

            const allAssets = Array.from(document.querySelectorAll('.asset-item'))
                .filter(asset => {
                    const deletedFlag = asset.querySelector('input[name$=".Deleted"]');
                    return !deletedFlag || deletedFlag.value !== 'true';
                });

            console.log(`找到 ${allAssets.length} 個有效資產`);

            allAssets.forEach((asset, newIndex) => {
                const oldIndex = asset.getAttribute('data-asset-index');
                asset.setAttribute('data-asset-index', newIndex);

                asset.querySelectorAll('input, select, textarea').forEach(input => {
                    const name = input.getAttribute('name');
                    if (name && name.match(/Data\.Assets\[\d+\]/)) {
                        const newName = name.replace(/Data\.Assets\[\d+\]/, `Data.Assets[${newIndex}]`);
                        input.setAttribute('name', newName);

                        if (oldIndex !== newIndex.toString()) {
                            console.log(`  索引 ${oldIndex} -> ${newIndex}: ${name.split('.').pop()}`);
                        }
                    }
                });
            });

            console.log('資產重新編號完成');
          });

        })();
    </script>
}
