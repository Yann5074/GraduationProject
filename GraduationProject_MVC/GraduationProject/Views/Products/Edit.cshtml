@model GraduationProject.ViewModels.CProductEditViewModel

@{
    ViewData["Title"] = "編輯商品";
}
<h2>編輯商品</h2>

<form asp-action="Edit" asp-route-id="@Model.ProductId" method="post">
    @Html.AntiForgeryToken()

    <input type="hidden" asp-for="ProductId" />

    <div class="row g-3">
        <div class="col-md-6">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control"/>
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="CategoryId" class="form-label">分類</label>
            <select asp-for="CategoryId" class="form-select" asp-items="Model.CategoryOptions">
                <option value="">-- 未指定 --</option>
            </select>
        </div>
        <div class="col-md-3">
            <label asp-for="PStatus" class="form-label">狀態</label>
            <select asp-for="PStatus" class="form-select" asp-items="Model.PStatusOptions">
                <option value="">-- 未指定 --</option>
            </select>
        </div>
        <div class="col-12">
            <label asp-for="Description" class="form-label"></label>
            <textarea asp-for="Description" rows="4" class="form-control"></textarea>
        </div>
    </div>

    <hr />

    @await Html.PartialAsync("_VariantsEditor_Edit", Model)
    @await Html.PartialAsync("_AssetsEditor_Edit", Model)
    @await Html.PartialAsync("_PartsEditor_Edit", Model)

    <div class="mt-3">
        <button class="btn btn-primary" type="submit">儲存</button>
        <a asp-action="Index" class="btn btn-outline-secondary">返回列表</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
