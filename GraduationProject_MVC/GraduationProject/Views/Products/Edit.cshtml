            </div>

            <div class="col-md-6">
                <label class="form-label">Metadata (JSON, 可選)</label>
                <input type="text" class="form-control form-control-sm"
                       name="Data.Assets[__AIDX__].MetadateJson"
                       placeholder='{"scale": 1.0, "rotation": [0,0,0]}' />
            </div>
        </div>
    </div>
</template>

