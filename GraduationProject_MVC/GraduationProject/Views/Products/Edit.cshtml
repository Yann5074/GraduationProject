@model GraduationProject.ViewModels.CProductEditViewModel
@using System.IO
@{
    ViewData["Title"] = "編輯商品";

    var d = Model.Data ?? new GraduationProject.DTOs.CProductUpdateDTO();
    d.Variants ??= new List<GraduationProject.DTOs.CProductVariantDTO>();
    d.Assets ??= new List<GraduationProject.DTOs.CProductAssetDTO>();

    // 資產分組
    var commonAssets = d.Assets.Where(a => !a.ProductVariantId.HasValue &&
                                        a.AssetType != "glb" &&
                                        a.AssetType != "gltf" &&
                                        !((a.AssetType ?? "").StartsWith("pbr-"))).ToList();
    var variantAssets = d.Assets.Where(a => a.ProductVariantId.HasValue).ToList();
    var modelAssets = d.Assets.Where(a => a.AssetType == "glb" ||
                                        a.AssetType == "gltf" ||
                                        ((a.AssetType ?? "").StartsWith("pbr-"))).ToList();

    // 索引起點（保持既有索引，動態新增用 JS 維護）
    var assetIndex = 0;
    var variantIndex = 0;

    // 方便把 SelectListItem 轉成簡單資料
    var catOpts = (Model.CategoryOptions ?? new List<SelectListItem>())
                   .Select(x => new { v = x.Value ?? "", t = x.Text ?? "" }).ToList();
    var pstOpts = (Model.PStatusOptions ?? new List<SelectListItem>())
                   .Select(x => new { v = x.Value ?? "", t = x.Text ?? "" }).ToList();
    var clrOpts = (Model.ColorOptions ?? new List<SelectListItem>())
                   .Select(x => new { v = x.Value ?? "", t = x.Text ?? "" }).ToList();
}

<div class="container py-4">
    <div class="d-flex align-items-center justify-content-between mb-3">
        <h2 class="mb-0">編輯商品</h2>
        <div class="d-flex gap-2">
            <a asp-action="List" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i> 返回列表
            </a>
            <a asp-action="Detail" asp-route-id="@d.ProductId" class="btn btn-outline-primary">
                <i class="bi bi-eye me-1"></i> 檢視
            </a>
        </div>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }
    @if (TempData["Ok"] != null)
    {
        <div class="alert alert-success">@TempData["Ok"]</div>
    }

    <form asp-action="Edit" method="post" enctype="multipart/form-data" id="editForm">
        @Html.AntiForgeryToken()

        <input type="hidden" name="Data.ProductId" value="@d.ProductId" />

        <!-- 基本資料 -->
        <div class="card shadow-sm mb-3">
            <div class="card-header">基本資料</div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">商品名稱</label>
                        <input class="form-control" name="Data.Name" value="@(d.Name ?? "")" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">分類</label>
                        <select class="form-select" name="Data.CategoryId">
                            <option value="">— 未選擇 —</option>
                            @foreach (var c in catOpts)
                            {
                                if (d.CategoryId?.ToString() == c.v)
                                {
                                    <option value="@c.v" selected>@c.t</option>
                                }
                                else
                                {
                                    <option value="@c.v">@c.t</option>
                                }
                            }
                        </select>
                    </div>

                    <div class="col-12">
                        <label class="form-label">商品描述</label>
                        <textarea class="form-control" name="Data.Description" rows="3">@d.Description</textarea>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">商品狀態</label>
                        <select class="form-select" name="Data.PStatus">
                            <option value="">— 未選擇 —</option>
                            @foreach (var p in pstOpts)
                            {
                                if (d.PStatus?.ToString() == p.v)
                                {
                                    <option value="@p.v" selected>@p.t</option>
                                }
                                else
                                {
                                    <option value="@p.v">@p.t</option>
                                }
                            }
                        </select>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">保固(月)</label>
                        <input type="number" class="form-control" name="Data.WarrantyMonth" value="@(d.WarrantyMonth?.ToString() ?? "")" />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label d-block">是否需組裝</label>
                        <input type="hidden" name="Data.AssemblyRequired" value="false" />
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="Data.AssemblyRequired" value="true" @(d.AssemblyRequired == true ? "checked" : null) />
                            <label class="form-check-label">需要</label>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">組裝零件</label>
                        <input class="form-control" name="Data.AssemblyPart" value="@(d.AssemblyPart ?? "")" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">折扣</label>
                        <input type="number" step="0.01" class="form-control" name="Data.Discount" value="@(d.Discount?.ToString() ?? "")" />
                    </div>
                </div>
            </div>
        </div>

        <!-- 變體 -->
        <div class="card shadow-sm mb-3">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span>商品變體（顏色 / 尺寸 / 庫存 / 售價）</span>
                <button type="button" class="btn btn-sm btn-outline-primary" id="btnAddVariant">＋新增變體</button>
            </div>
            <div class="card-body">
                <div id="variant-list">
                    @for (int vIdx = 0; vIdx < d.Variants.Count; vIdx++)
                    {
                        var v = d.Variants[vIdx];
                        <div class="border rounded p-2 mb-3 variant-item" data-variant-index="@variantIndex">
                            <input type="hidden" name="Data.Variants[@variantIndex].VariantId" value="@v.VariantId" />
                            <input type="hidden" name="Data.Variants[@variantIndex].Deleted" value="" />

                            <div class="row g-2">
                                <div class="col-md-2">
                                    <label class="form-label">SKU</label>
                                    <input class="form-control" name="Data.Variants[@variantIndex].SKU" value="@(v.SKU ?? "")" />
                                </div>

                                <div class="col-md-2">
                                    <label class="form-label">顏色</label>
                                    <select class="form-select" name="Data.Variants[@variantIndex].ColorId">
                                        <option value="">無</option>
                                        @foreach (var c in clrOpts)
                                        {
                                            if (v.ColorId?.ToString() == c.v)
                                            {
                                                <option value="@c.v" selected>@c.t</option>
                                            }
                                            else
                                            {
                                                <option value="@c.v">@c.t</option>
                                            }
                                        }
                                    </select>
                                </div>

                                <div class="col-md-2">
                                    <label class="form-label">售價</label>
                                    <input class="form-control" name="Data.Variants[@variantIndex].Price" value="@(v.Price?.ToString() ?? "")" />
                                </div>

                                <div class="col-md-2">
                                    <label class="form-label">成本</label>
                                    <input class="form-control" name="Data.Variants[@variantIndex].Cost" value="@(v.Cost?.ToString() ?? "")" />
                                </div>

                                <div class="col-md-2">
                                    <label class="form-label">庫存</label>
                                    <input class="form-control" name="Data.Variants[@variantIndex].Stock" value="@(v.Stock?.ToString() ?? "")" />
                                </div>

                                <div class="col-md-2">
                                    <label class="form-label">狀態</label>
                                    <select class="form-select" name="Data.Variants[@variantIndex].PStatus">
                                        <option value="">請選擇</option>
                                        @foreach (var p in pstOpts)
                                        {
                                            if (v.PStatus?.ToString() == p.v)
                                            {
                                                <option value="@p.v" selected>@p.t</option>
                                            }
                                            else
                                            {
                                                <option value="@p.v">@p.t</option>
                                            }
                                        }
                                    </select>
                                </div>
                            </div>

                            <div class="row g-2 mt-2">
                                <div class="col-md-3">
                                    <label class="form-label">尺寸標籤</label>
                                    <input class="form-control" name="Data.Variants[@variantIndex].SizeLabel" value="@(v.SizeLabel ?? "")" />
                                </div>
                                <div class="col-md-2">
                                    <label class="form-label">長(cm)</label>
                                    <input class="form-control" name="Data.Variants[@variantIndex].Length" value="@(v.Length?.ToString() ?? "")" />
                                </div>
                                <div class="col-md-2">
                                    <label class="form-label">寬(cm)</label>
                                    <input class="form-control" name="Data.Variants[@variantIndex].Width" value="@(v.Width?.ToString() ?? "")" />
                                </div>
                                <div class="col-md-2">
                                    <label class="form-label">高(cm)</label>
                                    <input class="form-control" name="Data.Variants[@variantIndex].Height" value="@(v.Height?.ToString() ?? "")" />
                                </div>
                                <div class="col-md-2">
                                    <label class="form-label">重量(kg)</label>
                                    <input class="form-control" name="Data.Variants[@variantIndex].Weight" value="@(v.Weight?.ToString() ?? "")" />
                                </div>
                            </div>

                            <!-- 此變體的資產 -->
                            <div class="mt-3">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <small class="text-muted">此變體的專屬圖片</small>
                                    <button type="button" class="btn btn-sm btn-outline-secondary btn-add-asset-for-variant" data-variant-index="@variantIndex">＋新增圖片</button>
                                </div>
                                <div class="variant-asset-list">
                                    @{
                                        var vAssets = variantAssets.Where(va => va.ProductVariantId == v.VariantId).ToList();
                                    }
                                    @for (int k = 0; k < vAssets.Count; k++)
                                    {
                                        var va = vAssets[k];
                                        <div class="asset-item border rounded p-2 mb-2" data-asset-index="@assetIndex">
                                            <input type="hidden" name="Data.Assets[@assetIndex].AssetId" value="@va.AssetId" />
                                            <input type="hidden" name="Data.Assets[@assetIndex].ProductVariantId" value="@va.ProductVariantId" />
                                            <input type="hidden" name="Data.Assets[@assetIndex].Deleted" value="" />

                                            <div class="row g-2 align-items-end">
                                                <div class="col-md-3">
                                                    <label class="form-label small">上傳圖片</label>
                                                    <input type="file" class="form-control form-control-sm file-picker" accept="image/*" data-target="@assetIndex" />
                                                </div>
                                                <div class="col-md-4">
                                                    <label class="form-label small">Url</label>
                                                    <input class="form-control form-control-sm asset-url" name="Data.Assets[@assetIndex].Url" value="@(va.Url ?? "")" />
                                                </div>
                                                <div class="col-md-2">
                                                    <label class="form-label small">MIME</label>
                                                    <input class="form-control form-control-sm asset-mime" name="Data.Assets[@assetIndex].MimeType" value="@(va.MimeType ?? "")" />
                                                </div>
                                                <div class="col-md-1">
                                                    <label class="form-label small">排序</label>
                                                    <input type="number" class="form-control form-control-sm" name="Data.Assets[@assetIndex].SortOrder" value="@(va.SortOrder?.ToString() ?? "")" />
                                                </div>
                                                <div class="col-md-1">
                                                    <input type="hidden" name="Data.Assets[@assetIndex].IsPrimary" value="false" />
                                                    <div class="form-check mt-4">
                                                        <input class="form-check-input" type="checkbox" name="Data.Assets[@assetIndex].IsPrimary" value="true" @(va.IsPrimary == true ? "checked" : null) />
                                                        <label class="form-check-label small">主圖</label>
                                                    </div>
                                                </div>
                                                <div class="col-md-1">
                                                    <button type="button" class="btn btn-sm btn-outline-danger btn-del-asset">刪</button>
                                                </div>
                                            </div>

                                            @if (!string.IsNullOrWhiteSpace(va.Url) && (va.MimeType?.StartsWith("image/") ?? false))
                                            {
                                                <img src="@va.Url" class="img-fluid rounded border mt-2" style="max-height: 120px;" />
                                            }
                                        </div>
                                        assetIndex++;
                                    }
                                </div>
                            </div>

                            <div class="mt-2 text-end">
                                <button type="button" class="btn btn-sm btn-outline-danger btn-del-variant">刪除此變體</button>
                            </div>
                        </div>
                        variantIndex++;
                    }
                </div>
            </div>
        </div>


        <!-- 通用資產（商品層，不需 VariantId） -->
        <div class="card shadow-sm mb-3">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span>商品通用圖片（非變體專屬）</span>
                <button type="button" class="btn btn-sm btn-outline-primary" id="btnAddCommonAsset">＋新增通用圖片</button>
            </div>
            <div class="card-body">
                <div class="row g-2" id="common-asset-list">
                    @for (int i = 0; i < commonAssets.Count; i++)
                    {
                        var a = commonAssets[i];
                        <div class="col-12 asset-item border rounded p-2" data-asset-index="@assetIndex">
                            <input type="hidden" name="Data.Assets[@assetIndex].AssetId" value="@a.AssetId" />
                            <input type="hidden" name="Data.Assets[@assetIndex].Deleted" value="" />
                            <input type="hidden" name="Data.Assets[@assetIndex].ProductVariantId" value="" />
                            <input type="hidden" name="Data.Assets[@assetIndex].VariantTempIndex" value="-1" />

                            <div class="row g-2 align-items-end">
                                <div class="col-md-3">
                                    <label class="form-label">上傳圖片</label>
                                    <input type="file" class="form-control file-picker" accept="image/*" data-target="@assetIndex" />
                                </div>
                                <div class="col-md-5">
                                    <label class="form-label">資產網址 (Url)</label>
                                    <input class="form-control asset-url" name="Data.Assets[@assetIndex].Url" value="@(a.Url ?? "")" />
                                    <div class="form-text">上傳後自動填入；也可貼外部檔案 URL。</div>
                                </div>
                                <div class="col-md-2">
                                    <label class="form-label">MIME</label>
                                    <input class="form-control asset-mime" name="Data.Assets[@assetIndex].MimeType" value="@(a.MimeType ?? "")" />
                                </div>
                                <div class="col-md-2">
                                    <label class="form-label">排序</label>
                                    <input type="number" class="form-control" name="Data.Assets[@assetIndex].SortOrder" value="@(a.SortOrder?.ToString() ?? "")" />
                                </div>

                                <div class="col-md-3">
                                    <label class="form-label">類型</label>
                                    <input class="form-control" name="Data.Assets[@assetIndex].AssetType" value="@(a.AssetType ?? "image")" readonly />
                                </div>
                                <div class="col-md-2">
                                    <input type="hidden" name="Data.Assets[@assetIndex].IsPrimary" value="false" />
                                    <div class="form-check mt-4">
                                        <input class="form-check-input" type="checkbox" name="Data.Assets[@assetIndex].IsPrimary" value="true" @(a.IsPrimary == true ? "checked" : null) />
                                        <label class="form-check-label">主圖</label>
                                    </div>
                                </div>
                                <div class="col-md-2">
                                    <button type="button" class="btn btn-outline-danger mt-4 btn-del-asset">刪除</button>
                                </div>

                                <div class="col-12">
                                    @if (!string.IsNullOrWhiteSpace(a.Url) && (a.MimeType?.StartsWith("image/") ?? false))
                                    {
                                        <img src="@a.Url" class="img-fluid rounded border mt-2" style="max-height: 200px;" />
                                    }
                                </div>
                            </div>
                        </div>
                        assetIndex++;
                    }
                </div>
            </div>
        </div>

        <!-- ===== 新增：3D模型資產區域 ===== -->
        <div class="card shadow-sm mb-3 border-primary">
            <div class="card-header bg-primary bg-opacity-10 d-flex justify-content-between align-items-center">
                <span><i class="bi bi-box-seam me-2"></i>3D模型資產</span>
                <button type="button" class="btn btn-sm btn-primary" id="btnAdd3DAsset">＋新增3D模型</button>
            </div>
            <div class="card-body">
                <div class="alert alert-info small mb-3">
                    <i class="bi bi-info-circle me-1"></i>
                    支援 GLB/GLTF 格式的3D模型檔案，以及 PBR 材質貼圖（basecolor、normal、metallic、roughness等）
                </div>
                <div id="model-asset-list">
                    @for (int i = 0; i < modelAssets.Count; i++)
                    {
                        var a = modelAssets[i];
                        <div class="asset-item model-asset-item border rounded p-3 mb-3" data-asset-index="@assetIndex">
                            <input type="hidden" name="Data.Assets[@assetIndex].AssetId" value="@a.AssetId" />
                            <input type="hidden" name="Data.Assets[@assetIndex].Deleted" value="" />
                            <input type="hidden" name="Data.Assets[@assetIndex].ProductVariantId" value="" />
                            <input type="hidden" class="asset-url" name="Data.Assets[@assetIndex].Url" value="@(a.Url ?? "")" />
                            <input type="hidden" class="asset-mime" name="Data.Assets[@assetIndex].MimeType" value="@(a.MimeType ?? "")" />

                            <div class="row g-3">
                                <div class="col-md-12">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <strong class="text-primary">3D模型 #@(i + 1)</strong>
                                        <button type="button" class="btn btn-sm btn-outline-danger btn-del-asset">刪除此模型</button>
                                    </div>
                                </div>

                                <div class="col-md-4">
                                    <label class="form-label">資產類型</label>
                                    <select class="form-select model-asset-type-select" name="Data.Assets[@assetIndex].AssetType">
                                        <option value="glb" selected="@(a.AssetType == "glb")">GLB模型</option>
                                        <option value="gltf" selected="@(a.AssetType == "gltf")">GLTF模型</option>
                                        <option value="pbr-basecolor" selected="@(a.AssetType == "pbr-basecolor")">PBR - BaseColor (基礎顏色)</option>
                                        <option value="pbr-normal" selected="@(a.AssetType == "pbr-normal")">PBR - Normal (法線貼圖)</option>
                                        <option value="pbr-metallic" selected="@(a.AssetType == "pbr-metallic")">PBR - Metallic (金屬度)</option>
                                        <option value="pbr-roughness" selected="@(a.AssetType == "pbr-roughness")">PBR - Roughness (粗糙度)</option>
                                        <option value="pbr-ao" selected="@(a.AssetType == "pbr-ao")">PBR - AO (環境光遮蔽)</option>
                                        <option value="pbr-emissive" selected="@(a.AssetType == "pbr-emissive")">PBR - Emissive (自發光)</option>
                                    </select>
                                </div>

                                <div class="col-md-4">
                                    <label class="form-label">上傳檔案</label>
                                    <input type="file" class="form-control model-file-picker"
                                           accept=".glb,.gltf,image/*"
                                           data-target="@assetIndex" />
                                    <small class="text-muted">支援 .glb, .gltf 或圖片檔案</small>
                                </div>

                                <div class="col-md-4">
                                    <label class="form-label">檔案URL</label>
                                    <input type="text" class="form-control form-control-sm model-url-display"
                                           value="@(a.Url ?? "")" readonly />
                                </div>

                                <div class="col-md-4">
                                    <label class="form-label">縮圖URL (可選)</label>
                                    <input type="text" class="form-control form-control-sm"
                                           name="Data.Assets[@assetIndex].PosterUrl"
                                           value="@(a.PosterUrl ?? "")"
                                           placeholder="3D模型的預覽圖" />
                                </div>

                                <div class="col-md-2">
                                    <label class="form-label">排序</label>
                                    <input type="number" class="form-control form-control-sm"
                                           name="Data.Assets[@assetIndex].SortOrder"
                                           value="@(a.SortOrder?.ToString() ?? "")" />
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label">Metadata (JSON, 可選)</label>
                                    <input type="text" class="form-control form-control-sm"
                                           name="Data.Assets[@assetIndex].MetadateJson"
                                           value="@(a.MetadateJson ?? "")"
                                           placeholder='{"scale": 1.0, "rotation": [0,0,0]}' />
                                </div>
                            </div>

                            @if (!string.IsNullOrEmpty(a.Url))
                            {
                                var fileName = a.Url.Contains("/") ? a.Url.Substring(a.Url.LastIndexOf("/") + 1) : a.Url;
                                <div class="mt-2 p-2 bg-light rounded">
                                    <small class="text-success">
                                        <i class="bi bi-check-circle me-1"></i>
                                        已上傳: @fileName
                                    </small>
                                </div>
                            }
                        </div>
                        assetIndex++;
                    }
                </div>
            </div>
        </div>



        <div class="d-flex gap-2 justify-content-end mb-4">
            <a asp-action="List" class="btn btn-secondary">取消</a>
            <button type="submit" class="btn btn-primary">
                <i class="bi bi-save me-1"></i> 儲存變更
            </button>
        </div>
    </form>
</div>

<!-- 模板：通用資產 -->
<template id="tpl-common-asset">
    <div class="col-12 asset-item border rounded p-2" data-asset-index="__AIDX__">
        <input type="hidden" name="Data.Assets[__AIDX__].AssetId" value="" />
        <input type="hidden" name="Data.Assets[__AIDX__].Deleted" value="" />
        <input type="hidden" name="Data.Assets[__AIDX__].ProductVariantId" value="" />
        <input type="hidden" name="Data.Assets[__AIDX__].VariantTempIndex" value="-1" />

        <div class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label">上傳圖片</label>
                <input type="file" class="form-control file-picker" accept="image/*" data-target="__AIDX__" />
            </div>
            <div class="col-md-5">
                <label class="form-label">資產網址</label>
                <input class="form-control asset-url" name="Data.Assets[__AIDX__].Url" />
            </div>
            <div class="col-md-2">
                <label class="form-label">MIME</label>
                <input class="form-control asset-mime" name="Data.Assets[__AIDX__].MimeType" />
            </div>
            <div class="col-md-2">
                <label class="form-label">排序</label>
                <input type="number" class="form-control" name="Data.Assets[__AIDX__].SortOrder" />
            </div>
            <div class="col-md-3">
                <label class="form-label">類型</label>
                <input class="form-control" name="Data.Assets[__AIDX__].AssetType" value="image" readonly />
            </div>
            <div class="col-md-2">
                <input type="hidden" name="Data.Assets[__AIDX__].IsPrimary" value="false" />
                <div class="form-check mt-4">
                    <input class="form-check-input" type="checkbox" name="Data.Assets[__AIDX__].IsPrimary" value="true" />
                    <label class="form-check-label">主圖</label>
                </div>
            </div>
            <div class="col-md-2">
                <button type="button" class="btn btn-outline-danger mt-4 btn-del-asset">刪除</button>
            </div>
        </div>
    </div>
</template>

<!-- 模板：3D模型資產 -->
