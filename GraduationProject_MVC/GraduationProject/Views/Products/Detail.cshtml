@model GraduationProject.DTOs.CProductDetailDTO
@{
    ViewData["Title"] = "商品明細";

    // 主圖：優先主圖，其次 ImageUrls[0]，最後 default.png
    string primaryImg = "/ProductImages/default.png";
    if (!string.IsNullOrWhiteSpace(Model?.PrimaryImageUrl))
    {
        primaryImg = Model.PrimaryImageUrl!;
    }
    else if (Model?.ImageUrls != null && Model.ImageUrls.Any() && !string.IsNullOrWhiteSpace(Model.ImageUrls.First()))
    {
        primaryImg = Model.ImageUrls.First()!;
    }

    string statusName = Model?.FPStatusName ?? "未知";
}

<div class="container py-4">
    <div class="d-flex align-items-center justify-content-between mb-3">
        <h2 class="mb-0">商品明細</h2>
        <div class="d-flex gap-2">
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i> 返回列表
            </a>
            @if (Model?.ProductId != null)
            {
                <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.ProductId">
                    <i class="bi bi-pencil-square me-1"></i> 編輯
                </a>
            }
        </div>
    </div>

    @if (TempData["Ok"] != null)
    {
        <div class="alert alert-success">@TempData["Ok"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="row g-3">
        <!-- 左側主內容 -->
        <div class="col-lg-8">
            <!-- 主圖 + 基本資訊 -->
            <div class="card shadow-sm mb-3">
                <div class="row g-0">
                    <div class="col-md-5 p-3 d-flex align-items-center justify-content-center">
                        <img src="@primaryImg" class="img-fluid rounded" alt="主圖" style="max-height:340px; object-fit:contain;" />
                    </div>
                    <div class="col-md-7">
                        <div class="card-body">
                            <h4 class="card-title mb-1">@((Model?.Name) ?? "—")</h4>

                            <div class="mb-2">
                                @switch (statusName)
                                {
                                    case "上架":
                                    case "上架中":
                                        @:<span class="badge bg-success">上架</span>
                                        break;
                                    case "下架":
                                        @:<span class="badge bg-secondary">下架</span>
                                        break;
                                    case "缺貨":
                                        @:<span class="badge bg-warning text-dark">缺貨</span>
                                        break;
                                    case "刪除":
                                        @:<span class="badge bg-danger">刪除</span>
                                        break;
                                    default:
                                        @:<span class="badge bg-info">@statusName</span>
                                        break;
                                }
                            </div>

                            <div class="mb-2 text-muted">
                                分類：<strong>@(Model?.CategoryName ?? "—")</strong>
                            </div>

                            <div class="row g-2">
                                <div class="col-6">
                                    <small class="text-muted d-block">保固（月）</small>
                                    <span>@(Model?.WarrantyMonth?.ToString() ?? "—")</span>
                                </div>
                                <div class="col-6">
                                    <small class="text-muted d-block">需組裝</small>
                                    <span>
                                        @if (Model?.AssemblyRequired == true) { @:是 }
                                        else if (Model?.AssemblyRequired == false) { @:否 }
                                        else { @:— }
                                    </span>
                                </div>
                                <div class="col-6">
                                    <small class="text-muted d-block">折扣</small>
                                    <span>@(Model?.Discount?.ToString() ?? "—")</span>
                                </div>
                                <div class="col-6">
                                    <small class="text-muted d-block">組裝零件</small>
                                    <span>@(Model?.AssemblyPart ?? "—")</span>
                                </div>
                            </div>

                            <div class="mt-3">
                                <small class="text-muted d-block mb-1">描述</small>
                                <div class="border rounded p-2" style="min-height: 72px;">
                                    @if (!string.IsNullOrWhiteSpace(Model?.Description))
                                    { @Model.Description }
                                    else
                                    { <span class="text-muted">（無描述）</span> }
                                </div>
                            </div>

                            <div class="mt-3">
                                <small class="text-muted">建立：@(Model?.CreatedAt?.ToString("yyyy/MM/dd HH:mm") ?? "—")</small>
                                <span class="mx-2">•</span>
                                <small class="text-muted">更新：@(Model?.UpdatedAt?.ToString("yyyy/MM/dd HH:mm") ?? "—")</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 媒體資產 -->
            <div class="card shadow-sm mb-3">
                <div class="card-header d-flex align-items-center justify-content-between">
                    <span>媒體資產</span>
                    <small class="text-muted">僅預覽圖片；其他類型顯示連結</small>
                </div>
                <div class="card-body">
                    @if (Model?.Assets != null && Model.Assets.Any())
                    {
                        @{
                            var imgs = Model.Assets
                                .Where(a => !string.IsNullOrWhiteSpace(a?.MimeType) && a!.MimeType!.StartsWith("image/"))
                                .OrderBy(a => a?.SortOrder ?? int.MaxValue)
                                .ToList();

                            var others = Model.Assets
                                .Where(a => string.IsNullOrWhiteSpace(a?.MimeType) || !(a!.MimeType!.StartsWith("image/")))
                                .OrderBy(a => a?.SortOrder ?? int.MaxValue)
                                .ToList();
                        }

                        @if (imgs.Any())
                        {
                            <div class="mb-3">
                                <h6 class="mb-2">圖片</h6>
                                <div class="d-flex flex-wrap gap-2">
                                    @foreach (var a in imgs)
                                    {
                                        var src = !string.IsNullOrWhiteSpace(a?.Url) ? a!.Url : "/ProductImages/default.png";
                                        <div class="border rounded p-1">
                                            <img src="@src" class="rounded" style="height:100px; width:auto;" alt="image" />
                                            @if (a?.IsPrimary == true)
                                            {
                                                <div class="text-center mt-1">
                                                    <span class="badge bg-primary">主圖</span>
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                            </div>
                        }

                        @if (others.Any())
                        {
                            <div>
                                <h6 class="mb-2">其他</h6>
                                <div class="table-responsive">
                                    <table class="table table-sm table-bordered align-middle">
                                        <thead class="table-light">
                                            <tr>
                                                <th style="width:80px;">排序</th>
                                                <th>類型</th>
                                                <th>MIME</th>
                                                <th>URL</th>
                                                <th>Poster</th>
                                                <th style="width:70px;">主圖</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                        @foreach (var a in others)
                                        {
                                            <tr>
                                                <td>@(a?.SortOrder?.ToString() ?? "—")</td>
                                                <td>@(a?.AssetType ?? "—")</td>
                                                <td>@(a?.MimeType ?? "—")</td>
                                                <td>
                                                    @if (!string.IsNullOrWhiteSpace(a?.Url))
                                                    {
                                                        <a href="@a!.Url" target="_blank" rel="noopener">開啟</a>
                                                    }
                                                    else { @:— }
                                                </td>
                                                <td>
                                                    @if (!string.IsNullOrWhiteSpace(a?.PosterUrl))
                                                    {
                                                        <a href="@a!.PosterUrl" target="_blank" rel="noopener">Poster</a>
                                                    }
                                                    else { @:— }
                                                </td>
                                                <td>
                                                    @if (a?.IsPrimary == true) { <span class="badge bg-primary">是</span> } else { @:— }
                                                </td>
                                            </tr>
                                        }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-muted">沒有任何資產</div>
                    }
                </div>
            </div>

            <!-- 變體明細 -->
            <div class="card shadow-sm">
                <div class="card-header d-flex align-items-center justify-content-between">
                    <span>產品變體</span>
                    <small class="text-muted">共 @(Model?.Variants?.Count ?? 0) 項</small>
                </div>
                <div class="card-body">
                    @if (Model?.Variants != null && Model.Variants.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-sm table-bordered align-middle">
                                <thead class="table-secondary">
                                    <tr>
                                        <th style="width:140px;">SKU</th>
                                        <th style="width:160px;">顏色</th>
                                        <th style="width:100px;" class="text-end">售價</th>
                                        <th style="width:100px;" class="text-end">成本</th>
                                        <th style="width:90px;" class="text-end">庫存</th>
                                        <th style="width:110px;">尺寸</th>
                                        <th style="width:160px;">長 × 寬 × 高</th>
                                        <th style="width:90px;" class="text-end">重量</th>
                                        <th style="width:110px;">狀態</th>
                                    </tr>
                                </thead>
                                <tbody>
                                @foreach (var v in Model.Variants)
                                {
                                    var vStatus = v?.PStatusName ?? "未知";
                                    var hasDims = (v?.Length ?? 0) != 0 || (v?.Width ?? 0) != 0 || (v?.Height ?? 0) != 0;
                                    <tr>
                                        <td class="text-monospace">@((v?.SKU) ?? "—")</td>
                                        <td>
                                            @if (!string.IsNullOrWhiteSpace(v?.ColorName))
                                            {
                                                @v!.ColorName
                                                @if (!string.IsNullOrWhiteSpace(v?.ColorCode))
                                                {
                                                    <span class="ms-1 align-middle d-inline-block rounded" style="width:14px;height:14px;vertical-align:middle;border:1px solid #ddd; background:@v!.ColorCode;"></span>
                                                }
                                            }
                                            else { @:— }
                                        </td>
                                        <td class="text-end">@((v?.Price ?? 0).ToString("N0"))</td>
                                        <td class="text-end">@((v?.Cost  ?? 0).ToString("N0"))</td>
                                        <td class="text-end">@((v?.Stock ?? 0).ToString("N0"))</td>
                                        <td>@(v?.SizeLabel ?? "—")</td>
                                        <td>
                                            @if (hasDims)
                                            {
                                                @($"{v!.Length ?? 0} × {v!.Width ?? 0} × {v!.Height ?? 0}")
                                            }
                                            else { @:— }
                                        </td>
                                        <td class="text-end">
                                            @if (v?.Weight.HasValue == true) { @v!.Weight.Value.ToString("N2") } else { @:— }
                                        </td>
                                        <td>
                                            @switch (vStatus)
                                            {
                                                case "上架":
                                                case "上架中":
                                                    @:<span class="badge bg-success">上架</span>
                                                    break;
                                                case "下架":
                                                    @:<span class="badge bg-secondary">下架</span>
                                                    break;
                                                case "缺貨":
                                                    @:<span class="badge bg-warning text-dark">缺貨</span>
                                                    break;
                                                case "刪除":
                                                    @:<span class="badge bg-danger">刪除</span>
                                                    break;
                                                default:
                                                    @:<span class="badge bg-info">@vStatus</span>
                                                    break;
                                            }
                                        </td>
                                    </tr>
                                }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-muted">沒有變體資料</div>
                    }
                </div>
            </div>
        </div>

        <!-- 右側動作與摘要 -->
        <div class="col-lg-4">
            <div class="card shadow-sm">
                <div class="card-header">動作</div>
                <div class="card-body d-grid gap-2">
                    @if (Model?.ProductId != null)
                    {
                        <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.ProductId">
                            <i class="bi bi-pencil-square me-1"></i> 編輯
                        </a>
                        <form asp-action="Delete" asp-route-id="@Model.ProductId" method="post" onsubmit="return confirm('確定要刪除嗎？');">
                            @Html.AntiForgeryToken()
                            <button class="btn btn-outline-danger" type="submit">
                                <i class="bi bi-trash me-1"></i> 刪除
                            </button>
                        </form>
                    }
                    <a class="btn btn-outline-secondary" asp-action="Index">返回列表</a>
                </div>
            </div>

            <div class="card shadow-sm mt-3">
                <div class="card-header">快速摘要</div>
                <div class="card-body">
                    <div class="mb-2">
                        <small class="text-muted d-block">商品名稱</small>
                        <div>@(Model?.Name ?? "—")</div>
                    </div>
                    <div class="mb-2">
                        <small class="text-muted d-block">分類</small>
                        <div>@(Model?.CategoryName ?? "—")</div>
                    </div>
                    <div class="mb-2">
                        <small class="text-muted d-block">狀態</small>
                        <div>
                            @switch (statusName)
                            {
                                case "上架":
                                case "上架中":
                                    @:<span class="badge bg-success">上架</span>
                                    break;
                                case "下架":
                                    @:<span class="badge bg-secondary">下架</span>
                                    break;
                                case "缺貨":
                                    @:<span class="badge bg-warning text-dark">缺貨</span>
                                    break;
                                case "刪除":
                                    @:<span class="badge bg-danger">刪除</span>
                                    break;
                                default:
                                    @:<span class="badge bg-info">@statusName</span>
                                    break;
                            }
                        </div>
                    </div>
                    <div class="mb-2">
                        <small class="text-muted d-block">變體數</small>
                        <div>@(Model?.Variants?.Count ?? 0)</div>
                    </div>
                    <div class="mb-2">
                        <small class="text-muted d-block">圖片數</small>
                        @{
                            var imgCount = 0;
                            if (Model?.Assets != null)
                            {
                                imgCount = Model.Assets.Count(a => !string.IsNullOrWhiteSpace(a?.MimeType) && a!.MimeType!.StartsWith("image/"));
                            }
                        }
                        <div>@imgCount</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts{
    <script>
        // 此頁無互動腳本，保留擴充空間（例如燈箱或 3D viewer）
    </script>
}
