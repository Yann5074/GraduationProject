@model GraduationProject.DTOs.CProductDetailDTO



@{
    ViewData["Title"] = "Product Detail";

    // ---- 防呆/快捷變數 ----
    bool hasModel  = Model != null;
    bool hasImages = hasModel && Model.Images != null && Model.Images.Any();

    string nameText      = hasModel && !string.IsNullOrWhiteSpace(Model.Name) ? Model.Name : "-";
    string categoryText  = hasModel && !string.IsNullOrWhiteSpace(Model.CategoryName) ? Model.CategoryName : "-";
    string statusText    = hasModel && !string.IsNullOrWhiteSpace(Model.PStatusName) ? Model.PStatusName : "-";
    bool   hasColors     = hasModel && Model.Colors != null && Model.Colors.Any();

    // ---- 價格/成本 顯示字串 ----
    string priceText = "-";
    string costText  = "-";
    if (hasModel)
    {
        if (Model.PriceMin.HasValue && Model.PriceMax.HasValue)
            priceText = (Model.PriceMin.Value != Model.PriceMax.Value)
                ? $"NT$ {Model.PriceMin.Value:N0} – {Model.PriceMax.Value:N0}"
                : $"NT$ {Model.PriceMin.Value:N0}";
        else if (Model.PriceMin.HasValue)
            priceText = $"NT$ {Model.PriceMin.Value:N0}";

        if (Model.CostMin.HasValue && Model.CostMax.HasValue)
            costText = (Model.CostMin.Value != Model.CostMax.Value)
                ? $"NT$ {Model.CostMin.Value:N0} – {Model.CostMax.Value:N0}"
                : $"NT$ {Model.CostMin.Value:N0}";
        else if (Model.CostMin.HasValue)
            costText = $"NT$ {Model.CostMin.Value:N0}";
    }

    // ---- 尺寸/重量（cm / kg）----
    string lenText = "-";
    if (hasModel && Model.LengthMin.HasValue)
        lenText = (Model.LengthMax.HasValue && Model.LengthMax.Value != Model.LengthMin.Value)
            ? $"{Model.LengthMin:0.##}–{Model.LengthMax:0.##} cm"
            : $"{Model.LengthMin:0.##} cm";

    string widText = "-";
    if (hasModel && Model.WidthMin.HasValue)
        widText = (Model.WidthMax.HasValue && Model.WidthMax.Value != Model.WidthMin.Value)
            ? $"{Model.WidthMin:0.##}–{Model.WidthMax:0.##} cm"
            : $"{Model.WidthMin:0.##} cm";

    string heiText = "-";
    if (hasModel && Model.HeightMin.HasValue)
        heiText = (Model.HeightMax.HasValue && Model.HeightMax.Value != Model.HeightMin.Value)
            ? $"{Model.HeightMin:0.##}–{Model.HeightMax:0.##} cm"
            : $"{Model.HeightMin:0.##} cm";

    string wtText = "-";
    if (hasModel && Model.WeightMin.HasValue)
        wtText = (Model.WeightMax.HasValue && Model.WeightMax.Value != Model.WeightMin.Value)
            ? $"{Model.WeightMin:0.##}–{Model.WeightMax:0.##} kg"
            : $"{Model.WeightMin:0.##} kg";

    // ---- 組裝需求 ----
    string assemblyText = "-";
    if (hasModel && Model.AssemblyRequired.HasValue)
        assemblyText = Model.AssemblyRequired.Value ? "需要" : "不需要";

    // ---- 其他 ----
    string descriptionText = hasModel && !string.IsNullOrWhiteSpace(Model.Description) ? Model.Description : "-";
}

<div class="container my-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0">@nameText</h2>
        <div>
            <a asp-controller="Products" asp-action="List" class="btn btn-outline-secondary">
                ← 返回清單
            </a>
        </div>
    </div>

    <div class="row g-4">
        <!-- 左：圖片區 -->
        <div class="col-12 col-lg-6">
            @if (hasImages)
            {
                var carouselId = "productImagesCarousel";
                <div id="@carouselId" class="carousel slide" data-bs-ride="carousel">
                    <div class="carousel-indicators">
                        @for (int i = 0; i < Model.Images.Count; i++)
                        {
                            <button type="button"
                                    data-bs-target="#@carouselId"
                                    data-bs-slide-to="@i"
                                    class="@(i == 0 ? "active" : "")"
                                    aria-current="@(i == 0 ? "true" : "false")"
                                    aria-label="Slide @(i + 1)"></button>
                        }
                    </div>
                    <div class="carousel-inner rounded shadow-sm">
                        @for (int i = 0; i < Model.Images.Count; i++)
                        {
                            var img    = Model.Images[i];
                            var active = (i == 0) ? "active" : "";
                            var src    = !string.IsNullOrWhiteSpace(img?.DisplayUrl) ? img.DisplayUrl : "/ProductImages/no-image.png";

                            <div class="carousel-item @active">
                                <img class="d-block w-100"
                                     alt="Product Image @(i+1)"
                                     src="@src"
                                     style="object-fit:cover; aspect-ratio: 4/3;" />
                                @if (img != null && img.IsPrimary == true)
                                {
                                    <span class="position-absolute top-0 start-0 m-2 badge bg-primary">主圖</span>
                                }
                            </div>
                        }
                    </div>
                    <button class="carousel-control-prev" type="button" data-bs-target="#@carouselId" data-bs-slide="prev">
                        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                        <span class="visually-hidden">Previous</span>
                    </button>
                    <button class="carousel-control-next" type="button" data-bs-target="#@carouselId" data-bs-slide="next">
                        <span class="carousel-control-next-icon" aria-hidden="true"></span>
                        <span class="visually-hidden">Next</span>
                    </button>
                </div>
            }
            else
            {
                <div class="border rounded d-flex align-items-center justify-content-center" style="aspect-ratio: 4/3;">
                    <img src="/ProductImages/no-image.png" alt="No Image" style="object-fit:contain; max-width:60%; max-height:60%;" />
                </div>
            }
        </div>

        <!-- 右：基本資訊 -->
        <div class="col-12 col-lg-6">
            <div class="card shadow-sm">
                <div class="card-body">
                    <div class="mb-2">
                        <span class="me-2 text-muted">分類：</span>
                        <span class="fw-semibold">@categoryText</span>
                    </div>

                    <div class="mb-2">
                        <span class="me-2 text-muted">狀態：</span>
                        <span class="badge bg-info text-dark">@statusText</span>
                    </div>

                    <div class="mb-2">
                        <span class="me-2 text-muted">價格區間：</span>
                        <span class="fw-bold fs-5">@priceText</span>
                    </div>

                    <div class="mb-2">
                        <span class="me-2 text-muted">成本區間：</span>
                        <span>@costText</span>
                    </div>

                    <div class="mb-2">
                        <span class="me-2 text-muted">顏色：</span>
                        @if (hasColors)
                        {
                            foreach (var c in Model.Colors)
                            {
                                <span class="badge rounded-pill bg-light text-dark border me-1 mb-1">@c</span>
                            }
                        }
                        else
                        {
                            <span>-</span>
                        }
                    </div>

                    <hr />

                    <div class="mb-2">
                        <div class="text-muted mb-1">商品描述：</div>
                        <div style="white-space: pre-line;">@descriptionText</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- 產品規格 -->
        <div class="col-12">
            <div class="card mt-2">
                <div class="card-header fw-semibold">產品規格</div>
                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-sm-3 col-lg-2">長 × 寬 × 高</dt>
                        <dd class="col-sm-9 col-lg-10">@lenText × @widText × @heiText</dd>

                        <dt class="col-sm-3 col-lg-2">重量</dt>
                        <dd class="col-sm-9 col-lg-10">@wtText</dd>

                        <dt class="col-sm-3 col-lg-2">保固（月）</dt>
                        <dd class="col-sm-9 col-lg-10">@((hasModel && Model.WarrantyMonth.HasValue) ? Model.WarrantyMonth.ToString() : "-")</dd>

                        <dt class="col-sm-3 col-lg-2">是否需組裝</dt>
                        <dd class="col-sm-9 col-lg-10">@assemblyText</dd>

                        <dt class="col-sm-3 col-lg-2">組裝部件</dt>
                        <dd class="col-sm-9 col-lg-10">@((hasModel && !string.IsNullOrWhiteSpace(Model.AssemblyPart)) ? Model.AssemblyPart : "-")</dd>

                        <dt class="col-sm-3 col-lg-2">庫存（總計）</dt>
                        <dd class="col-sm-9 col-lg-10">@((hasModel && Model.StockTotal.HasValue) ? Model.StockTotal.Value.ToString("N0") : "-")</dd>
                    </dl>
                </div>
            </div>
        </div>

        <!-- 圖庫縮圖（可選） -->
        @if (hasImages && Model.Images.Count > 1)
        {
            <div class="col-12">
                <div class="card mt-2">
                    <div class="card-header fw-semibold">圖庫</div>
                    <div class="card-body">
                        <div class="d-flex flex-wrap gap-2">
                            @for (int i = 0; i < Model.Images.Count; i++)
                            {
                                var img = Model.Images[i];
                                var thumbSrc = !string.IsNullOrWhiteSpace(img?.DisplayUrl) ? img.DisplayUrl : "/ProductImages/no-image.png";

                                <img src="@thumbSrc"
                                     alt="thumb @(i+1)"
                                     class="rounded border"
                                     style="width:120px; height:90px; object-fit:cover;" />
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <!-- 確保 _Layout 有引用 bootstrap.bundle.min.js；否則輪播控制不會作用 -->
}




