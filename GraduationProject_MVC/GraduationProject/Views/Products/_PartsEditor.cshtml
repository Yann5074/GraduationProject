
<div class="card my-3">
    <div class="card-header d-flex justify-content-between align-items-center">
        <strong>零件／配件</strong>
        <button type="button" class="btn btn-sm btn-outline-primary" onclick="addPart()">＋新增零件</button>
    </div>
    <div class="card-body" id="part-rows"></div>
    <input type="hidden" name="PartsJson" id="PartsJson" />
</div>

<script>
    const parts = [];
    function addPart(){ parts.push({ partName:"", partCode:"", displayOrder: parts.length+1, options:[] }); renderParts(); }
    function removePart(pi){ parts.splice(pi,1); renderParts(); }

    function addOption(pi){ parts[pi].options.push({ optionName:"", colorHex:"#FFFFFF", priceAdjustment:0, isDefault:false, displayOrder: (parts[pi].options.length+1), textures:[] }); renderParts(); }
    function removeOption(pi,oi){ parts[pi].options.splice(oi,1); renderParts(); }

    function addTexture(pi,oi){ parts[pi].options[oi].textures.push({ textureType:"BaseColor", filePath:"", tiling:"" }); renderParts(); }
    function removeTexture(pi,oi,ti){ parts[pi].options[oi].textures.splice(ti,1); renderParts(); }

    function renderParts(){
      const el = document.getElementById('part-rows');
      el.innerHTML = parts.map((p,pi)=>`
        <div class="border rounded p-2 mb-3">
          <div class="d-flex gap-2">
            <input class="form-control" placeholder="零件名稱" value="${p.partName||''}" oninput="parts[${pi}].partName=this.value" />
            <input class="form-control" placeholder="代碼" value="${p.partCode||''}" oninput="parts[${pi}].partCode=this.value" />
            <input class="form-control" type="number" placeholder="排序" value="${p.displayOrder??''}" oninput="parts[${pi}].displayOrder=parseInt(this.value)||null" />
            <button type="button" class="btn btn-sm btn-outline-success" onclick="addOption(${pi})">＋選項</button>
            <button type="button" class="btn btn-sm btn-outline-danger ms-auto" onclick="removePart(${pi})">刪零件</button>
          </div>
          <div class="mt-2">
            ${p.options.map((o,oi)=>`
              <div class="border p-2 mb-2">
                <div class="row g-2 align-items-end">
                  <div class="col-md-3"><input class="form-control" placeholder="選項名稱" value="${o.optionName||''}" oninput="parts[${pi}].options[${oi}].optionName=this.value" /></div>
                  <div class="col-md-2"><input class="form-control" placeholder="#HEX" value="${o.colorHex||''}" oninput="parts[${pi}].options[${oi}].colorHex=this.value" /></div>
                  <div class="col-md-2"><input class="form-control" type="number" step="0.01" placeholder="價差" value="${o.priceAdjustment??''}" oninput="parts[${pi}].options[${oi}].priceAdjustment=parseFloat(this.value)||null" /></div>
                  <div class="col-md-2 form-check">
                    <input class="form-check-input" type="checkbox" ${o.isDefault?'checked':''} onchange="parts[${pi}].options[${oi}].isDefault=this.checked"> 預設
                  </div>
                  <div class="col-md-2"><input class="form-control" type="number" placeholder="排序" value="${o.displayOrder??''}" oninput="parts[${pi}].options[${oi}].displayOrder=parseInt(this.value)||null" /></div>
                  <div class="col-md-1 text-end">
                    <button type="button" class="btn btn-sm btn-outline-danger" onclick="removeOption(${pi},${oi})">刪選項</button>
                  </div>
                </div>
                <div class="mt-2">
                  <button type="button" class="btn btn-sm btn-outline-secondary" onclick="addTexture(${pi},${oi})">＋貼圖</button>
                  ${ (o.textures||[]).map((t,ti)=>`
                    <div class="row g-2 align-items-end mt-1">
                      <div class="col-md-3"><input class="form-control" placeholder="類型" value="${t.textureType||''}" oninput="parts[${pi}].options[${oi}].textures[${ti}].textureType=this.value" /></div>
                      <div class="col-md-6"><input class="form-control" placeholder="檔案路徑" value="${t.filePath||''}" oninput="parts[${pi}].options[${oi}].textures[${ti}].filePath=this.value" /></div>
                      <div class="col-md-2"><input class="form-control" placeholder="Tiling" value="${t.tiling||''}" oninput="parts[${pi}].options[${oi}].textures[${ti}].tiling=this.value" /></div>
                      <div class="col-md-1 text-end"><button type="button" class="btn btn-sm btn-outline-danger" onclick="removeTexture(${pi},${oi},${ti})">刪</button></div>
                    </div>`).join('') }
                </div>
              </div>`).join('') }
          </div>
        </div>`).join('');
      document.getElementById('PartsJson').value = JSON.stringify(parts);
    }
</script>
