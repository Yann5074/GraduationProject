@model GraduationProject.ViewModels.CProductEditViewModel

<div class="card my-3">
    <div class="card-header d-flex justify-content-between align-items-center">
        <strong>規格／變體</strong>
        <button type="button" id="btnAddVariant" class="btn btn-sm btn-outline-primary">＋新增變體</button>
    </div>

    <div class="card-body" id="variant-rows"></div>

    <!-- 後端接收的隱藏欄位 -->
    <input type="hidden" name="VariantsJson" id="VariantsJson" />
</div>

@section Scripts {
    <script>
        console.log('[EDIT/Variants:init]', typeof variants, Array.isArray(variants), variants?.length);
        // 1) 從後端注入 JSON 字面量（不要再 JSON.parse）
        const variants = @Html.Raw(Model.VariantsJson ?? "[]");
        window.variants = variants;
        // 2) 綁定事件（避免 inline onclick）
        document.getElementById('btnAddVariant')
          .addEventListener('click', () => { variants.push({ productVariantId:null, deleted:false }); renderVariants(); });

        // 3) 渲染 + 回寫 Hidden
        function renderVariants(){
          const box = document.getElementById('variant-rows');
          box.innerHTML = variants.map((v,i)=>`
            <div class="row g-2 align-items-end border-bottom pb-2 mb-2">
              <div class="col-md-4"><input class="form-control" value="${v.SKU||''}" oninput="variants[${i}].sku=this.value"/></div>
              <div class="col-md-2"><input class="form-control" type="number" value="${v.Stock??''}" oninput="variants[${i}].stock=parseInt(this.value)||null"/></div>
              <div class="col-md-2 form-check mt-1"><input class="form-check-input" type="button" ${v.Deleted?'checked':''} onchange="variants[${i}].deleted=this.checked"> 刪除</div>
            </div>`).join('');
          document.getElementById('VariantsJson').value = JSON.stringify(variants);
        }

        // 4) 首次渲染
        renderVariants();
    </script>
}
