@model GraduationProject.ViewModels.CMemberSearchViewModel

@{
    ViewData["Title"] = "FindMember";
}

<h1>會員查詢</h1>

<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="FindMember">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="MemberPhone" class="control-label"></label>
                <input asp-for="MemberPhone" class="form-control" />
                <span asp-validation-for="MemberPhone" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="查詢" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="List">返回訂單總覽</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
