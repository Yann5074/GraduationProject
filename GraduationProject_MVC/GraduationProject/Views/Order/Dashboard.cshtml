@model GraduationProject.ViewModels.COrderDashboardViewModel
@using System.Text.Json

@{
    ViewData["Title"] = "Dashboard";
    // 轉成 JSON 給前端
    var monthlyLabels = JsonSerializer.Serialize(Model?.MonthlyLabels ?? new List<string>());
    var monthlySales = JsonSerializer.Serialize(Model?.MonthlySales ?? new List<decimal>());
    var statusLabels = JsonSerializer.Serialize(Model?.StatusLabels ?? new List<string>());
    var statusCounts = JsonSerializer.Serialize(Model?.StatusCounts ?? new List<int>());
    var paymentLabels = JsonSerializer.Serialize(Model?.PaymentLabels ?? new List<string>());
    var paymentCounts = JsonSerializer.Serialize(Model?.PaymentCounts ?? new List<int>());
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1"></script>

<div class="container-xxl py-4">
    <div class="d-flex align-items-center justify-content-between mb-3">
        <h2 class="h4 mb-0">訂單圖表</h2>
    </div>

    <div class="row g-4">
        <!-- 每月營收 -->
        <div class="col-lg-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">每月營收</h5>
                    <canvas id="chartMonthly"></canvas>
                </div>
            </div>
        </div>

        <!-- 訂單狀態分佈 -->
        <div class="col-lg-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">訂單狀態分佈</h5>
                    <canvas id="chartStatus"></canvas>
                </div>
            </div>
        </div>

        <!-- 付款方式分佈 -->
        <div class="col-lg-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">付款方式分佈</h5>
                    <canvas id="chartPayment"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    // 從後端取得陣列
    const monthlyLabels  = @Html.Raw(monthlyLabels);
    const monthlySales   = @Html.Raw(monthlySales);
    const statusLabels   = @Html.Raw(statusLabels);
    const statusCounts   = @Html.Raw(statusCounts);
    const paymentLabels  = @Html.Raw(paymentLabels);
    const paymentCounts  = @Html.Raw(paymentCounts);

    // 1) 每月營收（折線）
    new Chart(document.getElementById('chartMonthly'), {
        type: 'line',
        data: {
            labels: monthlyLabels,
            datasets: [{
                label: '月營收',
                data: monthlySales,
                fill: false,
                tension: 0.25
            }]
        },
        options: {
            plugins: { legend: { display: true } },
            scales: {
                y: {
                    ticks: {
                        callback: (val) => 'NT$ ' + Number(val).toLocaleString()
                    }
                }
            }
        }
    });

    // 2) 訂單狀態分佈
    new Chart(document.getElementById('chartStatus'), {
        type: 'doughnut',
        data: {
            labels: statusLabels,
            datasets: [{
                label: '筆數',
                data: statusCounts
            }]
        },
        options: {
            plugins: { legend: { position: 'bottom' } }
        }
    });

    // 3) 付款方式分佈（長條）
    new Chart(document.getElementById('chartPayment'), {
        type: 'bar',
        data: {
            labels: paymentLabels,
            datasets: [{
                label: '筆數',
                data: paymentCounts
            }]
        },
        options: {
            plugins: { legend: { display: false } },
            scales: {
                y: { ticks: { stepSize: 1, precision: 0 } }
            }
        }
    });
</script>

