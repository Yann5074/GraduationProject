    @model GraduationProject.ViewModels.CChatRoomsPageVm
    @{
        ViewData["Title"] = "Chat Rooms";
        var selectedId = Model?.SelectedId;
    }

    <style>
        /* ===== 左側：列表（沿用原本淺色） ===== */
        .page {
            display: grid;
            grid-template-columns: 360px 1fr;
            gap: 16px;
        }

        .sidebar {
            border: 1px solid #e5e7eb;
            border-radius: 8px;
            overflow: auto;
            max-height: calc(100vh - 180px);
        }

        .room {
            display: grid;
            grid-template-columns: 44px 1fr;
            gap: 10px;
            padding: 10px 12px;
            text-decoration: none;
            color: inherit;
        }

            .room:hover {
                background: #f8fafc;
            }

            .room.active {
                background: #eef2ff;
            }

            .room img {
                width: 44px;
                height: 44px;
                border-radius: 50%;
                object-fit: cover;
            }

            .room .name {
                font-weight: 600;
            }

            .room .last {
                font-size: 12px;
                opacity: .7;
                white-space: nowrap;
                overflow: hidden;
                text-overflow: ellipsis;
            }

        /* ===== 右側：聊天面板（深色＋底部輸入框） ===== */
        .chat {
            display: flex;
            flex-direction: column;
            border: 1px solid #222;
            border-radius: 12px;
            background: #111;
            color: #e5e7eb;
            min-height: 520px;
            height: calc(100vh - 180px);
        }

        /* 標題列 */
        .header {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 14px 16px;
            border-bottom: 1px solid #1f2937;
        }

            .header .title {
                font-weight: 700;
            }

        /* 訊息滾動區（佔滿剩餘空間） */
        .messages {
            flex: 1;
            overflow: auto;
            padding: 16px 16px 8px 16px;
        }

        /* 氣泡樣式 */
        .msg-row {
            display: flex;
            margin-bottom: 12px;
        }

            .msg-row.from-employee {
                justify-content: flex-end;
            }

            .msg-row.from-others {
                justify-content: flex-start;
            }

        .bubble {
            max-width: 72%;
            padding: 10px 14px;
            border-radius: 14px;
            background: #1f2937;
            color: #e5e7eb;
            box-shadow: 0 2px 6px rgba(0,0,0,.25);
        }

        .from-employee .bubble {
            background: #3b82f6;
            color: #fff;
        }

        .meta {
            font-size: 12px;
            opacity: .8;
            margin-top: 6px;
            display: flex;
            gap: 8px;
        }

        /* 底部輸入列（固定在聊天面板底部） */
        .composer {
            border-top: 1px solid #1f2937;
            padding: 10px;
            display: flex;
            gap: 10px;
            background: #0f172a;
            border-bottom-left-radius: 12px;
            border-bottom-right-radius: 12px;
        }

            .composer .tool {
                width: 36px;
                height: 36px;
                border-radius: 10px;
                border: 1px solid #334155;
                display: flex;
                align-items: center;
                justify-content: center;
                background: #0b1220;
            }

            .composer textarea {
                flex: 1;
                max-height: 160px;
                min-height: 40px;
                resize: none;
                padding: 10px 12px;
                border-radius: 12px;
                border: 1px solid #334155;
                background: #0b1220;
                color: #e5e7eb;
                outline: none;
            }

                .composer textarea::placeholder {
                    color: #94a3b8;
                }

            .composer button {
                min-width: 88px;
                padding: 10px 14px;
                border-radius: 12px;
                border: 0;
                background: #4f46e5;
                color: white;
                font-weight: 600;
            }

                .composer button:disabled,
                .composer textarea:disabled {
                    opacity: .5;
                    cursor: not-allowed;
                }
    </style>


    <div class="page">
        <!-- 左側：聊天室列表 -->
        <aside class="sidebar">
            @if (Model?.Rooms != null && Model.Rooms.Any())
            {
                foreach (var r in Model.Rooms)
                {
                    var isActive = selectedId.HasValue && selectedId.Value == r.FChatRoomId;
                    <a class="room @(isActive ? "active" : "")"
                       href="@Url.Action("Index", "ChatRoom", new { chatRoomId = r.FChatRoomId })">
                        <img src="@(string.IsNullOrEmpty(r.image) ? "https://placehold.co/44x44" : r.image)" alt="avatar" />
                        <div>
                            <div class="name">@r.FName</div>
                            <div class="last">
                                @r.FLastMessageTime?.ToString("MM/dd HH:mm") · @r.FLastMessage
                            </div>
                        </div>
                    </a>
                }
            }
            else
            {
                <div style="padding:12px;">尚無聊天室</div>
            }
        </aside>

        <section class="chat">
            <!-- 標題列 -->
            <div class="header">
                <div class="title">
                    @(Model?.SelectedId.HasValue == true ? $"ChatRoom #{Model.SelectedId}" : "請從左側選擇一個聊天室…")
                </div>
            </div>

            <!-- 訊息可滾動 -->
            <div id="messages" class="messages">
                @if (Model?.Messages != null && Model.Messages.Any())
                {
                    foreach (var m in Model.Messages)
                    {
                        var isEmployee = string.Equals(m.SenderType, "employee", System.StringComparison.OrdinalIgnoreCase);

                        <div class="msg-row @(isEmployee ? "from-employee" : "from-others")">
                            <div class="bubble" data-id="@m.MessageId">
                                <div class="content">@m.Content</div>
                                <div class="meta">
                                    <span class="sender">@m.SenderType</span>
                                    <span>@m.CreatedAt?.ToString("yyyy/MM/dd HH:mm")</span>
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div style="opacity:.7"><em>@(Model?.SelectedId != null ? "尚無訊息" : "未選擇聊天室")</em></div>
                }
            </div>

            <!-- 底部輸入列：固定在面板底部 -->


        <form class="composer" asp-action="SendMessage" asp-controller="ChatRoom" method="post">
                @* AntiForgeryToken欠改 *@
                @Html.AntiForgeryToken()
                <input type="hidden" name="chatRoomId" value="@Model?.SelectedId" />
                <input type="hidden" name="q" value="@Model?.Q" />

                <!-- 可放附件/表情的小工具（先佔位） -->
                <div class="tool" title="附件">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
                        <path d="M21 15v4a2 2 0 0 1-2 2H7a4 4 0 0 1-4-4V7a2 2 0 0 1 2-2h4"
                              stroke="#94a3b8" stroke-width="2" stroke-linecap="round" />
                    </svg>
                </div>

                <textarea id="msgInput" name="content"
                          placeholder="輸入訊息… Enter 送出，Shift+Enter 換行"
                          @(Model?.SelectedId == null ? "disabled" : "")></textarea>

                <button type="submit" id="sendBtn" @(Model?.SelectedId == null ? "disabled" : "")>
                    送出
                </button>
            </form>
        </section>


    @@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
          const box  = document.getElementById('messages');
          const form = document.querySelector('form.composer');
          const ta   = document.getElementById('msgInput');
          const btn  = document.getElementById('sendBtn');

          if (!form) {
            console.error('❌ 找不到 form.composer，請確認 Script 在 <body> 最後或使用 DOMContentLoaded 包住。');
            return;
          }

          console.log('✅ 已找到 form：', form);

          if (box) box.scrollTop = box.scrollHeight;
          if (!ta || !btn) return;

          const autoresize = () => { ta.style.height = 'auto'; ta.style.height = Math.min(ta.scrollHeight, 160) + 'px'; };
          ta.addEventListener('input', autoresize);
          autoresize();

          ta.addEventListener('keydown', function (e) {
            if (e.key === 'Enter' && !e.shiftKey) {
              e.preventDefault();
              if (ta.value.trim()) form.requestSubmit();
            }
          });

          form.addEventListener('submit', async (e) => {
            e.preventDefault();
            const text = ta.value.trim();
            if (!text) return;


            const fd = new FormData(form);

            try {
              const res = await fetch(form.action, { method: 'POST', body: fd });
              if (!res.ok) throw new Error('Network error');
              const data = await res.json();
              if (!data.ok) throw new Error('Server says not ok');

              const m = data.message;
              const isEmployee = (m.senderType || '').toLowerCase() === 'employee';
              const row = document.createElement('div');
              row.className = 'msg-row ' + (isEmployee ? 'from-employee' : 'from-others');
              row.innerHTML = `
                <div class="bubble">
                  <div class="content"></div>
                  <div class="meta"><span>${m.senderType}</span><span>${m.createdAt}</span></div>
                </div>`;
              row.querySelector('.content').textContent = m.content;

              box.appendChild(row);
              box.scrollTop = box.scrollHeight;
              ta.value = '';
              autoresize();
            } catch (err) {
              alert('送出失敗：' + err.message);
            } finally {
              btn.disabled = false; ta.disabled = false; ta.focus();
            }
          });
        });
    </script>
    }
