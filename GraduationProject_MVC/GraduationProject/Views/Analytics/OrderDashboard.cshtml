@model GraduationProject.ViewModels.COrderDashboardViewModel
@using System.Text.Json

@{
    ViewData["Title"] = "OrderDashboard";
    // 轉成 JSON 給前端
    var monthlyLabels = JsonSerializer.Serialize(Model?.MonthlyLabels ?? new List<string>());
    var monthlySales = JsonSerializer.Serialize(Model?.MonthlySales ?? new List<decimal>());
    var statusLabels = JsonSerializer.Serialize(Model?.StatusLabels ?? new List<string>());
    var statusCounts = JsonSerializer.Serialize(Model?.StatusCounts ?? new List<int>());
    var paymentLabels = JsonSerializer.Serialize(Model?.PaymentLabels ?? new List<string>());
    var paymentCounts = JsonSerializer.Serialize(Model?.PaymentCounts ?? new List<int>());
    var action = ViewContext.RouteData.Values["Action"]?.ToString();
}

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1"></script>

<div class="container-xxl py-4">
    <!-- 標題列 -->
    <div class="d-flex align-items-center justify-content-between mb-3">
        <h2 class="h4 mb-0">訂單圖表</h2>

        <ul class="nav nav-pills">
            <li class="nav-item">
                <a class="nav-link @(action == "OrderDashboard" ? "active" : "")"
                   asp-controller="Analytics" asp-action="OrderDashboard">
                    <i class="bx bx-line-chart me-1"></i> 訂單圖表
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(action == "MemberDashboard" ? "active" : "")"
                   asp-controller="Analytics" asp-action="MemberDashboard">
                    <i class="bx bx-user-plus me-1"></i> 會員圖表
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(action == "BestVariantsDashboard" ? "active" : "")"
                   asp-controller="Analytics" asp-action="BestVariantsDashboard">
                    <i class="bx bx-pie-chart-alt me-1"></i> 商品圖表
                </a>
            </li>
        </ul>
    </div>

    <!-- 圖表列 -->
    <div class="row g-4 row-cols-1 row-cols-lg-3">
        <!-- 每月營收 -->
        <div class="col">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h5 class="card-title mb-3">每月營收</h5>
                    <canvas id="chartMonthly" class="chart-canvas"></canvas>
                </div>
            </div>
        </div>

        <!-- 訂單狀態分佈 -->
        <div class="col">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h5 class="card-title mb-3">訂單狀態分佈</h5>
                    <canvas id="chartStatus" class="chart-canvas"></canvas>
                </div>
            </div>
        </div>

        <!-- 付款方式分佈 -->
        <div class="col">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h5 class="card-title mb-3">付款方式分佈</h5>
                    <canvas id="chartPayment" class="chart-canvas"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- 摘要列 -->
    <div class="row g-4 mt-1">

        <!-- 成交卡片 -->
        <div class="col-12 col-lg-6">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">成交月份摘要</h5>

                    <h6 class="mt-3">成交量（完成）最高</h6>
                    <ul class="mb-2">
                        @foreach (var it in Model.MaxCompletedMonths)
                        {
                            <li>@it.Label：@it.Count 筆</li>
                        }
                    </ul>

                    <h6 class="mt-3">成交量（完成）最低</h6>
                    <ul class="mb-0">
                        @foreach (var it in Model.MinCompletedMonths)
                        {
                            <li>@it.Label：@it.Count 筆</li>
                        }
                    </ul>
                </div>
            </div>
        </div>

        <!-- 棄單卡片 -->
        <div class="col-12 col-lg-6">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">棄單月份摘要</h5>

                    <h6 class="mt-3">棄單（取消/刪除）最高</h6>
                    <ul class="mb-2">
                        @foreach (var it in Model.MaxCanceledMonths)
                        {
                            <li>@it.Label：@it.Count 筆</li>
                        }
                    </ul>

                    <h6 class="mt-3">棄單（取消/刪除）最低</h6>
                    <ul class="mb-0">
                        @foreach (var it in Model.MinCanceledMonths)
                        {
                            <li>@it.Label：@it.Count 筆</li>
                        }
                    </ul>
                </div>
            </div>
        </div>

    </div>
</div>


<script>
    // 從後端取得陣列
    const monthlyLabels  = @Html.Raw(monthlyLabels);
    const monthlySales   = @Html.Raw(monthlySales);
    const statusLabels   = @Html.Raw(statusLabels);
    const statusCounts   = @Html.Raw(statusCounts);
    const paymentLabels  = @Html.Raw(paymentLabels);
    const paymentCounts  = @Html.Raw(paymentCounts);

    // 1) 每月營收（折線）
    new Chart(document.getElementById('chartMonthly'), {
        type: 'line',
        data: {
            labels: monthlyLabels,
            datasets: [{
                label: '月營收',
                data: monthlySales,
                fill: false,
                tension: 0.25
            }]
        },
        options: {
            plugins: { legend: { display: true } },
            scales: {
                y: {
                    ticks: {
                        callback: (val) => 'NT$ ' + Number(val).toLocaleString()
                    }
                }
            }
        }
    });

    // 2) 訂單狀態分佈
    new Chart(document.getElementById('chartStatus'), {
        type: 'doughnut',
        data: {
            labels: statusLabels,
            datasets: [{
                label: '筆數',
                data: statusCounts
            }]
        },
        options: {
            plugins: { legend: { position: 'bottom' } }
        }
    });

    // 3) 付款方式分佈（長條）
    new Chart(document.getElementById('chartPayment'), {
        type: 'bar',
        data: {
            labels: paymentLabels,
            datasets: [{
                label: '筆數',
                data: paymentCounts
            }]
        },
        options: {
            plugins: { legend: { display: false } },
            scales: {
                y: { ticks: { stepSize: 1, precision: 0 } }
            }
        }
    });
</script>

