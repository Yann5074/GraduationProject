@model IEnumerable<GraduationProject.ViewModels.CBestSellerItemViewModel>
<div class="container-xxl py-4">
    <div class="d-flex align-items-center justify-content-between mb-3">
        <h2 class="h4 mb-0">熱銷排行（Top N）</h2>
        <div class="text-muted small">依銷售數量排序</div>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">目前沒有熱銷資料。</div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-striped table-hover align-middle mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th style="width:72px;">名次</th>
                                <th>商品名稱</th>
                                <th style="width:130px;">VariantId</th>
                                <th style="width:160px;">SKU</th>
                                <th style="width:120px;" class="text-end">總銷量</th>
                                <th style="width:160px;" class="text-end">總營收</th>
                                <th style="width:140px;" class="text-center">操作</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                var rank = 0;
                                foreach (var x in Model.OrderByDescending(m => m.TotalQty))
                                {
                                    rank++;
                                    <tr>
                                        <td class="text-center text-muted">@rank</td>
                                        <td>@x.ProductName</td>
                                        <td>@x.VariantId</td>
                                        <td>@x.SKU</td>
                                        <td class="text-end fw-semibold">@x.TotalQty</td>
                                        <td class="text-end fw-semibold">NT$ @x.TotalRevenue.ToString("#,0.##")</td>
                                        <td class="text-center text-nowrap">
                                            <!-- 依你的路由調整：例如查看品項、到產品頁等 -->
                                            <a asp-controller="Products" asp-action="Detail" asp-route-id="@x.ProductId"
                                               class="btn btn-sm btn-outline-primary">
                                                詳細
                                            </a>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>