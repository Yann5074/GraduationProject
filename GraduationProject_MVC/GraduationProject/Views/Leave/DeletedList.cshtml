@using GraduationProject.DTOs
@using GraduationProject.Dictionary
@using GraduationProject.Enum
@using GraduationProject.ViewModels
@model IEnumerable<CLeaveListItemViewModel>
@{
    // 狀態Enum
    var deleted = (int)LeaveRequestStatusEnum.Deleted;
}
<h3>取消申請清單</h3>
<div class="d-flex align-items-center mb-3">
    <!-- 右側按鈕群組 -->
    <div class="ms-auto d-flex gap-2">
        <a asp-action="List" class="btn btn-light">
            返回清單
        </a>
    </div>
</div>
<table class="table table-striped">
    <thead>
        <tr>
            <th>#</th>
            <th>假別</th>
            <th>起</th>
            <th>迄</th>
            <th>狀態</th>
            <th>證明</th>
            <th>說明</th>
            <th>操作</th>
        </tr>
    </thead>
    <tbody>
        @{
            var count = 0;
            foreach (var x in Model)
            {
                count++;
                <tr>
                    <td>@count</td>
                    <td>@x.LeaveType</td>
                    <td>@x.StartDate</td>
                    <td>@x.EndDate</td>
                    <td>@x.Status</td>
                    <td>
                        @if (string.IsNullOrEmpty(x.PictureUrl))
                        {
                            <p>無</p>
                        }
                        @if (!string.IsNullOrEmpty(x.PictureUrl))
                        {
                            <a href="@x.PictureUrl" target="_blank">檢視</a>
                        }
                    </td>
                    <td>@x.Description</td>
                    <td>
                        @if (x.StatusId == deleted)
                        {
                            <form method="post" asp-action="HardDelete" asp-route-id="@x.LeaveId">
                                <button type="submit" class="btn btn-danger" onclick="return confirm('確定要刪除嗎？')">刪除</button>
                            </form>
                        }
                        else
                        {
                            <button disabled type="submit" class="btn btn-danger" )">例外</button>
                        }
                    </td>
                </tr>
            }
        }
    </tbody>
</table>