@using GraduationProject.DTOs
@using GraduationProject.Dictionary
@model PagedList<GraduationProject.DTOs.CLeaveItemDTO>

<h3>待審請假申請</h3>
<!-- 功能按鈕群組 -->
<div class="d-flex justify-content-between mb-3 gap-2">
    <p class="mb-0">總請假申請數量：@ViewBag.TotalRequests</p>
    <a asp-action="List" class="btn btn-light">
        返回清單
    </a>
</div>

<!-- 篩選清單 -->
<form method="get" class="row align-items-end mb-4">
    <div class="col-md-3 col-sm-6">
        <label class="form-label">關鍵字</label>
        <input type="text" name="Keyword" value="@ViewBag.Keyword" class="form-control" placeholder="輸入關鍵字">
    </div>

    <div class="col-md-3 col-sm-6">
        <label class="form-label">開始日期</label>
        <input type="date" name="Start" value="@ViewBag.Start" class="form-control">
    </div>

    <div class="col-md-3 col-sm-6">
        <label class="form-label">結束日期</label>
        <input type="date" name="End" value="@ViewBag.End" class="form-control">
    </div>

    <div class="col-md-3 col-sm-6 d-flex justify-content-end gap-2">
        <button type="submit" class="btn btn-primary flex-grow-1">
            <i class="fa-solid fa-search"></i> 搜尋
        </button>
        <a href="@Url.Action("Pending")" class="btn btn-outline-secondary flex-grow-1">
            <i class="fa-solid fa-rotate-left"></i> 清除
        </a>
    </div>
</form>

<table class="table">
    <thead>
        <tr>
            <th>員工</th>
            <th>假別</th>
            <th>起</th>
            <th>迄</th>
            <th>說明</th>
            <th>證明</th>
            <th>操作</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var x in Model.Items)
        {
            <tr>
                <td>@x.EmployeeName</td>
                <td>@x.LeaveType</td>
                <td>@x.StartDate</td>
                <td>@x.EndDate</td>
                <td>@x.Description</td>
                <td>
                    @if (string.IsNullOrEmpty(x.PictureFileName))
                    {
                        <span>無</span>
                    }
                    else
                    {
                        var url = Url.Content($"~/LeaveEvidence/{x.PictureFileName}");
                        var ext = System.IO.Path.GetExtension(x.PictureFileName)?.ToLowerInvariant();
                        <a href="@url" target="_blank" rel="noopener">預覽</a>
                    }
                </td>
                <td class="text-nowrap">
                    <form asp-action="Approve" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@x.LeaveId" />
                        <button class="btn btn-sm btn-success">核准</button>
                    </form>
                    <form asp-action="Reject" method="post" class="d-inline ms-1">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@x.LeaveId" />
                        <button class="btn btn-sm btn-danger">駁回</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
<!-- 分頁按鈕 -->
<nav class="d-flex justify-content-between align-items-center">
    <div>共 @Model.TotalCount 筆，第 @Model.Page / @(Model.TotalPages <= 0 ? 1 : Model.TotalPages) 頁</div>
    <ul class="pagination mb-0">
        <li class="page-item @(Model.HasPrev ? "" : "disabled")">
            <a class="page-link"
               asp-action="List"
               asp-route-Keyword="@(ViewBag.Keyword)"
               asp-route-Page="@(Model.Page - 1)"
               asp-route-Size="@(Model.PageSize)">上一頁</a>
        </li>

        <li class="page-item @(Model.HasNext ? "" : "disabled")">
            <a class="page-link"
               asp-action="List"
               asp-route-Keyword="@(ViewBag.Keyword)"
               asp-route-Page="@(Model.Page + 1)"
               asp-route-Size="@(Model.PageSize)">下一頁</a>
        </li>
    </ul>
</nav>
