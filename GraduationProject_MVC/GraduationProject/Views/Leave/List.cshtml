@using GraduationProject.DTOs
@using GraduationProject.Dictionary
@using GraduationProject.Enum
@model PagedList<GraduationProject.DTOs.CLeaveItemDTO>
@using System.Text.Json
@{
    //權限設定
    var json = Context.Session.GetString(CEmployeeDictionary.SK_LOGINED_USER);
    var me = json is null ? null : JsonSerializer.Deserialize<SessionUser>(json);
    var isAdmin = me?.RoleId == 4 && me?.StatusId == 1;

    //狀態Enum
    var pending = (int)LeaveRequestStatusEnum.Pending;
    var approved = (int)LeaveRequestStatusEnum.Approved;
    var rejected = (int)LeaveRequestStatusEnum.Rejected;
}

<h3>我的請假申請</h3>

<!-- 功能按鈕群組 -->
<div class="d-flex justify-content-end mb-3 gap-2">
    <a asp-action="Create" class="btn btn-success">
        <i class="fa-solid fa-plus"></i> 新增假單
    </a>

    <a asp-action="DeletedList" class="btn btn-secondary">
        <i class="fa-solid fa-xmark"></i> 取消清單
    </a>

    @if (isAdmin)
    {
        <a asp-action="Pending" class="btn btn-dark">
            <i class="bi bi-check-circle"></i> 審核假單
        </a>
    }
</div>

<!-- 篩選清單 -->
<form method="get" class="row align-items-end mb-4">
    <div class="col-md-3 col-sm-6">
        <label class="form-label">關鍵字</label>
        <input type="text" name="Keyword" value="@ViewBag.Keyword" class="form-control" placeholder="輸入關鍵字">
    </div>

    <div class="col-md-3 col-sm-6">
        <label class="form-label">開始日期</label>
        <input type="date" name="Start" value="@ViewBag.Start" class="form-control">
    </div>

    <div class="col-md-3 col-sm-6">
        <label class="form-label">結束日期</label>
        <input type="date" name="End" value="@ViewBag.End" class="form-control">
    </div>

    <div class="col-md-3 col-sm-6 d-flex justify-content-end gap-2">
        <button type="submit" class="btn btn-primary flex-grow-1">
            <i class="fa-solid fa-search"></i> 搜尋
        </button>
        <a href="@Url.Action("List")" class="btn btn-outline-secondary flex-grow-1">
            <i class="fa-solid fa-rotate-left"></i> 清除
        </a>
    </div>
</form>

<table class="table table-striped">
    <thead>
        <tr>
            <th>#</th>
            <th>假別</th>
            <th>起</th>
            <th>迄</th>
            <th>狀態</th>
            <th>證明</th>
            <th>說明</th>
            <th>操作</th>
        </tr>
    </thead>
    <tbody>
        @{
            var count = 0;
            foreach (var x in Model.Items)
            {
                count++;
                <tr>
                    <td>@count</td>
                    <td>@x.LeaveType</td>
                    <td>@x.StartDate</td>
                    <td>@x.EndDate</td>
                    <td>@x.StatusName</td>
                    <td>
                        @if (string.IsNullOrEmpty(x.PictureFileName))
                        {
                            <span>無</span>
                        }
                        else
                        {
                            var url = Url.Content($"~/LeaveEvidence/{x.PictureFileName}");
                            var ext = System.IO.Path.GetExtension(x.PictureFileName)?.ToLowerInvariant();
                            <a href="@url" target="_blank" rel="noopener">預覽</a>
                        }
                    </td>
                    <td>@x.Description</td>
                    <td>
                        @if (x.StatusId == pending)
                        {
                            <form method="post" asp-action="SoftDelete" asp-route-leaveId="@x.LeaveId" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('確定要取消申請嗎？')">取消申請</button>
                            </form>
                        }
                        else if (x.StatusId == approved)
                        {
                            <button disabled class="btn btn-sm btn-secondary">已通過</button>
                        }
                        else if (x.StatusId == rejected)
                        {
                            <button disabled class="btn btn-sm btn-secondary">駁回</button>
                        }
                        else
                        {
                            <button disabled class="btn btn-sm btn-secondary">未知狀態</button>
                        }
                    </td>
                </tr>
            }
        }
    </tbody>
</table>
<!-- 分頁按鈕 -->
<nav class="d-flex justify-content-between align-items-center">
    <div>共 @Model.TotalCount 筆，第 @Model.Page / @(Model.TotalPages <= 0 ? 1 : Model.TotalPages) 頁</div>
    <ul class="pagination mb-0">
        <li class="page-item @(Model.HasPrev ? "" : "disabled")">
            <a class="page-link"
               asp-action="List"
               asp-route-Keyword="@(ViewBag.Keyword)"
               asp-route-Page="@(Model.Page - 1)"
               asp-route-Size="@(Model.PageSize)">上一頁</a>
        </li>

        <li class="page-item @(Model.HasNext ? "" : "disabled")">
            <a class="page-link"
               asp-action="List"
               asp-route-Keyword="@(ViewBag.Keyword)"
               asp-route-Page="@(Model.Page + 1)"
               asp-route-Size="@(Model.PageSize)">下一頁</a>
        </li>
    </ul>
</nav>
