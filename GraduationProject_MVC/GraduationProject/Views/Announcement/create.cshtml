@model GraduationProject.ViewModels.CAnnouncementViewModel
@{
    ViewData["Title"] = "新增公告";
}

<div class="container-xxl py-4">
    <h2 class="mb-4">
        <i class="bx bx-bullhorn me-1"></i> 新增公告
    </h2>

    @* 顯示驗證摘要 *@
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()

        <div class="card shadow-sm">
            <div class="card-body">
                <div class="mb-3">
                    <label asp-for="Title" class="form-label fw-bold"></label>
                    <input asp-for="Title" class="form-control" placeholder="請輸入公告標題" />
                    <span asp-validation-for="Title" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Message" class="form-label fw-bold"></label>
                    <textarea asp-for="Message" class="form-control" rows="4" placeholder="請輸入公告內容"></textarea>
                    <span asp-validation-for="Message" class="text-danger"></span>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label asp-for="StartAtLocal" class="form-label fw-bold"></label>
                        <input asp-for="StartAtLocal" type="datetime-local" class="form-control" />
                        <span asp-validation-for="StartAtLocal" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="EndAtLocal" class="form-label fw-bold"></label>
                        <input asp-for="EndAtLocal" type="datetime-local" class="form-control" />
                        <span asp-validation-for="EndAtLocal" class="text-danger"></span>
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label asp-for="Priority" class="form-label fw-bold"></label>
                        <input asp-for="Priority" type="number" min="0" class="form-control" />
                        <div class="form-text">數字越大，優先顯示越前面</div>
                        <span asp-validation-for="Priority" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 d-flex align-items-center">
                        <div class="form-check mt-4">
                            <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                            <label asp-for="IsActive" class="form-check-label"></label>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card-footer d-flex justify-content-between">
                <a asp-action="List" class="btn btn-secondary">
                    <i class="bx bx-arrow-back me-1"></i> 返回列表
                </a>
                <button type="submit" class="btn btn-success">
                    <i class="bx bx-save me-1"></i> 儲存公告
                </button>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
