@model GraduationProject.ViewModels.CMemberUpdateViewModel


@{
    ViewData["Title"] = "Edit";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6">

            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">修改會員作業</h5>
                </div>

                <div class="card-body">
                    @* <h6 class="card-subtitle mb-3 text-muted">請修改會員資訊</h6>
                    <hr /> *@

                    <form asp-action="Edit" method="post" enctype="multipart/form-data">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <!-- 隱藏鍵值 -->
                        <input type="hidden" asp-for="MemberId" />
                        <input type="hidden" asp-for="CreatTime" />

                        <!-- 姓名 -->
                        <div class="mb-3">
                            <label asp-for="Name" class="form-label fw-semibold">姓名</label>
                            <input asp-for="Name" class="form-control" />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>

                        <!-- 暱稱 -->
                        <div class="mb-3">
                            <label asp-for="DisplayName" class="form-label fw-semibold">暱稱</label>
                            <input asp-for="DisplayName" class="form-control" />
                            <span asp-validation-for="DisplayName" class="text-danger"></span>
                        </div>

                        <!-- 性別 -->
                        <div class="mb-3">
                            <label asp-for="Gender" class="form-label d-block fw-semibold">性別</label>
                            <div class="d-flex flex-wrap gap-4">
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" asp-for="Gender" value="1" id="gender-male" />
                                    <label class="form-check-label" for="gender-male">男性</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" asp-for="Gender" value="2" id="gender-female" />
                                    <label class="form-check-label" for="gender-female">女性</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" asp-for="Gender" value="3" id="gender-neutral" />
                                    <label class="form-check-label" for="gender-neutral">中性</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" asp-for="Gender" value="4" id="gender-na" />
                                    <label class="form-check-label" for="gender-na">不願告知</label>
                                </div>
                            </div>
                            <span asp-validation-for="Gender" class="text-danger"></span>
                        </div>

                        <!-- 手機 -->
                        <div class="mb-3">
                            <label asp-for="Phone" class="form-label fw-semibold">手機</label>
                            <input asp-for="Phone" class="form-control" />
                            <span asp-validation-for="Phone" class="text-danger"></span>
                        </div>

                        <!-- 地址 -->
                        <div class="mb-3">
                            <label asp-for="Address" class="form-label fw-semibold">地址</label>
                            <input asp-for="Address" class="form-control" />
                            <span asp-validation-for="Address" class="text-danger"></span>
                        </div>

                        <!-- 會員頭貼 -->
                        <div class="mb-3"> 
                            <label class="form-label fw-semibold">會員頭貼</label>
                            <!-- 關鍵：把舊檔名也隱藏帶回去 -->
                            <input type="hidden" asp-for="MemberImage" />     
                            <img id="headshotPreview"
                                 src="@Url.Content($"~/MemberHeadImages/{Model.MemberImage ?? "default.png"}")"
                                 class="rounded-circle border"
                                 style="width:100px;height:100px;object-fit:cover"
                                 alt="頭像預覽"
                                 onerror="this.onerror=null;this.src='@Url.Content("~/MemberHeadImages/default.png")';" />
                            <input asp-for="Photo" type="file" class="form-control" accept="image/*" />
                            <small class="text-muted">支援 jpg/png/webp，照片檔案必須小於 2MB。</small>
                        </div>

                        <!-- 等級 -->
                        <div class="mb-3">
                            <label asp-for="LeveId" class="form-label d-block fw-semibold">等級</label>
                            <div class="d-flex flex-wrap gap-4">
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" asp-for="LeveId" value="1" id="lv-1" />
                                    <label class="form-check-label" for="lv-1">銅級</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" asp-for="LeveId" value="2" id="lv-2" />
                                    <label class="form-check-label" for="lv-2">銀級</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" asp-for="LeveId" value="3" id="lv-3" />
                                    <label class="form-check-label" for="lv-3">金級</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" asp-for="LeveId" value="4" id="lv-4" />
                                    <label class="form-check-label" for="lv-4">白金級</label>
                                </div>
                            </div>
                            <span asp-validation-for="LeveId" class="text-danger"></span>
                        </div>

                        <!-- 總消費金額 -->
                        <div class="mb-3">
                            <label asp-for="MoneySum" class="form-label fw-semibold">總消費金額</label>
                            <div class="input-group">
                                <input asp-for="MoneySum" class="form-control" id="moneySumInput" />
                                <span class="input-group-text">元</span>
                            </div>
                            <span asp-validation-for="MoneySum" class="text-danger"></span>
                        </div>

                        <!-- 狀態 -->
                        <div class="mb-2">
                            <label asp-for="Status" class="form-label d-block fw-semibold">狀態</label>
                            <div class="d-flex flex-wrap gap-4">
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" asp-for="Status" value="1" id="status-1" />
                                    <label class="form-check-label" for="status-1">正常</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" asp-for="Status" value="2" id="status-2" />
                                    <label class="form-check-label" for="status-2">凍結</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" asp-for="Status" value="3" id="status-3" />
                                    <label class="form-check-label" for="status-3">刪除</label>
                                </div>
                            </div>
                            <span asp-validation-for="Status" class="text-danger"></span>
                        </div>

                        <!-- 按鈕 -->
                        <div class="d-flex justify-content-between mt-4">
                            <input type="submit" value="送出並儲存" class="btn btn-primary me-2" />
                            <a asp-action="List" class="btn btn-outline-secondary">取消</a>
                        </div>
                    </form>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>

           // ====== 既有：頭像預覽 ======
           (function () {
            const fileInput = document.getElementById('Photo');
            const img = document.getElementById('headshotPreview');
            const originalSrc = img.getAttribute('src');

            fileInput?.addEventListener('change', () => {
                const f = fileInput.files && fileInput.files[0];
                if (!f) { img.src = originalSrc; return; }

                // 基本前端檢查
                if (!f.type.startsWith('image/')) {
                    alert('請選擇圖片檔案');
                    fileInput.value = '';
                    img.src = originalSrc;
                    return;
                    }
                const maxBytes = 2 * 1024 * 1024; // 2MB
                if (f.size > maxBytes) {
                    alert('檔案過大，請小於 2MB');
                    fileInput.value = '';
                    img.src = originalSrc;
                    return;
                    }

                // 即時預覽
                const url = URL.createObjectURL(f);
                img.src = url;
                img.onload = () => URL.revokeObjectURL(url);
            });
        })();

        // ====== 新增：依等級自動帶入 MoneySum 起始值 ======
        // 等級 ↔ 金額門檻（建議值/判斷用）
          const levelStart = { 1: 0, 2: 10000, 3: 100000, 4: 250000 };

          const moneyInput  = document.getElementById('moneySumInput');
          const levelRadios = document.querySelectorAll("input[name='LeveId']");

          // 避免「程式設值」觸發「事件又回頭」的無限循環
          let suppress = false;

          // 使用者是否手動改過金額（避免等級改變時強制覆蓋）
          let userEditedMoney = false;

          // 依等級帶入建議金額（但尊重使用者已手動輸入）
          function applyStartMoneyByLevel(leveId, force = false) {
            if (!levelStart.hasOwnProperty(leveId)) return;
            const start = levelStart[leveId];

            if (!userEditedMoney || force) {
              suppress = true;
              moneyInput.value = start;
              suppress = false;
              userEditedMoney = false;
              return;
            }

            // 使用者曾輸入過，詢問是否覆蓋
            const ok = confirm('要依等級帶入建議起始金額嗎？目前輸入會被覆蓋。');
            if (ok) {
              suppress = true;
              moneyInput.value = start;
              suppress = false;
              userEditedMoney = false;
            }
          }

          // 依金額反推等級
          function getLevelByMoney(money) {
            if (money >= levelStart[4]) return 4;       // ≥ 250000 → 白金
            if (money >= levelStart[3]) return 3;       // ≥ 100000 → 金
            if (money >= levelStart[2]) return 2;       // ≥ 10000  → 銀
            return 1;                                    // 其他      → 銅
          }

          // 將 radio 設為指定等級
          function checkLevelRadio(level) {
            levelRadios.forEach(r => {
              if (parseInt(r.value, 10) === level) {
                r.checked = true;
              }
            });
          }

          // === 事件 1：等級變更 → 帶入建議金額 ===
          levelRadios.forEach(r => {
            r.addEventListener('change', () => {
              if (!r.checked) return;
              const leveId = parseInt(r.value, 10);
              applyStartMoneyByLevel(leveId);
            });
          });

          // === 事件 2：金額輸入 → 反推並切換等級 ===
          moneyInput.addEventListener('input', () => {
            if (suppress) return;                 // 程式設值時不處理
            userEditedMoney = true;

            const raw = moneyInput.value.replace(/[, ]/g, '');
            const money = parseInt(raw || '0', 10);
            if (Number.isNaN(money)) return;

            const level = getLevelByMoney(money);
            suppress = true;
            checkLevelRadio(level);
            suppress = false;
          });

          // === 初始化：如果有已選等級且金額為空/0，就先帶一次建議值 ===
          (function init() {
            const checked = document.querySelector("input[name='LeveId']:checked");
            const current = parseInt((moneyInput.value || '0').replace(/[, ]/g, ''), 10);
            if (checked && (!current || current === 0)) {
              applyStartMoneyByLevel(parseInt(checked.value, 10), /*force*/ true);
            } else if (!checked) {
              // 若尚未選等級但金額有值，反推一次等級
              const lvl = getLevelByMoney(current || 0);
              checkLevelRadio(lvl);
            }
          })();

    </script>
}
