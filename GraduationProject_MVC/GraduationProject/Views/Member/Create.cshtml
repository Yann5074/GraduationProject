@model GraduationProject.ViewModels.CMemberCreateViewModel
@{
    ViewData["Title"] = "Create Member";
}
<h2>新增會員個資</h2>

<form asp-action="Create" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-2">
        <label asp-for="FName">姓名</label>
        <input asp-for="FName" class="form-control" />
        <span asp-validation-for="FName" class="text-danger"></span>
    </div>

    <div class="mb-2">
        <label asp-for="FDisplayName">暱稱</label>
        <input asp-for="FDisplayName" class="form-control" />
    </div>

    <div class="mb-2">
        <label asp-for="FGender" class="form-label d-block fw-semibold">性別</label>
        <div class="d-flex gap-3">
            <div class="form-check">
                <input class="form-check-input" type="radio" asp-for="FGender" value="1" id="male" />
                <label class="form-check-label" for="male">男性</label>
            </div>
            <div class="form-check">
                <input class="form-check-input" type="radio" asp-for="FGender" value="2" id="female" />
                <label class="form-check-label" for="female">女性</label>
            </div>
            <div class="form-check">
                <input class="form-check-input" type="radio" asp-for="FGender" value="3" id="neutral" />
                <label class="form-check-label" for="neutral">中性</label>
            </div>
            <div class="form-check">
                <input class="form-check-input" type="radio" asp-for="FGender" value="4" id="na" />
                <label class="form-check-label" for="na">不願告知</label>
            </div>
        </div>
        <span asp-validation-for="FGender" class="text-danger"></span>
    </div>

    <div class="mb-2">
        <label asp-for="FPhone">手機</label>
        <input asp-for="FPhone" class="form-control" />
        <span asp-validation-for="FPhone" class="text-danger"></span>
    </div>

    @* <div class="mb-2">
        <label asp-for="FBirthDate"></label>
        <input asp-for="FBirthDate" type="date" class="form-control" />
    </div> *@

    <div class="mb-2">
        <label asp-for="FAddress">地址</label>
        <input asp-for="FAddress" class="form-control" />
        <span asp-validation-for="FAddress" class="text-danger"></span>
    </div>

    <button class="btn btn-primary" type="submit">儲存</button>
    <a asp-action="List" class="btn btn-secondary">返回</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
